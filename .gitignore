node_modules/

# Local agent worktrees created by the harness under .claude/.
.claude/worktrees/

# Transient skills install lock/staging files. The committed installer avoids
# creating these, but ignore them defensively so they are never staged.
.skills-install.lock
.skills-install.lock.*.tmp

# Python bytecode caches from running the tests.
__pycache__/

# Agent scratch folders. check-install counts untracked files as uncommitted work.
.claude/scratch/
