#!/usr/bin/env python3
"""Run the worker profile's check-install from the profile that owns the chat platform.

Only the default profile runs Slack, so only its cron jobs can deliver to the
operator's home channel. Hermes runs a cron script from that profile's own
`scripts/` directory, so setup installs this wrapper there. It runs the
worker's current check-install, so the job never runs a stale copy, and passes
its output and exit status through for Hermes to deliver.
"""
import os
import subprocess
import sys
from pathlib import Path

WORKER = "claude-worker"

home = os.environ.get("HERMES_HOME")
if not home:
    sys.exit("check-install-alert: HERMES_HOME is not set")
worker = Path(home) / "profiles" / WORKER
script = worker / "scripts" / "check-install"
if not script.is_file():
    sys.exit(f"check-install-alert: {script} does not exist")
env = {**os.environ, "HERMES_HOME": str(worker)}
sys.exit(subprocess.run([sys.executable, str(script), *sys.argv[1:]], env=env).returncode)
