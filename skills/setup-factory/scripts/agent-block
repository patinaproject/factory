#!/usr/bin/env python3
"""Render, check, or write the factory block in a Claude Code CLAUDE.md, and its allow rules in settings.json.

Setup part 17 owns the text between the `<!-- factory:begin -->` and
`<!-- factory:end -->` markers. The block is rendered only from
`references/agent-instructions.block.tmpl` and a JSON values file, so a fresh
install reproduces the live block byte for byte. With no flag, or with `--check`, the
command compares the live block with the render and prints PASS or FAIL, with a diff
on a difference. A marker inside a line of other text, such as a code span,
is not a block. A line that equals a marker once every whitespace and invisible
format character (Unicode category Cf) is removed is a marker line, and one that
is not exactly the marker is refused with its stray characters named.
CRLF and CR-only line endings read as line breaks. `--write` replaces the block in place, keeps every other
line, saves the file with LF endings, and backs up CLAUDE.md first. `--print` writes the render to stdout.

The same values render `ALLOW_RULES`, the Claude Code permission rules that let a session run the
factory's read-only commands without a prompt. `--check` reports PASS or FAIL for `<config>/settings.json`
and names each rule it lacks. `--write` adds the missing rules to `permissions.allow`, keeps every other
key and entry, creates the file when it is absent, backs it up first, and saves it with 2-space indent.
A `settings.json` that is not a JSON object is refused.

Template syntax: `{{name}}` takes a value, and `{{#name}}...{{/name}}` keeps
its text only when the value of `name` is set. A value may span lines; its
continuation lines carry their own indent.
"""
from __future__ import annotations

import argparse
import difflib
import json
import os
import re
import shutil
import sys
import time
import unicodedata
from pathlib import Path

BEGIN = "<!-- factory:begin -->"
END = "<!-- factory:end -->"
TEMPLATE = Path(__file__).resolve().parents[1] / "references" / "agent-instructions.block.tmpl"
SECTION = re.compile(r"\{\{#(\w+)\}\}(.*?)\{\{/\1\}\}", re.S)
PLACEHOLDER = re.compile(r"\{\{(\w+)\}\}")
ALLOW_RULES = ("Bash(python3 {{gateway_home}}/plugins/linear-agent-session/cli.py session *)",)
BLOCK = re.compile(rf"^{re.escape(BEGIN)}$.*?^{re.escape(END)}$\n?", re.M | re.S)


def read_lines(path: Path) -> str:
    """Decode as UTF-8 and treat CRLF and CR as line breaks. `Path.read_text(newline=)` needs Python 3.13."""
    return path.read_bytes().decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")


def template_keys(template: str) -> set[str]:
    return set(re.findall(r"\{\{[#/]?(\w+)\}\}", template))


def render(template: str, values: dict) -> str:
    keys = template_keys(template)
    if keys - set(values):
        raise ValueError(f"missing values: {', '.join(sorted(keys - set(values)))}")
    if set(values) - keys:
        raise ValueError(f"unknown values: {', '.join(sorted(set(values) - keys))}")
    text = template
    while SECTION.search(text):
        text = SECTION.sub(lambda m: m.group(2) if values[m.group(1)] else "", text)

    def fill(match: re.Match) -> str:
        value = values[match.group(1)]
        if not isinstance(value, str) or not value:
            raise ValueError(f"value {match.group(1)} must be a non-empty string")
        return value

    return PLACEHOLDER.sub(fill, text)


def bare(text: str) -> str:
    return "".join(c for c in text if not c.isspace() and unicodedata.category(c) != "Cf")


MARKERS = {bare(BEGIN): BEGIN, bare(END): END}


def marker_of(line: str) -> str | None:
    return MARKERS.get(bare(line))


def stray_characters(line: str, marker: str) -> list[str]:
    opcodes = difflib.SequenceMatcher(None, marker, line, autojunk=False).get_opcodes()
    stray = dict.fromkeys(c for op, _, _, j1, j2 in opcodes if op in ("insert", "replace") for c in line[j1:j2])
    return [f"U+{ord(c):04X} {unicodedata.name(c, 'UNNAMED')}" for c in stray]


def marker_problem(lines: list[str]) -> str | None:
    for n, line in enumerate(lines, 1):
        marker = marker_of(line)
        if marker and line != marker:
            stray = stray_characters(line, marker)
            what = f"stray characters {', '.join(stray)}" if stray else "missing characters"
            return f"line {n} holds a marker with {what}; put the marker {marker} alone on its line"
    begins, ends = lines.count(BEGIN), lines.count(END)
    if begins != 1 or ends != 1:
        return f"expected one {BEGIN} and one {END}, found {begins} and {ends}"
    if lines.index(BEGIN) > lines.index(END):
        return f"{END} comes before {BEGIN}"
    return None


def check(config: Path, template: str, values: dict) -> list[tuple[bool, str]]:
    claude_md = config / "CLAUDE.md"
    if not claude_md.is_file():
        return [(False, f"{claude_md} is missing; write the block with --write")]
    text = read_lines(claude_md)
    problem = marker_problem(text.split("\n"))
    if problem:
        return [(False, f"{claude_md}: {problem}")]
    live = BLOCK.search(text).group(0)
    expected = render(template, values)
    if live == expected:
        return [(True, f"{claude_md}: the factory block equals the render")]
    diff = "\n".join(
        difflib.unified_diff(live.splitlines(), expected.splitlines(), "live block", "render", lineterm="")
    )
    return [(False, f"{claude_md}: the factory block differs from the render\n{diff}")]


def write(config: Path, template: str, values: dict) -> str:
    claude_md = config / "CLAUDE.md"
    block = render(template, values)
    text = read_lines(claude_md) if claude_md.exists() else ""
    if text.strip():
        lines = text.split("\n")
        problem = marker_problem(lines) if any(marker_of(line) for line in lines) else None
        if problem:
            raise ValueError(f"{claude_md}: {problem}")
    if BLOCK.search(text):
        new = BLOCK.sub(lambda _: block, text, count=1)
    else:
        new = (text.rstrip("\n") + "\n\n" if text.strip() else "") + block
    if claude_md.exists() and new.encode() == claude_md.read_bytes():
        return "unchanged"
    claude_md.parent.mkdir(parents=True, exist_ok=True)
    backup = ""
    if text:
        backup_path = claude_md.with_name(f"CLAUDE.md.bak-{time.strftime('%Y%m%d%H%M%S')}")
        shutil.copy2(claude_md, backup_path)
        backup = f"; backup at {backup_path}"
    claude_md.write_bytes(new.encode("utf-8"))
    return f"wrote the factory block{backup}"


def allow_rules(values: dict) -> list[str]:
    def fill(match: re.Match) -> str:
        value = values.get(match.group(1))
        if not isinstance(value, str) or not value:
            raise ValueError(f"value {match.group(1)} must be a non-empty string")
        return value

    return [PLACEHOLDER.sub(fill, rule) for rule in ALLOW_RULES]


def read_settings(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        settings = json.loads(path.read_bytes().decode("utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"{path} is not valid JSON: {error}") from None
    if not isinstance(settings, dict):
        raise ValueError(f"{path} is not a JSON object; fix it by hand")
    permissions = settings.get("permissions", {})
    if not isinstance(permissions, dict) or not isinstance(permissions.get("allow", []), list):
        raise ValueError(f"{path}: permissions.allow is not a list; fix it by hand")
    return settings


def check_settings(config: Path, values: dict) -> list[tuple[bool, str]]:
    path = config / "settings.json"
    if not path.is_file():
        return [(False, f"{path} is missing; write the allow rules with --write")]
    allow = read_settings(path).get("permissions", {}).get("allow", [])
    missing = [rule for rule in allow_rules(values) if rule not in allow]
    if missing:
        return [(False, f"{path}: permissions.allow lacks {rule}") for rule in missing]
    return [(True, f"{path}: permissions.allow holds the factory's allow rules")]


def write_settings(config: Path, values: dict) -> str:
    path = config / "settings.json"
    settings = read_settings(path)
    allow = settings.setdefault("permissions", {}).setdefault("allow", [])
    missing = [rule for rule in allow_rules(values) if rule not in allow]
    if not missing and path.exists():
        return "unchanged"
    allow += missing
    path.parent.mkdir(parents=True, exist_ok=True)
    backup = ""
    if path.exists():
        backup_path = path.with_name(f"settings.json.bak-{time.strftime('%Y%m%d%H%M%S')}")
        shutil.copy2(path, backup_path)
        backup = f"; backup at {backup_path}"
    path.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return f"wrote the allow rules{backup}"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--values", required=True, type=Path, help="JSON file of this factory's values")
    parser.add_argument("--config-dir", help="Claude config directory; default $CLAUDE_CONFIG_DIR or ~/.claude")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="compare the block with the render; the default")
    mode.add_argument("--write", action="store_true", help="replace the block, then check")
    mode.add_argument("--print", action="store_true", help="print the render and change nothing")
    args = parser.parse_args(argv)
    config = Path(args.config_dir or os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser().resolve()
    template = TEMPLATE.read_text()
    try:
        values = json.loads(args.values.read_text())
        if args.print:
            sys.stdout.write(render(template, values))
            return 0
        if args.write:
            print(f"{config / 'CLAUDE.md'}: {write(config, template, values)}")
            print(f"{config / 'settings.json'}: {write_settings(config, values)}")
        results = check(config, template, values) + check_settings(config, values)
    except (ValueError, OSError) as error:
        print(f"FAIL {error}")
        return 1
    for ok, message in results:
        print(f"{'PASS' if ok else 'FAIL'} {message}")
    return 0 if all(ok for ok, _ in results) else 1


if __name__ == "__main__":
    sys.exit(main())
