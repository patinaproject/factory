#!/usr/bin/env python3
"""Check that the value Hermes loads for a secret matches the Infisical folder's value.

usage: check-secret-match <env file> <project id> <infisical env> <folder> <key> <webhook route>

Prints `1` and exits 0 when all three hold, and prints `0` and exits 1 when any
fails:

- the Infisical folder has a value for <key>;
- the value Hermes loads for <key> is that same value. Hermes keeps a non-empty
  value that the env file sets, so that value is the one compared. Otherwise
  it is the value that the helper in Hermes' `secrets.command` prints;
- the route's `secret` in <home>/config.yaml, the file beside the env file, is
  still the `${<key>}` reference. `hermes config get` expands or masks it, so
  the reference is only visible in the file text.

The check may run the secrets helper, which agents never run by hand, so it
refuses to run without a terminal and exits 2. Only the operator runs it.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

IDENTITY_KEYS = ("FACTORY_INFISICAL_CLIENT_ID", "FACTORY_INFISICAL_CLIENT_SECRET")


def run(command: list, **kwargs) -> str | None:
    proc = subprocess.run(command, capture_output=True, text=True, stdin=subprocess.DEVNULL, **kwargs)
    return proc.stdout if proc.returncode == 0 else None


def hermes_json(key: str):
    out = run(["hermes", "config", "get", key, "--json"])
    if out is None:
        return None
    lines = out.splitlines()
    for start in range(len(lines)):
        try:
            return json.loads("\n".join(lines[start:]))
        except ValueError:
            continue
    return out.strip().strip("\"'")


def folder_value(project: str, environment: str, folder: str, key: str) -> str | None:
    out = run(["infisical", "export", "--silent", "--projectId", project, "--env", environment, "--path", folder, "--format", "json"])
    try:
        return next((s["value"] for s in json.loads(out or "[]") if s["key"] == key), None)
    except (ValueError, KeyError, TypeError):
        return None


def identity(env_file: str) -> dict:
    found = {}
    with open(env_file) as handle:
        for line in handle:
            name, _, value = line.rstrip("\n").partition("=")
            if name in IDENTITY_KEYS and name not in found:
                found[name] = value
    return found


def dotenv_value(env_file: str, key: str) -> str:
    value = ""
    with open(env_file) as handle:
        for line in handle:
            line = line.strip()
            if line.startswith("export "):
                line = line[len("export "):].lstrip()
            name, sep, raw = line.partition("=")
            if not sep or name.strip() != key:
                continue
            raw = raw.strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                value = raw[1:-1]
            else:
                value = raw.split(" #", 1)[0].rstrip()
    return value


def loaded_value(env_file: str, key: str) -> str | None:
    from_env_file = dotenv_value(env_file, key)
    if from_env_file:
        return from_env_file
    config = hermes_json("secrets.command")
    command = config.get("command") if isinstance(config, dict) else None
    if not command:
        return None
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""), **identity(env_file)}
    out = run(["/bin/sh", "-c", command], env=env)
    prefix = f"{key}='"
    line = next((l for l in (out or "").splitlines() if l.startswith(prefix)), None)
    return line[len(prefix):].rsplit("'", 1)[0] if line and line.endswith("'") else None


def route_reads_key(env_file: str, route: str, key: str) -> bool:
    try:
        lines = (Path(env_file).parent / "config.yaml").read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    indent = None
    for line in lines:
        stripped = line.strip()
        depth = len(line) - len(line.lstrip())
        if indent is None:
            if stripped == f"{route}:":
                indent = depth
        elif stripped and depth <= indent:
            return False
        elif stripped.startswith("secret:"):
            return stripped.split(":", 1)[1].strip().strip("\"'") == "${" + key + "}"
    return False


def main(argv: list) -> int:
    if len(argv) != 7:
        print("usage: check-secret-match <env file> <project id> <infisical env> <folder> <key> <webhook route>", file=sys.stderr)
        return 2
    if not sys.stdin.isatty():
        print("check-secret-match runs the secrets helper, so only the operator runs it, in their own terminal", file=sys.stderr)
        return 2
    env_file, project, environment, folder, key, route = argv[1:]
    expected = folder_value(project, environment, folder, key)
    loaded = loaded_value(env_file, key)
    matches = bool(expected) and expected == loaded and route_reads_key(env_file, route, key)
    print(1 if matches else 0)
    return 0 if matches else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
