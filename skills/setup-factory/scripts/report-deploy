#!/usr/bin/env python3
"""Report auto-deploy's outcomes to the operator, each once, from a --no-agent cron job in the root profile.

Reads only `<root>/auto-deploy.json`. Prints one line for each FAILED, WAITING, or BLOCKED run it has
not reported, one for the first DEPLOYED of each commit, and one for each Manual line it has not
reported while the line stays current. It keeps what it reported in `<root>/report-deploy.json`, mode
600. It prints nothing otherwise, so Hermes delivers nothing on a quiet run. A missing or unreadable
state file prints nothing too, because check-install reports it.
"""
import json
import os
import sys
from pathlib import Path

DEPLOYED_KEPT = 20


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_private(path: Path, data: dict) -> None:
    temp = path.with_name(path.name + ".tmp")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    os.chmod(temp, 0o600)
    os.replace(temp, path)


def short(commit) -> str:
    return commit[:12] if isinstance(commit, str) else "unknown commit"


def report(state: dict, reported: dict) -> tuple:
    """The lines to print and the new record of what was reported."""
    events = [event for event in state.get("events") or [] if isinstance(event, dict) and isinstance(event.get("seq"), int)]
    seen = reported["seq"] if events and reported["seq"] <= events[-1]["seq"] else 0
    deployed = list(reported["deployed"])
    lines = []
    for event in events:
        if event["seq"] <= seen:
            continue
        outcome, commit, detail = event.get("outcome"), event.get("commit"), event.get("detail") or ""
        if outcome == "DEPLOYED":
            if commit not in deployed:
                lines.append(f"auto-deploy deployed {short(commit)}")
                deployed.append(commit)
        elif outcome in ("FAILED", "WAITING", "BLOCKED"):
            lines.append(f"auto-deploy {outcome} at {short(commit)}: {detail}" if detail else f"auto-deploy {outcome} at {short(commit)}")
    current = [f"{item.get('line')}: {item.get('action')}" for item in state.get("manual") or [] if isinstance(item, dict)]
    lines.extend(f"auto-deploy needs a person: {line}" for line in current if line not in reported["manual"])
    record = {
        "seq": events[-1]["seq"] if events else reported["seq"],
        "deployed": deployed[-DEPLOYED_KEPT:],
        "manual": current,
    }
    return lines, record


def main() -> int:
    root = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
    state = read_json(root / "auto-deploy.json")
    if not isinstance(state, dict):
        return 0
    path = root / "report-deploy.json"
    saved = read_json(path)
    reported = {"seq": 0, "deployed": [], "manual": []}
    if isinstance(saved, dict):
        reported.update({key: saved[key] for key in reported if isinstance(saved.get(key), type(reported[key]))})
    lines, record = report(state, reported)
    for line in lines:
        print(line, flush=True)
    if record != reported or not path.exists():
        write_private(path, record)
    return 0


if __name__ == "__main__":
    sys.exit(main())
