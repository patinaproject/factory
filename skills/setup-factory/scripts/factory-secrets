#!/bin/sh
if [ "$#" -gt 0 ]; then
  echo "factory-secrets: takes no arguments; it prints every secret in the folder" >&2
  exit 2
fi
if [ -t 1 ]; then
  echo "factory-secrets: refusing to print secrets to a terminal; Hermes reads them through a pipe" >&2
  exit 2
fi
api_url='<api url>'
project='<project id>'
environment='<environment>'
folder='<folder>'
log_file='<log file>'
# macOS hides the environment of platform binaries such as curl and perl from
# other processes, but arguments are visible to every user, so the identity
# and the token reach curl only on stdin.
unset client_id client_secret token PERL5OPT PERL5LIB PERLLIB
client_id="$FACTORY_INFISICAL_CLIENT_ID"
client_secret="$FACTORY_INFISICAL_CLIENT_SECRET"
unset FACTORY_INFISICAL_CLIENT_ID FACTORY_INFISICAL_CLIENT_SECRET

# Hermes discards this helper's stderr, so each failed step also goes to a log file that a person can read. A line
# holds the time, the step, the attempt, and an exit code, never a value. Exit codes are curl's, or 65 when a
# response is not the expected JSON.
log() { # step attempt code
  [ -n "$log_file" ] || return 0
  (
    umask 077
    if [ -f "$log_file" ] && [ "$(wc -c <"$log_file")" -gt 65536 ]; then
      tail -n 200 "$log_file" >"$log_file.tmp" && mv "$log_file.tmp" "$log_file"
    fi
    printf '%s %s attempt=%s/3 exit=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" >>"$log_file"
    chmod 600 "$log_file"
  ) 2>/dev/null || true
}

if [ -z "$client_id" ] || [ -z "$client_secret" ]; then
  echo "factory-secrets: FACTORY_INFISICAL_CLIENT_ID and FACTORY_INFISICAL_CLIENT_SECRET must both be set" >&2
  log credentials 1 1
  exit 1
fi

request() { /usr/bin/curl -q --silent --show-error --fail --max-time 15 "$@"; }

login() {
  body="$(printf '%s\n%s\n' "$client_id" "$client_secret" |
    /usr/bin/perl -MJSON::PP -e 'chomp(my @l = <STDIN>); print encode_json({clientId => $l[0], clientSecret => $l[1]})')" || return 65
  reply="$(printf '%s' "$body" | request -H 'Content-Type: application/json' --data-binary @- "$api_url/api/v1/auth/universal-auth/login")" ||
    return $?
  unset body
  printf '%s' "$reply" | /usr/bin/perl -MJSON::PP -e '
    my $t = eval { decode_json(do { local $/; <STDIN> })->{accessToken} };
    if (!defined $t || ref $t || $t eq "") { print STDERR "factory-secrets: the login response has no access token\n"; exit 1 }
    print $t' || return 65
}

# Prints what `infisical export --format=dotenv` prints: KEY='value' lines
# sorted by key, an imported secret only where the folder has no such key, and
# newlines escaped only when the secret enables multiline encoding.
export_folder() {
  reply="$(printf 'Authorization: Bearer %s\n' "$1" |
    request -H @- --get \
      --data-urlencode "projectId=$project" \
      --data-urlencode "environment=$environment" \
      --data-urlencode "secretPath=$folder" \
      --data-urlencode includeImports=true \
      --data-urlencode recursive=false \
      --data-urlencode expandSecretReferences=true \
      --data-urlencode includePersonalOverrides=true \
      "$api_url/api/v4/secrets")" || return $?
  printf '%s' "$reply" | /usr/bin/perl -MJSON::PP -e '
      my $r = eval { decode_json(do { local $/; <STDIN> }) };
      if (ref $r ne "HASH" || ref $r->{secrets} ne "ARRAY") { print STDERR "factory-secrets: the secrets response is not the expected JSON\n"; exit 1 }
      my (%seen, @out);
      for my $s (@{$r->{secrets}}) {
        $seen{$s->{secretKey}} = 1;
        push @out, [$s->{secretKey}, $s->{secretValue}, $s->{skipMultilineEncoding}];
      }
      for my $i (reverse @{$r->{imports} || []}) {
        for my $s (@{$i->{secrets}}) { push @out, [$s->{secretKey}, $s->{secretValue}, 0] unless $seen{$s->{secretKey}}++ }
      }
      binmode STDOUT, ":encoding(UTF-8)";
      for my $e (sort { $a->[0] cmp $b->[0] } @out) {
        my $v = $e->[1];
        $v =~ s/\n/\\n/g if $e->[2];
        print "$e->[0]=\x27$v\x27\n";
      }' || return 65
}

for n in 1 2 3; do
  step=login
  token="$(login)"
  code=$?
  if [ "$code" = 0 ]; then
    step=export
    out="$(export_folder "$token")"
    code=$?
    [ "$code" != 0 ] || [ -n "$out" ] || code=65
  fi
  if [ "$code" = 0 ]; then
    log ok "$n" 0
    printf '%s\n' "$out"
    exit 0
  fi
  log "$step" "$n" "$code"
  echo "factory-secrets: attempt $n of 3 failed" >&2
  [ "$n" = 3 ] || sleep 2
done
echo "factory-secrets: Infisical export failed after 3 attempts" >&2
exit 1
