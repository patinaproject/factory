# Source this file; do not run it. It defines `identity_keys` and
# `identity_value`, which sign in as the factory's Infisical machine identity
# and read one folder through the REST API.
#
# Only /usr/bin/curl and /usr/bin/perl receive the identity, on standard input,
# because macOS hides the environment of platform binaries from other processes.
#
#   identity_keys  ENV_FILE ENVIRONMENT SECRET_PATH       names only
#   identity_value ENV_FILE ENVIRONMENT SECRET_PATH KEY   one value
#
# ENV_FILE holds FACTORY_INFISICAL_CLIENT_ID and FACTORY_INFISICAL_CLIENT_SECRET;
# no other key of it is read. Exit codes: 2 when sign-in fails, 1 when the
# folder cannot be read or has no such key, 3 when identity_value would print to a terminal.

_identity_response() (
  unset PERL5OPT PERL5LIB PERLLIB
  _id=$(sed -n 's/^FACTORY_INFISICAL_CLIENT_ID=//p' "$2" | head -n 1)
  _secret=$(sed -n 's/^FACTORY_INFISICAL_CLIENT_SECRET=//p' "$2" | head -n 1)
  _tok=$(printf '%s\n%s\n' "$_id" "$_secret" |
    /usr/bin/perl -MJSON::PP -e 'chomp(my @l = <STDIN>); print encode_json({clientId => $l[0], clientSecret => $l[1]})' |
    /usr/bin/curl -q --silent --fail --max-time 15 -H 'Content-Type: application/json' --data-binary @- \
      '<api url>/api/v1/auth/universal-auth/login' |
    /usr/bin/perl -MJSON::PP -e 'print eval { decode_json(do { local $/; <STDIN> })->{accessToken} }' 2>/dev/null)
  unset _id _secret
  [ -n "$_tok" ] || { echo "$1: sign-in failed" >&2; exit 2; }
  printf 'Authorization: Bearer %s\n' "$_tok" |
    /usr/bin/curl -q --silent --fail --max-time 15 -H @- --get \
      --data-urlencode 'projectId=<project id>' --data-urlencode "environment=$3" \
      --data-urlencode "secretPath=$4" --data-urlencode recursive=false \
      '<api url>/api/v4/secrets' || exit 1
)

identity_keys() (
  _out=$(_identity_response identity_keys "$@") || exit $?
  printf '%s' "$_out" |
    /usr/bin/perl -MJSON::PP -e 'my $r = eval { decode_json(do { local $/; <STDIN> }) } or exit 1; print "$_->{secretKey}\n" for @{$r->{secrets} || []}' 2>/dev/null
)

identity_value() (
  [ -t 1 ] && { echo "identity_value: refusing to print a secret to a terminal" >&2; exit 3; }
  _out=$(_identity_response identity_value "$1" "$2" "$3") || exit $?
  printf '%s' "$_out" |
    /usr/bin/perl -MJSON::PP -e '
      my $r = eval { decode_json(do { local $/; <STDIN> }) } or exit 1;
      binmode STDOUT, ":encoding(UTF-8)";
      for my $s (@{$r->{secrets} || []}) { if ($s->{secretKey} eq $ARGV[0]) { print "$s->{secretValue}\n"; exit 0 } }
      exit 1' "$4" 2>/dev/null
)
