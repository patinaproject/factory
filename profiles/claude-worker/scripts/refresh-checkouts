#!/usr/bin/env python3
"""Fast-forward every configured repository's main checkout to origin's default branch.

Silent on success. Prints one line per checkout it left alone, so a Hermes
script-only cron job delivers only problems. It never resets or discards work.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

SETTINGS_KEY = "plugins.entries.linear-agent-session.settings"


def git(cwd: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def load_settings(settings_file: str | None) -> dict:
    if settings_file:
        return json.loads(Path(settings_file).read_text())
    if os.environ.get("FACTORY_SETTINGS_JSON"):
        return json.loads(Path(os.environ["FACTORY_SETTINGS_JSON"]).read_text())
    proc = subprocess.run(
        ["hermes", "config", "get", SETTINGS_KEY, "--json", "--raw"],
        capture_output=True,
        text=True,
        check=True,
    )
    return json.loads(proc.stdout)


def refresh(name: str, path: str) -> str | None:
    if not Path(path).is_dir():
        return f"{name}: checkout {path} does not exist"
    head = git(path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if head.returncode != 0:
        return f"{name}: origin/HEAD is not set; run git remote set-head origin --auto"
    default = head.stdout.strip().split("/", 1)[1]
    fetch = git(path, "fetch", "--prune", "origin")
    if fetch.returncode != 0:
        return f"{name}: git fetch failed: {fetch.stderr.strip()}"
    branch = git(path, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
    if branch != default:
        return f"{name}: on {branch or 'a detached HEAD'}, not {default}; left unchanged"
    # Untracked files are expected: Kanban worktrees live under <checkout>/.worktrees/.
    if git(path, "status", "--porcelain", "--untracked-files=no").stdout.strip():
        return f"{name}: uncommitted changes on {default}; left unchanged"
    merge = git(path, "merge", "--ff-only", f"origin/{default}")
    if merge.returncode != 0:
        return f"{name}: {default} cannot fast-forward to origin/{default}; left unchanged"
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--settings-json")
    args = parser.parse_args()
    settings = load_settings(args.settings_json)
    for repo in settings.get("repositories") or []:
        problem = refresh(repo["full_name"], repo["path"])
        if problem:
            print(problem)
    return 0


if __name__ == "__main__":
    sys.exit(main())
