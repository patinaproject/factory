#!/usr/bin/env python3
"""Report where the live factory install differs from the repository.

Compares the worker profile, the plugins in the root and worker homes, and the
webhook config against a commit of the repository, read with git plumbing so
the checkout's working tree and branch do not matter. Also checks that the
dashboard's OIDC sign-in can keep a user signed in, that the gateway rejected
no webhook delivery with 429 in the last hour, and that the owned-refs file
the `github` route reads is present and fresh. Silent when the install
matches. Prints one line per difference and exits 1, or exits 2 when it cannot
run.

It also checks that the config keys, cron jobs, and launchd services the setup
runbook creates still match what it creates (the CONFIG, CRON, and SERVICES
tables), that a cron job delivers only to a platform with a home channel in
its profile, that the root home's check-install-alert wrapper matches the
repository, that the worker home's secrets.command is the worker helper
whenever a proxy token is configured, that the worker's .env holds no secret
only the gateway may hold, and that each configured repository checkout exists
and has origin/HEAD set, and that the root home's broker socket answers a
status request and reports the upload token, the Linear app credentials, and
the proxy token present. That check sends only {"op": "status"}, never uploads
or asks for a token, and prints no value. When any difference is
reported and the source checkout is not at origin/HEAD, the last line names
that checkout. It gives the fast-forward command only when the checkout is
behind, on the default branch, and clean. --ref turns the line off, because
the target is then not origin/HEAD. --print-source prints the checkout path
and exits.

LAUNCHD_ROOT and LAUNCHCTL_BIN point the launchd check at another file system
root and launchctl, for tests.
"""
from __future__ import annotations

import argparse
import concurrent.futures
import glob
import json
import os
import plistlib
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path
from typing import Callable, NamedTuple

PROFILE = "profiles/claude-worker"
PROFILE_PATHS = (f"{PROFILE}/SOUL.md", f"{PROFILE}/scripts")
OWNED_REFS = "owned-refs.json"
LINEAR_ISSUE_FIELD = "data.id"
LINEAR_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# Deliver values that name no platform, so no home channel is needed.
NON_PLATFORM_TARGETS = ("local", "origin", "all")
ROOT_ALERT_SCRIPT = "check-install-alert"
ROOT_ALERT_SOURCE = f"skills/setup-factory/scripts/{ROOT_ALERT_SCRIPT}"
# Hermes' self-hosted provider requests these scopes when dashboard.oauth.self_hosted.scopes is unset.
DEFAULT_OIDC_SCOPES = "openid profile email"
PLACEHOLDER = re.compile(r"^\$\{[A-Za-z_][A-Za-z0-9_]*\}$")
RATE_LIMIT_KEY = "platforms.webhook.extra.rate_limit"
SETTINGS_KEY = "plugins.entries.linear-agent-session.settings"
# aiohttp's access line in the gateway log, stamped in local time by Hermes' log format.
REJECTED = re.compile(r'^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ .*"POST /webhooks/([^ ?"]+)[^"]*" 429 ')


class Drift(NamedTuple):
    kind: str
    where: str
    detail: str

    def __str__(self) -> str:
        return f"{self.kind} {self.where}: {self.detail}"


class Refusal(Exception):
    pass


class Want(NamedTuple):
    ok: Callable[[object], bool]
    text: str


def equal(value) -> Want:
    return Want(lambda live: live == value, json.dumps(value))


def prefixed(prefix: str, what: str) -> Want:
    return Want(lambda live: isinstance(live, str) and live.startswith(prefix) and live != prefix, what)


def one_of(*wants: Want) -> Want:
    return Want(lambda live: any(want.ok(live) for want in wants), " or ".join(want.text for want in wants))


def unset() -> Want:
    return Want(lambda live: live in (None, ""), "unset")


def declared(what: str, *, besides: tuple = ()) -> Want:
    """A per-factory value from the runbook's inputs: any value counts, except an empty one or `besides`."""
    return Want(lambda live: live not in (None, "", *besides), what)


def non_empty_list(what: str) -> Want:
    return Want(lambda live: isinstance(live, list) and len(live) > 0, what)


ROOT, WORKER = "root", "worker"
BOTH = (ROOT, WORKER)


class ConfigKey(NamedTuple):
    part: int
    key: str
    homes: tuple
    want: Want
    same_in_homes: bool = False


class CronJob(NamedTuple):
    part: int
    name: str
    minutes: int
    deliver: Want
    home: str = WORKER
    script: str = ""

    @property
    def runs(self) -> str:
        return self.script or self.name


class Service(NamedTuple):
    part: int
    name: str
    kind: str
    plist: str

    def domains(self) -> tuple:
        # A user agent loads in gui/<uid> from a login session and in user/<uid> otherwise, such as over SSH.
        uid = os.getuid()
        return ("system",) if self.kind == "daemon" else (f"gui/{uid}", f"user/{uid}")


# What each part of skills/setup-factory/SKILL.md sets. check_routes and check_dashboard cover the
# routes and dashboard keys. Optional parts (3, 14) and secret-bearing keys are not listed.
CONFIG = (
    ConfigKey(
        4, "model.provider", BOTH,
        one_of(equal("claude-subscription-directsdk-experimental"), prefixed("custom:", "custom:<proxy provider>")),
        same_in_homes=True,
    ),
    ConfigKey(4, "model.default", BOTH, declared("set to the operator's model alias")),
    ConfigKey(6, "platforms.webhook.enabled", (ROOT,), equal(True)),
    ConfigKey(6, "platforms.webhook.extra.host", (ROOT,), equal("127.0.0.1")),
    ConfigKey(6, "platforms.webhook.extra.port", (ROOT,), declared("set to the webhook port")),
    ConfigKey(
        10, SETTINGS_KEY, BOTH, declared("set to the factory settings"),
        same_in_homes=True,
    ),
    ConfigKey(10, "kanban.max_in_progress", (ROOT,), declared("set to the operator's card limit")),
    ConfigKey(10, "kanban.review_dispatch", (ROOT,), equal(False)),
    ConfigKey(10, "kanban.auto_decompose", (ROOT,), equal(False)),
    ConfigKey(10, "kanban.default_assignee", (ROOT,), unset()),
    ConfigKey(5, "terminal.timeout", (WORKER,), equal(400)),
    ConfigKey(5, "terminal.env_passthrough", (WORKER,), Want(lambda live: not live, "empty")),
    ConfigKey(5, "platforms.factory_uploads.enabled", (ROOT,), equal(True)),
    ConfigKey(
        5, "platforms.factory_uploads.extra.repositories", (ROOT,),
        non_empty_list("a non-empty list of <owner>/<repo> names"),
    ),
    ConfigKey(13, "streaming.enabled", (ROOT,), equal(True)),
    ConfigKey(13, "platforms.slack.extra.native_task_cards", (ROOT,), equal(True)),
)

# Script-only jobs. A job belongs to the profile named by `home`: the worker for its own scripts, the root for a job
# whose output must reach the operator's chat, because only the root profile runs the chat platform. A job runs the
# script of the same name unless `script` names another.
CRON = (
    CronJob(10, "refresh-gh-app-login", 30, equal("local")),
    CronJob(12, "refresh-checkouts", 60, equal("local")),
    CronJob(12, "refresh-owned-refs", 1, equal("local")),
    CronJob(
        12, "check-install", 60, declared("the operator's chat platform", besides=("local",)),
        home=ROOT, script=ROOT_ALERT_SCRIPT,
    ),
)
OWNED_REFS_MAX_AGE = 5 * 60 * next(job.minutes for job in CRON if job.name == "refresh-owned-refs")

# macOS only. `plist` is a glob; the runbook lets the operator name the cloudflared plist.
SERVICES = (
    Service(7, "cloudflared tunnel", "daemon", "/Library/LaunchDaemons/*cloudflared*.plist"),
    Service(15, "Hermes gateway", "agent", "~/Library/LaunchAgents/ai.hermes.gateway.plist"),
)


class Commit(NamedTuple):
    repo: Path
    sha: str
    label: str

    @property
    def short(self) -> str:
        return self.sha[:7]

    def files(self, path: str) -> dict:
        """Map each file path under `path` to its blob id."""
        out = git(self.repo, "ls-tree", "-r", "-z", self.sha, "--", path)
        files = {}
        for entry in filter(None, out.split("\0")):
            meta, name = entry.split("\t", 1)
            files[name] = meta.split()[2]
        return files

    def blob(self, blob_id: str) -> bytes:
        return subprocess.run(
            ["git", "cat-file", "blob", blob_id], cwd=self.repo, capture_output=True, check=True
        ).stdout


def git(repo: Path, *args: str) -> str:
    proc = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"git {' '.join(args)} failed in {repo}: {proc.stderr.strip()}")
    return proc.stdout


def compare_files(commit: Commit, files: dict, strip: str, home: Path) -> list:
    """Return a detail for each file at the commit that is missing or different under `home`."""
    details = []
    for path, blob_id in sorted(files.items()):
        relative = path[len(strip):]
        installed = home / relative
        if not installed.is_file():
            details.append(f"{relative} is missing")
        elif installed.read_bytes() != commit.blob(blob_id):
            details.append(f"{relative} differs from {commit.label} at {commit.short}")
    return details


def check_profile(commit: Commit, worker: Path) -> list:
    files = {}
    for path in PROFILE_PATHS:
        files.update(commit.files(path))
    return [Drift("profile", "claude-worker", d) for d in compare_files(commit, files, f"{PROFILE}/", worker)]


# Plugins that run in the gateway only. Their code lives in the root home and never in the worker's.
ROOT_ONLY_PLUGINS = frozenset({"factory-uploads"})


def check_plugins(commit: Commit, homes: list) -> list:
    """`homes` is [root, worker]."""
    plugins: dict = {}
    for path, blob_id in commit.files("plugins").items():
        _, name, rest = path.split("/", 2)
        if not rest.startswith("tests/"):
            plugins.setdefault(name, {})[path] = blob_id
    drifts = []
    for name, files in sorted(plugins.items()):
        wanted = homes[:1] if name in ROOT_ONLY_PLUGINS else homes
        for home in homes[len(wanted):]:
            if (home / "plugins" / name).exists():
                drifts.append(Drift("plugin", f"{name} in {home}", "installed, but it runs only in the root home"))
        for home in wanted:
            where = f"{name} in {home}"
            installed = home / "plugins" / name
            if not installed.is_dir():
                drifts.append(Drift("plugin", where, "not installed"))
                continue
            details = compare_files(commit, files, f"plugins/{name}/", installed)
            drifts.extend(Drift("plugin", where, d) for d in details)
    return drifts


def matches(rendered, installed) -> bool:
    # Hermes expands ${VAR} secrets when it reads config, so a placeholder matches any installed value.
    if isinstance(rendered, str) and PLACEHOLDER.match(rendered):
        return installed is not None
    if isinstance(rendered, dict) and isinstance(installed, dict):
        return rendered.keys() == installed.keys() and all(matches(rendered[k], installed[k]) for k in rendered)
    if isinstance(rendered, list) and isinstance(installed, list):
        return len(rendered) == len(installed) and all(map(matches, rendered, installed))
    return rendered == installed


def check_routes(commit: Commit, root: Path, hermes: str) -> list:
    with tempfile.TemporaryDirectory() as tmp:
        work = Path(tmp)
        for path, blob_id in commit.files("templates").items():
            target = work / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(commit.blob(blob_id))
        # render.py runs `hermes` by name, so put the chosen executable first on PATH under that name.
        shim = work / "bin"
        shim.mkdir()
        (shim / "hermes").symlink_to(hermes)
        env = {**os.environ, "HERMES_HOME": str(root), "PATH": f"{shim}{os.pathsep}{os.environ.get('PATH', '')}"}
        render = subprocess.run(
            [sys.executable, str(work / "templates" / "render.py")], env=env, capture_output=True, text=True
        )
    if render.returncode != 0:
        return [Drift("webhook config", str(root), f"render.py failed at {commit.short}: {render.stderr.strip()}")]

    drifts = []
    env = {**os.environ, "HERMES_HOME": str(root)}
    for key, value in json.loads(render.stdout).items():
        # Without --raw, Hermes masks secrets; matches() never compares them.
        proc = subprocess.run([hermes, "config", "get", key, "--json"], env=env, capture_output=True, text=True)
        if proc.returncode != 0:
            drifts.append(Drift("webhook config", key, f"not installed in {root}"))
        elif not matches(value, json.loads(proc.stdout)):
            drifts.append(Drift("webhook config", key, f"differs from the value rendered at {commit.short}"))
        elif f'"{LINEAR_ISSUE_FIELD}"' in proc.stdout:
            drifts.extend(check_linear_ids(root, key))
    return drifts


def check_linear_ids(root: Path, key: str) -> list:
    # Re-rendering the route before refresh-owned-refs ran drops every closure, so the order is checked here.
    try:
        refs = json.loads((root / OWNED_REFS).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []  # check_owned_refs reports a missing file
    if not refs:
        return []  # an empty board has no card to close; every triage-created card has a linear_issue_id line
    if any(isinstance(ref, str) and LINEAR_ID.fullmatch(ref) for ref in refs):
        return []
    return [Drift(
        "webhook config", key,
        f"filters on Linear issue ids, but {root / OWNED_REFS} holds none; deploy the profile and run refresh-owned-refs "
        "once before the route (part 11)",
    )]


def check_rejected_deliveries(root: Path) -> list:
    log = root / "logs" / "agent.log"
    if not log.is_file():
        return [Drift("webhook deliveries", str(root), f"cannot read {log} to count 429 responses")]
    since = (datetime.now() - timedelta(hours=1)).strftime("%Y-%m-%d %H:%M:%S")
    rejected: Counter = Counter()
    for path in (log.with_name("agent.log.1"), log):
        if not path.is_file():
            continue
        with path.open(encoding="utf-8", errors="replace") as lines:
            for line in lines:
                match = REJECTED.match(line)
                if match and match.group(1) >= since:
                    rejected[match.group(2)] += 1
    return [
        Drift("webhook route", route, f"{count} rejected with HTTP 429 in the last hour; check {RATE_LIMIT_KEY}")
        for route, count in sorted(rejected.items())
    ]


def check_dashboard(root: Path, hermes: str) -> list:
    where = str(root)
    proc = subprocess.run(
        [hermes, "config", "get", "dashboard", "--json"],
        env={**os.environ, "HERMES_HOME": str(root)}, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return [Drift("dashboard sign-in", where, f"hermes config get dashboard failed: {proc.stderr.strip()}")]
    try:
        dashboard = json.loads(proc.stdout)
    except ValueError:
        return [Drift("dashboard sign-in", where, "hermes config get dashboard did not return JSON")]
    self_hosted = (dashboard.get("oauth") or {}).get("self_hosted") or {}
    issuer = (self_hosted.get("issuer") or "").rstrip("/")
    drifts = []
    if not dashboard.get("public_url"):
        drifts.append(Drift("dashboard sign-in", where, "dashboard.public_url is not set"))
    if not issuer:
        return [*drifts, Drift("dashboard sign-in", where, "dashboard.oauth.self_hosted.issuer is not set")]
    if not self_hosted.get("client_id"):
        drifts.append(Drift("dashboard sign-in", where, "dashboard.oauth.self_hosted.client_id is not set"))
    if "offline_access" not in (self_hosted.get("scopes") or DEFAULT_OIDC_SCOPES).split():
        drifts.append(Drift(
            "dashboard sign-in", where,
            "dashboard.oauth.self_hosted.scopes does not request offline_access, so the issuer returns no refresh token",
        ))
    try:
        with urllib.request.urlopen(f"{issuer}/.well-known/openid-configuration", timeout=10) as resp:
            grants = json.load(resp).get("grant_types_supported") or []
    except (OSError, ValueError) as exc:
        return [*drifts, Drift("dashboard sign-in", where, f"cannot read the issuer's discovery document: {exc}")]
    if "refresh_tokens" not in grants and "refresh_token" not in grants:
        drifts.append(Drift("dashboard sign-in", where, "the issuer does not offer the refresh_tokens grant"))
    return drifts


def config_value(home: Path, hermes: str, key: str):
    # Without --raw, Hermes masks secrets. Values are compared here and never printed.
    proc = subprocess.run(
        [hermes, "config", "get", key, "--json"], env={**os.environ, "HERMES_HOME": str(home)},
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        return json.loads(proc.stdout)
    if "Config key not set" in proc.stderr:
        return None
    raise Refusal(f"hermes config get {key} failed in {home}: {proc.stderr.strip()}")


def check_config(home_paths: dict, hermes: str) -> list:
    reads = [(entry, home) for entry in CONFIG for home in entry.homes]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        values = list(pool.map(lambda read: config_value(home_paths[read[1]], hermes, read[0].key), reads))
    drifts = []
    by_key: dict = {}
    for (entry, home), value in zip(reads, values):
        if not entry.want.ok(value):
            detail = f"is not {entry.want.text} (part {entry.part})"
            drifts.append(Drift("config", f"{entry.key} in {home_paths[home]}", detail))
        by_key.setdefault(entry.key, []).append(value)
    for entry in CONFIG:
        values = by_key[entry.key]
        if entry.same_in_homes and any(value != values[0] for value in values):
            between = " and ".join(str(home_paths[home]) for home in entry.homes)
            drifts.append(Drift("config", entry.key, f"differs between {between} (part {entry.part})"))
    return drifts


UPLOAD_SOCKET = "factory-uploads.sock"
UPLOAD_STATUS_SECONDS = 5


def check_upload_broker(root: Path, token_env: str) -> list:
    """Ask the root home's broker for its status. Sends no upload, asks for no token, and reports no value."""
    path = root / UPLOAD_SOCKET

    def drift(detail: str) -> list:
        return [Drift("upload broker", str(path), f"{detail} (part 5)")]

    reply = b""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(UPLOAD_STATUS_SECONDS)
            client.connect(str(path))
            client.sendall(b'{"op":"status"}\n')
            while not reply.endswith(b"\n") and len(reply) < 65536:
                chunk = client.recv(4096)
                if not chunk:
                    break
                reply += chunk
    except OSError:
        return drift("is unreachable: the gateway is not listening on it")
    try:
        status = json.loads(reply)
    except ValueError:
        return drift("did not answer a status request with JSON")
    if not isinstance(status, dict) or status.get("ok") is not True:
        return drift("did not answer a status request with ok")
    drifts = []
    if status.get("token_present") is not True:
        drifts += drift("reports token_present false: the gateway holds no upload token")
    if status.get("linear_ready") is not True:
        drifts += drift("reports linear_ready false: the gateway holds no Linear app credentials, so no worker reaches Linear")
    if token_env and status.get("proxy_token_present") is not True:
        drifts += drift(f"reports proxy_token_present false: the gateway holds no {token_env}, so no worker reaches the proxy")
    return drifts


GATEWAY_ONLY = {
    "LINEAR_CLIENT_ID": 8, "LINEAR_CLIENT_SECRET": 8,
    "FACTORY_INFISICAL_CLIENT_ID": 14, "FACTORY_INFISICAL_CLIENT_SECRET": 14,
}
SECRET_NAMES = "plugins/factory-secret-names/plugin.yaml"
DECLARED_NAME = re.compile(r"^\s*-\s*name:\s*([A-Za-z_][A-Za-z0-9_]*)\s*$", re.MULTILINE)


def token_variable(settings) -> str:
    session = settings.get("claude_session") if isinstance(settings, dict) else None
    return (session.get("auth_token_env") or "") if isinstance(session, dict) else ""


def check_worker_secrets(commit: Commit, worker: Path, hermes: str, settings) -> list:
    token_env = token_variable(settings)
    live = config_value(worker, hermes, "secrets.command")
    enabled = isinstance(live, dict) and live.get("enabled") is True
    helper = f"python3 {worker}/scripts/worker-secrets"
    where = f"secrets.command in {worker}"
    drifts = []
    # The live command is never printed, since a tuned command could embed a secret.
    if token_env and not (enabled and live.get("command") == helper):
        drifts.append(Drift("config", where, f"is not the worker helper {helper} (part 5)"))
    elif not token_env and enabled:
        drifts.append(Drift("config", where, "is set, but a worker without a proxy token loads no secret (part 5)"))
    held = {**GATEWAY_ONLY, **({token_env: 3} if token_env else {})}
    for name, part in held.items():
        if env_has(worker, name):
            drifts.append(Drift(
                "secret", f"{name} in {worker}/.env", f"is set, but the worker holds no factory secret; remove it (part {part})"
            ))
    files = commit.files(SECRET_NAMES)
    declared = set(DECLARED_NAME.findall(commit.blob(files[SECRET_NAMES]).decode())) if SECRET_NAMES in files else set()
    if token_env and token_env not in declared:
        drifts.append(Drift(
            "config", f"claude_session.auth_token_env in {worker}",
            f"names {token_env}, which {SECRET_NAMES} does not declare, so every process a home starts inherits it (part 3)",
        ))
    return drifts


def cron_jobs(home: Path) -> list:
    store = home / "cron" / "jobs.json"
    return json.loads(store.read_text())["jobs"] if store.is_file() else []


def cron_differences(job: CronJob, live: dict) -> list:
    details = []
    if not live["enabled"]:
        details.append("is disabled")
    schedule = live["schedule"]
    if schedule.get("kind") != "interval" or schedule.get("minutes") != job.minutes:
        details.append(f"runs {live['schedule_display']}, not every {job.minutes}m")
    if live["script"] != job.runs or not live["no_agent"]:
        details.append(f"is not a script-only job that runs {job.runs}")
    if not job.deliver.ok(live["deliver"]):
        details.append(f"delivers to {json.dumps(live['deliver'])}, not {job.deliver.text}")
    return details


def env_has(home: Path, name: str) -> bool:
    """Whether `<home>/.env` sets `name` to a non-empty value. Values are never returned."""
    path = home / ".env"
    if not path.is_file():
        return False
    for line in path.read_text().splitlines():
        key, sep, value = line.strip().removeprefix("export ").partition("=")
        if sep and key.strip() == name and value.strip().strip("'\""):
            return True
    return False


def unresolved_deliveries(home: Path, live: dict, hermes: str) -> list:
    """Name each platform the job delivers to that has no home channel in the profile that owns the job.

    Hermes resolves a bare platform name through that platform's home channel in the owning profile and drops the
    output when it has none, which the scheduler logs as "no delivery target resolved".
    """
    details = []
    for target in str(live["deliver"]).split(","):
        platform = target.strip().lower()
        if not platform or ":" in platform or platform in NON_PLATFORM_TARGETS or platform.startswith("bot-chat"):
            continue
        if env_has(home, f"{platform.upper()}_HOME_CHANNEL"):
            continue
        if config_value(home, hermes, f"platforms.{platform}.home_channel"):
            continue
        details.append(f"delivers to {platform}, which has no home channel in {home}, so Hermes drops its output")
    return details


def check_root_alert_script(commit: Commit, root: Path) -> list:
    if ROOT_ALERT_SOURCE not in commit.files(ROOT_ALERT_SOURCE):
        return []
    installed = root / "scripts" / ROOT_ALERT_SCRIPT
    where = str(installed)
    if not installed.is_file():
        return [Drift("script", where, f"is missing; install it from {ROOT_ALERT_SOURCE} (part 12)")]
    if installed.read_bytes() != commit.blob(commit.files(ROOT_ALERT_SOURCE)[ROOT_ALERT_SOURCE]):
        return [Drift("script", where, f"differs from {commit.label} at {commit.short} (part 12)")]
    return []


def check_cron(commit: Commit, root: Path, worker: Path, hermes: str) -> list:
    homes = {ROOT: root, WORKER: worker}
    live_jobs = {name: cron_jobs(home) for name, home in homes.items()}
    drifts = check_root_alert_script(commit, root)
    for job in CRON:
        home = homes[job.home]
        where = f"{job.name} in {home}"
        found = [live for live in live_jobs[job.home] if live["name"] == job.name]
        if not found:
            drifts.append(Drift("cron job", where, f"is missing (part {job.part})"))
        elif len(found) > 1:
            drifts.append(Drift("cron job", where, f"exists {len(found)} times (part {job.part})"))
        for live in found:
            details = [*cron_differences(job, live), *unresolved_deliveries(home, live, hermes)]
            drifts.extend(Drift("cron job", where, f"{d} (part {job.part})") for d in details)
    owners = {job.name: job for job in CRON}
    for name, jobs in live_jobs.items():
        for live in jobs:
            where = f"{live['name']} in {homes[name]}"
            owner = owners.get(live["name"])
            if owner is None:
                drifts.append(Drift("cron job", where, "is not a job the setup runbook creates"))
            elif owner.home != name:
                drifts.append(Drift("cron job", where, f"belongs to the {owner.home} profile (part {owner.part})"))
    return drifts


def launchd_state(launchctl: str, domains: tuple, label: str) -> str | None:
    for domain in domains:
        # The full output lists the program arguments, which can hold a token; only the state is read.
        proc = subprocess.run([launchctl, "print", f"{domain}/{label}"], capture_output=True, text=True)
        state = re.search(r"^\s*state = (\S+)", proc.stdout, re.MULTILINE)
        if proc.returncode == 0 and state:
            return state.group(1)
    return None


def check_services(launchd_root: Path, launchctl: str) -> list:
    drifts = []
    for service in SERVICES:
        pattern = str(launchd_root / os.path.expanduser(service.plist).lstrip("/"))
        plists = sorted(glob.glob(pattern))
        if len(plists) != 1:
            found = "no plist matches" if not plists else f"{len(plists)} plists match"
            drifts.append(Drift("service", service.name, f"{found} {service.plist} (part {service.part})"))
            continue
        try:
            with open(plists[0], "rb") as handle:
                plist = plistlib.load(handle)
        except (OSError, plistlib.InvalidFileException) as exc:
            drifts.append(Drift("service", service.name, f"cannot read {plists[0]}: {exc.__class__.__name__}"))
            continue
        # The plist's ProgramArguments can hold a token, so only Label and RunAtLoad are used.
        if plist.get("RunAtLoad") is not True:
            drifts.append(Drift("service", service.name, f"does not run at load (part {service.part})"))
        state = launchd_state(launchctl, service.domains(), plist["Label"])
        if state is None:
            drifts.append(Drift("service", service.name, f"is not loaded in launchd (part {service.part})"))
        elif state != "running":
            drifts.append(Drift("service", service.name, f"is {state}, not running (part {service.part})"))
    return drifts


def check_owned_refs(root: Path) -> list:
    path = root / OWNED_REFS
    if not path.is_file():
        return [Drift("owned refs", str(path), "is missing; create or run the refresh-owned-refs cron job (part 12)")]
    age = time.time() - path.stat().st_mtime
    if age > OWNED_REFS_MAX_AGE:
        return [Drift(
            "owned refs", str(path),
            f"is {int(age // 60)} minutes old; the refresh-owned-refs cron job is not running (part 12)",
        )]
    return []


def check_source_checkout(commit: Commit) -> list:
    repo = commit.repo
    head = git(repo, "rev-parse", "HEAD").strip()
    if head == commit.sha:
        return []

    def is_ancestor(older: str, newer: str) -> bool:
        return subprocess.run(["git", "merge-base", "--is-ancestor", older, newer], cwd=repo).returncode == 0

    branch = subprocess.run(
        ["git", "symbolic-ref", "--short", "--quiet", "HEAD"], cwd=repo, capture_output=True, text=True
    ).stdout.strip()
    blockers = []
    if branch != commit.label:
        blockers.append(f"is on {branch or 'a detached HEAD'}, not {commit.label}")
    if git(repo, "status", "--porcelain").strip():
        blockers.append("has uncommitted changes")
    if not is_ancestor(head, commit.sha):
        ahead = is_ancestor(commit.sha, head)
        blockers.append(f"is ahead of {commit.label}" if ahead else f"has diverged from {commit.label}")
    if blockers:
        return [Drift(
            "source checkout", str(repo),
            f"is not at {commit.label} {commit.short} and {' and '.join(blockers)}. "
            "Do not fast-forward it. Fix it by hand. Leave the worker-owned checkouts to refresh-checkouts.",
        )]
    return [Drift(
        "source checkout", str(repo),
        f"is behind {commit.label} at {commit.short}. Fast-forward only this checkout "
        f"with git -C {repo} merge --ff-only {commit.sha}. "
        "Leave the worker-owned checkouts to refresh-checkouts.",
    )]


def check_checkouts(settings) -> list:
    # Missing or malformed settings are check_config's to report.
    if not isinstance(settings, dict):
        return []
    drifts = []
    for repository in settings.get("repositories") or []:
        path = repository["path"]
        if not Path(path).is_dir():
            drifts.append(Drift("checkout", path, "does not exist (part 10)"))
            continue
        head = subprocess.run(
            ["git", "-C", path, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"], capture_output=True
        )
        if head.returncode != 0:
            drifts.append(Drift(
                "checkout", path, f"origin/HEAD is not set; run git -C {path} remote set-head origin -a (part 10)"
            ))
    return drifts


def check_model_tiers(settings, worker: Path) -> list:
    # Missing or malformed settings are check_config's to report.
    session = settings.get("claude_session") if isinstance(settings, dict) else None
    if not isinstance(session, dict) or not session.get("model"):
        return []
    tiers = session.get("tier_models")
    if isinstance(tiers, dict) and tiers.get("sonnet"):
        return []
    return [Drift(
        "model tier", f"claude_session in {worker}",
        "has a model but no tier_models.sonnet, so every subagent runs on that model (part 3)",
    )]


def homes() -> tuple:
    if not os.environ.get("HERMES_HOME"):
        raise Refusal("HERMES_HOME is not set; point it at the claude-worker profile home")
    worker = Path(os.environ["HERMES_HOME"]).resolve()
    if worker.parent.name != "profiles":
        raise Refusal(f"HERMES_HOME {worker} is not a profile home under <root>/profiles/")
    return worker.parent.parent, worker


def default_repo(worker: Path) -> Path:
    distribution = worker / "distribution.yaml"
    if not distribution.is_file():
        raise Refusal(f"{distribution} does not exist; pass --repo")
    for line in distribution.read_text().splitlines():
        match = re.match(r"^source:\s*['\"]?(.+?)['\"]?\s*$", line)
        if match:
            return Path(match.group(1)).parents[1]
    raise Refusal(f"{distribution} has no source: line; pass --repo")


def resolve_commit(repo: Path, ref: str | None) -> Commit:
    if ref is None:
        label = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").strip().split("/", 1)[1]
        ref = "origin/HEAD"
    else:
        label = ref
    sha = git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}").strip()
    return Commit(repo, sha, label)


def find_hermes() -> str:
    # A cron job's PATH can lack the installer's bin directory, so fall back to where it puts hermes.
    candidates = [os.environ.get("HERMES_BIN"), shutil.which("hermes"), str(Path.home() / ".local" / "bin" / "hermes")]
    for candidate in filter(None, candidates):
        if os.access(candidate, os.X_OK):
            return candidate
    raise Refusal("hermes is not on PATH or in ~/.local/bin; set HERMES_BIN")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo", type=Path, help="factory checkout; defaults to the worker's distribution source")
    parser.add_argument("--ref", help="commit to compare against; defaults to origin/HEAD")
    parser.add_argument("--print-source", action="store_true", help="print the source checkout path and exit")
    parser.add_argument("--no-fetch", action="store_true", help="compare without running git fetch origin first")
    args = parser.parse_args()
    try:
        root, worker = homes()
        repo = args.repo or default_repo(worker)
        if args.print_source:
            print(repo)
            return 0
        if not args.no_fetch:
            git(repo, "fetch", "--quiet", "origin")
        commit = resolve_commit(repo, args.ref)
        hermes = find_hermes()
        hermes = os.path.abspath(hermes)
        settings = config_value(worker, hermes, SETTINGS_KEY)
        drifts = [
            *check_profile(commit, worker),
            *check_plugins(commit, [root, worker]),
            *check_config({ROOT: root, WORKER: worker}, hermes),
            *check_worker_secrets(commit, worker, hermes, settings),
            *check_upload_broker(root, token_variable(settings)),
            *check_cron(commit, root, worker, hermes),
            *check_routes(commit, root, hermes),
            *check_dashboard(root, hermes),
            *check_rejected_deliveries(root),
            *check_owned_refs(root),
            *check_checkouts(settings),
            *check_model_tiers(settings, worker),
        ]
        if sys.platform == "darwin":
            launchd_root = Path(os.environ.get("LAUNCHD_ROOT", "/"))
            drifts.extend(check_services(launchd_root, os.environ.get("LAUNCHCTL_BIN", "launchctl")))
        if drifts and args.ref is None:
            drifts.extend(check_source_checkout(commit))
    except Refusal as exc:
        print(f"check-install: {exc}", file=sys.stderr)
        return 2
    for drift in drifts:
        print(drift)
    return 1 if drifts else 0


if __name__ == "__main__":
    sys.exit(main())
