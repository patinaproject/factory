# Deliver values that name no platform, so no home channel is needed.
NON_PLATFORM_TARGETS = ("local", "origin", "all")
# Statuses of a job's last run that are not a failure; None means the job has not run yet.
HEALTHY_RUNS = (None, "ok", "delivery_queued")
RUN_ERROR_LIMIT = 200
SECRET_NAME = re.compile(r"TOKEN|SECRET|KEY|PASSWORD|CREDENTIAL", re.IGNORECASE)
TOKEN_SHAPED = re.compile(r"[A-Za-z0-9_\-+=.]{24,}")
ROOT_ALERT_SCRIPT = "check-install-alert"
# watch-gateway runs from launchd and restart-gateway is the one it runs, so both live beside the cron wrappers.
