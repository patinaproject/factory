def git(repo: Path, *args: str) -> str:
    proc = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"git {' '.join(args)} failed in {repo}: {proc.stderr.strip()}")
    return proc.stdout


def check_profile(commit: Commit, homes: Homes) -> list:
    files = {}
    for path in PROFILE_PATHS:
        files.update(commit.files(path))
    fix = install_plan.profile_update(homes)
    return [Drift("profile", "claude-worker", d, fix) for d in compare_files(commit, files, f"{PROFILE}/", homes.worker)]


# Plugins that run in the gateway only. Their code lives in the root home and never in the worker's.
ROOT_ONLY_PLUGINS = frozenset({"factory-uploads", "work", "webhook-retry", "factory-deploy"})


def check_plugins(commit: Commit, homes: Homes) -> list:
    plugins: dict = {}
    for path, blob_id in commit.files("plugins").items():
        _, name, rest = path.split("/", 2)
        if not rest.startswith("tests/"):
            plugins.setdefault(name, {})[path] = blob_id
    drifts = []
    pair = [homes.root, homes.worker]
    for name, files in sorted(plugins.items()):
        wanted = pair[:1] if name in ROOT_ONLY_PLUGINS else pair
        for home in pair[len(wanted):]:
            if (home / "plugins" / name).exists():
                drifts.append(Drift(
                    "plugin", f"{name} in {home}", "installed, but it runs only in the root home",
                    install_plan.plugin_remove(homes, home, name),
                ))
        for home in wanted:
            where = f"{name} in {home}"
            installed = home / "plugins" / name
            if not installed.is_dir():
                drifts.append(Drift("plugin", where, "not installed", install_plan.plugin_install(homes, home, name, reinstall=False)))
                continue
            details = compare_files(commit, files, f"plugins/{name}/", installed)
            fix = install_plan.plugin_install(homes, home, name, reinstall=True)
            drifts.extend(Drift("plugin", where, d, fix) for d in details)
    return drifts


def matches(rendered, installed) -> bool:
    # Hermes expands ${VAR} secrets when it reads config, so a placeholder matches any installed value.
    if isinstance(rendered, str) and PLACEHOLDER.match(rendered):
        return installed is not None
    if isinstance(rendered, dict) and isinstance(installed, dict):
        return rendered.keys() == installed.keys() and all(matches(rendered[k], installed[k]) for k in rendered)
    if isinstance(rendered, list) and isinstance(installed, list):
        return len(rendered) == len(installed) and all(map(matches, rendered, installed))
    return rendered == installed


def check_routes(commit: Commit, homes: Homes) -> list:
    root, hermes = homes.root, homes.hermes
    with tempfile.TemporaryDirectory() as tmp:
        work = Path(tmp)
        for path, blob_id in commit.files("templates").items():
            target = work / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(commit.blob(blob_id))
        # render.py runs `hermes` by name, so put the chosen executable first on PATH under that name.
        shim = work / "bin"
        shim.mkdir()
        (shim / "hermes").symlink_to(hermes)
        env = {**os.environ, "HERMES_HOME": str(root), "PATH": f"{shim}{os.pathsep}{os.environ.get('PATH', '')}"}
        render = subprocess.run(
            [sys.executable, str(work / "templates" / "render.py")], env=env, capture_output=True, text=True
        )
    if render.returncode != 0:
        return [Drift(
            "webhook config", str(root), f"render.py failed at {commit.short}: {render.stderr.strip()}",
            Manual("fix the factory settings that render.py names, as part 10 describes"),
        )]

    drifts = []
    env = {**os.environ, "HERMES_HOME": str(root)}
    for key, value in json.loads(render.stdout).items():
        # Without --raw, Hermes masks secrets; matches() never compares them.
        proc = subprocess.run([hermes, "config", "get", key, "--json"], env=env, capture_output=True, text=True)
        fix = install_plan.route_set(homes, key, value)
        if proc.returncode != 0:
            drifts.append(Drift("webhook config", key, f"not installed in {root}", fix))
        elif not matches(value, json.loads(proc.stdout)):
            drifts.append(Drift("webhook config", key, f"differs from the value rendered at {commit.short}", fix))
        elif f'"{LINEAR_ISSUE_FIELD}"' in proc.stdout:
            drifts.extend(check_linear_ids(homes, key))
    return drifts


def check_linear_ids(homes: Homes, key: str) -> list:
    # Re-rendering the route before refresh-owned-refs ran drops every closure, so the order is checked here.
    root = homes.root
    try:
        refs = json.loads((root / OWNED_REFS).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []  # check_owned_refs reports a missing file
    if not refs:
        return []  # an empty board has no card to close; every triage-created card has a linear_issue_id line
    if any(isinstance(ref, str) and LINEAR_ID.fullmatch(ref) for ref in refs):
        return []
    return [Drift(
        "webhook config", key,
        f"filters on Linear issue ids, but {root / OWNED_REFS} holds none; deploy the profile and run refresh-owned-refs "
        "once before the route (part 11)",
        install_plan.refresh_owned_refs(homes),
    )]


def check_rejected_deliveries(root: Path) -> list:
    log = root / "logs" / "agent.log"
    if not log.is_file():
        return [Drift("webhook deliveries", str(root), f"cannot read {log} to count 429 responses", ADVISORY)]
    since = (datetime.now() - timedelta(hours=1)).strftime("%Y-%m-%d %H:%M:%S")
    rejected: Counter = Counter()
    for path in (log.with_name("agent.log.1"), log):
        if not path.is_file():
            continue
        with path.open(encoding="utf-8", errors="replace") as lines:
            for line in lines:
                match = REJECTED.match(line)
                if match and match.group(1) >= since:
                    rejected[match.group(2)] += 1
    return [
        Drift("webhook route", route, f"{count} rejected with HTTP 429 in the last hour; check {RATE_LIMIT_KEY}", ADVISORY)
        for route, count in sorted(rejected.items())
    ]


DASHBOARD_FIX = Manual(
    "follow step 6 of references/cloudflare-sst.md, or allow the refresh_tokens grant on the saas Access application, "
    "then restart the dashboard service"
)


def check_dashboard(root: Path, hermes: str) -> list:
    where = str(root)

    def drift(detail: str) -> Drift:
        return Drift("dashboard sign-in", where, detail, DASHBOARD_FIX)

    proc = subprocess.run(
        [hermes, "config", "get", "dashboard", "--json"],
        env={**os.environ, "HERMES_HOME": str(root)}, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return [drift(f"hermes config get dashboard failed: {proc.stderr.strip()}")]
    try:
        dashboard = json.loads(proc.stdout)
    except ValueError:
        return [drift("hermes config get dashboard did not return JSON")]
    self_hosted = (dashboard.get("oauth") or {}).get("self_hosted") or {}
    issuer = (self_hosted.get("issuer") or "").rstrip("/")
    drifts = []
    if not dashboard.get("public_url"):
        drifts.append(drift("dashboard.public_url is not set"))
    if not issuer:
        return [*drifts, drift("dashboard.oauth.self_hosted.issuer is not set")]
    if not self_hosted.get("client_id"):
        drifts.append(drift("dashboard.oauth.self_hosted.client_id is not set"))
    if "offline_access" not in (self_hosted.get("scopes") or DEFAULT_OIDC_SCOPES).split():
        drifts.append(drift(
            "dashboard.oauth.self_hosted.scopes does not request offline_access, so the issuer returns no refresh token",
        ))
    try:
        with urllib.request.urlopen(f"{issuer}/.well-known/openid-configuration", timeout=10) as resp:
            grants = json.load(resp).get("grant_types_supported") or []
    except (OSError, ValueError) as exc:
        return [*drifts, drift(f"cannot read the issuer's discovery document: {exc}")]
    if "refresh_tokens" not in grants and "refresh_token" not in grants:
        drifts.append(drift("the issuer does not offer the refresh_tokens grant"))
    return drifts


def config_value(home: Path, hermes: str, key: str):
    # Without --raw, Hermes masks secrets. Values are compared here and never printed.
    proc = subprocess.run(
        [hermes, "config", "get", key, "--json"], env={**os.environ, "HERMES_HOME": str(home)},
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        return json.loads(proc.stdout)
    if "Config key not set" in proc.stderr:
        return None
    raise Refusal(f"hermes config get {key} failed in {home}: {proc.stderr.strip()}")


def config_fix(homes: Homes, home: Path, entry: ConfigKey):
    if entry.want.target is UNSET:
        return install_plan.config_unset(homes, home, entry.key)
    if entry.want.target is MANUAL:
        return Manual(f"set {entry.key} as part {entry.part} describes")
    return install_plan.config_set(homes, home, entry.key, entry.want.target)


def check_config(homes: Homes, table: tuple = CONFIG) -> list:
    home_paths, hermes = {ROOT: homes.root, WORKER: homes.worker}, homes.hermes
    reads = [(entry, home) for entry in table for home in entry.homes]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        values = list(pool.map(lambda read: config_value(home_paths[read[1]], hermes, read[0].key), reads))
    drifts = []
    by_key: dict = {}
    for (entry, home), value in zip(reads, values):
        if not entry.want.ok(value):
            detail = f"is not {entry.want.text} (part {entry.part})"
            drifts.append(Drift("config", f"{entry.key} in {home_paths[home]}", detail, config_fix(homes, home_paths[home], entry)))
        by_key.setdefault(entry.key, []).append(value)
    for entry in table:
        values = by_key[entry.key]
        if entry.same_in_homes and any(value != values[0] for value in values):
            between = " and ".join(str(home_paths[home]) for home in entry.homes)
            drifts.append(Drift(
                "config", entry.key, f"differs between {between} (part {entry.part})",
                Manual(f"find which home is right with the operator and set the other as part {entry.part} describes"),
            ))
    return drifts


SLACK_OVERRIDES_KEY = "platforms.slack.channel_overrides"


def check_slack_overrides(root: Path, hermes: str) -> list:
    """Hermes silently drops a non-mapping override, so the Slack model choice would revert to model.default."""
    overrides = config_value(root, hermes, SLACK_OVERRIDES_KEY)
    if overrides is None:
        return []

    def drift(key: str, detail: str) -> list:
        return [Drift("config", f"{key} in {root}", f"is not {detail} (part 13)",
                      Manual("set the Slack channel overrides as part 13 describes"))]

    if not isinstance(overrides, dict):
        return drift(SLACK_OVERRIDES_KEY, "a mapping")
    drifts = []
    for channel, entry in overrides.items():
        key = f"{SLACK_OVERRIDES_KEY}.{channel}"
        if not isinstance(entry, dict):
            drifts += drift(key, "a mapping")
        elif "model" in entry and not (isinstance(entry["model"], str) and entry["model"].strip()):
            drifts += drift(f"{key}.model", "a non-empty model alias")
    return drifts


UPLOAD_STATUS_SECONDS = 5
BROKER_CLIENT = Path("plugins/linear-agent-session/broker_client.py")


def check_upload_broker(root: Path, token_env: str, mcp_envs: dict) -> list:
    """Ask the root home's broker for its status. Sends no upload, asks for no token, and reports no value."""
    try:
        spec = importlib.util.spec_from_file_location("broker_client", root / BROKER_CLIENT)
        client = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(client)
    except (OSError, SyntaxError, ImportError):
        return [Drift("upload broker", str(root / BROKER_CLIENT), "cannot be loaded, so the broker is not asked (part 5)", ADVISORY)]
    path = root / client.SOCKET_NAME

    def drift(detail: str) -> list:
        return [Drift("upload broker", str(path), f"{detail} (part 5)", ADVISORY)]

    try:
        status = client.status(str(path), timeout=UPLOAD_STATUS_SECONDS)
    except client.BrokerUnavailable as error:
        return drift(f"is unreachable: {error}")
    except client.BrokerError as error:
        return drift(f"did not answer a status request with ok: {error}")
    drifts = []
    if not status.token_present:
        drifts += drift("reports token_present false: the broker holds no upload token")
    if not status.linear_ready:
        drifts += drift("reports linear_ready false: the broker holds no Linear app credentials, so no worker reaches Linear")
    if not status.github_app_ready:
        drifts += drift(
            "reports github_app_ready false: the broker cannot mint the GitHub App installation token, "
            "so the worker's gh login expires within the hour"
        )
    if token_env and not status.proxy_token_present:
        drifts += drift(f"reports proxy_token_present false: the broker holds no {token_env}, so no worker reaches the proxy")
    for server, name in sorted(mcp_envs.items()):
        if not status.mcp_tokens_present.get(server):
            drifts += drift(f"holds no token for the {server} MCP server: the broker holds no {name}, so every worker run is refused")
    return drifts


GATEWAY_ONLY = {
    "LINEAR_CLIENT_ID": 8, "LINEAR_CLIENT_SECRET": 8,
    "FACTORY_INFISICAL_CLIENT_ID": 14, "FACTORY_INFISICAL_CLIENT_SECRET": 14,
}
SECRET_NAMES = "plugins/factory-secret-names/plugin.yaml"
DECLARED_NAME = re.compile(r"^\s*-\s*name:\s*([A-Za-z_][A-Za-z0-9_]*)\s*$", re.MULTILINE)


def check_worker_secrets(commit: Commit, worker: Path, hermes: str, settings) -> list:
    token_env, mcp_envs = factory_settings.token_variables(settings)
    live = config_value(worker, hermes, "secrets.command")
    enabled = isinstance(live, dict) and live.get("enabled") is True
    helper = f"python3 {worker}/scripts/worker-secrets"
    where = f"secrets.command in {worker}"
    drifts = []
    # The live command is never printed, since a tuned command could embed a secret.
    if token_env and not (enabled and live.get("command") == helper):
        drifts.append(Drift("config", where, f"is not the worker helper {helper} (part 5)", Manual("set the worker's secrets.command as part 5 describes")))
    elif not token_env and enabled:
        drifts.append(Drift(
            "config", where, "is set, but a worker without a proxy token loads no secret (part 5)",
            Manual("turn off the worker's secrets.command as part 5 describes"),
        ))
    held = {**GATEWAY_ONLY, **{name: 3 for name in (token_env, *mcp_envs.values()) if name}}
    for name, part in held.items():
        if env_has(worker, name):
            drifts.append(Drift(
                "secret", f"{name} in {worker}/.env", f"is set, but the worker holds no factory secret; remove it (part {part})",
                Manual("follow Retire the worker's identity in references/infisical.md"),
            ))
    files = commit.files(SECRET_NAMES)
    declared = set(DECLARED_NAME.findall(commit.blob(files[SECRET_NAMES]).decode())) if SECRET_NAMES in files else set()
    keys = [("auth_token_env", token_env), *((f"mcp_servers.{server}.token_env", name) for server, name in sorted(mcp_envs.items()))]
    for key, name in keys:
        if name and name not in declared:
            drifts.append(Drift(
                "config", f"claude_session.{key} in {worker}",
                f"names {name}, which {SECRET_NAMES} does not declare, so every process a home starts inherits it (part 3)",
                Manual(f"declare {name} in {SECRET_NAMES} or name a declared variable"),
            ))
    return drifts


def cron_jobs(home: Path) -> list:
    store = home / "cron" / "jobs.json"
    return json.loads(store.read_text())["jobs"] if store.is_file() else []


def cron_differences(job: CronJob, live: dict) -> list:
    job_id = live["id"]
    details = []
    if not live["enabled"]:
        details.append(("is disabled", ("resume", job_id)))
    schedule = live["schedule"]
    if schedule.get("kind") != "interval" or schedule.get("minutes") != job.minutes:
        details.append((
            f"runs {live['schedule_display']}, not every {job.minutes}m",
            ("edit", job_id, "--schedule", install_plan.schedule(job.minutes)),
        ))
    if live["script"] != job.runs or not live["no_agent"]:
        details.append((f"is not a script-only job that runs {job.runs}", ("edit", job_id, "--no-agent", "--script", job.runs)))
    if not job.deliver.ok(live["deliver"]):
        target = job.deliver.target
        details.append((
            f"delivers to {json.dumps(live['deliver'])}, not {job.deliver.text}",
            None if target is MANUAL else ("edit", job_id, "--deliver", target),
        ))
    return details


def env_file(home: Path) -> dict:
    """The non-empty variables `<home>/.env` sets. Callers never print a value."""
    path = home / ".env"
    values = {}
    for line in path.read_text().splitlines() if path.is_file() else ():
        key, sep, value = line.strip().removeprefix("export ").partition("=")
        if sep and value.strip().strip("'\""):
            values[key.strip()] = value.strip().strip("'\"")
    return values


def env_has(home: Path, name: str) -> bool:
    return name in env_file(home)


def known_secrets(homes) -> list:
    """Every value the homes' .env files set and every secret-named variable this process holds, longest first."""
    values = {value for home in homes for value in env_file(home).values()}
    values |= {value for name, value in os.environ.items() if SECRET_NAME.search(name)}
    return sorted((value for value in values if len(value) >= 8), key=len, reverse=True)


def redact(text: str, secrets: list) -> str:
    for value in secrets:
        text = text.replace(value, "[redacted]")
    # A credential the process never held, such as a minted token, is masked by its shape.
    return TOKEN_SHAPED.sub(
        lambda m: "[redacted]" if re.search(r"\d", m[0]) and re.search(r"[A-Za-z]", m[0]) else m[0], text
    )


def error_summary(error: str) -> str:
    """The error's first line, joined to the first output line when Hermes heads the script's output with
    `stderr:` or `stdout:` under its `Script exited with code N` line."""
    lines = [line.strip() for line in error.splitlines() if line.strip()]
    if len(lines) > 2 and lines[1] in ("stderr:", "stdout:"):
        return f"{lines[0]}: {lines[2]}"
    return lines[0] if lines else ""


def last_run_failure(job: CronJob, live: dict, secrets: list) -> list:
    status = live.get("last_status")
    if status in HEALTHY_RUNS:
        return []
    if status == "delivery_failed":
        what, error = "last run's output was not delivered", live.get("last_delivery_error")
    else:
        what, error = "last run failed", live.get("last_error")
    # Redacted before it is clipped, so a clip never leaves part of a secret unmasked.
    summary = redact(error_summary(error or "") or str(status), secrets)
    if len(summary) > RUN_ERROR_LIMIT:
        summary = summary[:RUN_ERROR_LIMIT - 3] + "..."
    return [f"{what}: {summary}"]


def unresolved_deliveries(home: Path, live: dict, hermes: str) -> list:
    """Name each platform the job delivers to that has no home channel in the profile that owns the job.

    Hermes resolves a bare platform name through that platform's home channel in the owning profile and drops the
    output when it has none, which the scheduler logs as "no delivery target resolved".
    """
    details = []
    for target in str(live["deliver"]).split(","):
        platform = target.strip().lower()
        if not platform or ":" in platform or platform in NON_PLATFORM_TARGETS or platform.startswith("bot-chat"):
            continue
        if env_has(home, f"{platform.upper()}_HOME_CHANNEL"):
            continue
        if config_value(home, hermes, f"platforms.{platform}.home_channel"):
            continue
        details.append(f"delivers to {platform}, which has no home channel in {home}, so Hermes drops its output")
    return details


def check_root_wrappers(commit: Commit, homes: Homes) -> list:
    root = homes.root
    drifts = []
    for name in ROOT_WRAPPERS:
        source = f"skills/setup-factory/scripts/{name}"
        if source not in commit.files(source):
            continue
        installed = root / "scripts" / name
        where = str(installed)
        fix = install_plan.wrapper_install(homes, name)
        if not installed.is_file():
            drifts.append(Drift("script", where, f"is missing; install it from {source} (part 12)", fix))
        elif installed.read_bytes() != commit.blob(commit.files(source)[source]):
            drifts.append(Drift("script", where, f"differs from {commit.label} at {commit.short} (part 12)", fix))
    return drifts


def check_cron(commit: Commit, homes: Homes) -> list:
    hermes = homes.hermes
    paths = {ROOT: homes.root, WORKER: homes.worker}
    live_jobs = {name: cron_jobs(home) for name, home in paths.items()}
    drifts = check_root_wrappers(commit, homes)
    secrets = known_secrets(paths.values())
    for job in CRON:
        home = paths[job.home]
        where = f"{job.name} in {home}"
        operator_platform = Manual(f"set {job.name}'s delivery to the operator's chat platform as part {job.part} describes")

        def drift(detail: str, remedy) -> Drift:
            return Drift("cron job", where, f"{detail} (part {job.part})", remedy)

        found = [live for live in live_jobs[job.home] if live["name"] == job.name]
        if not found:
            target = job.deliver.target
            drifts.append(drift("is missing", operator_platform if target is MANUAL else install_plan.cron_command(
                homes, home, "create", install_plan.schedule(job.minutes), "--name", job.name, "--no-agent",
                "--script", job.runs, "--deliver", target,
            )))
        elif len(found) > 1:
            drifts.append(drift(
                f"exists {len(found)} times", Manual(f"remove all but one {job.name} job with hermes cron remove <job id>")
            ))
        for live in found:
            drifts.extend(
                drift(d, operator_platform if args is None else install_plan.cron_command(homes, home, *args))
                for d, args in cron_differences(job, live)
            )
            drifts.extend(
                drift(d, Manual(f"set the platform's home channel in {home} as part {job.part} describes"))
                for d in unresolved_deliveries(home, live, hermes)
            )
            drifts.extend(drift(d, ADVISORY) for d in last_run_failure(job, live, secrets))
    owners = {job.name: job for job in CRON}
    for name, jobs in live_jobs.items():
        for live in jobs:
            where = f"{live['name']} in {paths[name]}"
            owner = owners.get(live["name"])
            if live["name"] in LAUNCHD_JOBS:
                remove = " ".join(install_plan.cron_command(homes, paths[name], "remove", live["id"]).argv)
                drifts.append(Drift(
                    "cron job", where, "is replaced by a launchd job; remove it with hermes cron remove (part 10)",
                    Manual(f"once the part 10 launchd job has run, run {remove}"),
                ))
            elif owner is None:
                drifts.append(Drift(
                    "cron job", where, "is not a job the setup runbook creates",
                    Manual("remove it with hermes cron remove <job id> once the operator agrees"),
                ))
            elif owner.home != name:
                drifts.append(Drift(
                    "cron job", where, f"belongs to the {owner.home} profile (part {owner.part})",
                    install_plan.cron_command(homes, paths[name], "remove", live["id"]),
                ))
    return drifts


def launchd_state(launchctl: str, domains: tuple, label: str) -> str | None:
    for domain in domains:
        # The full output lists the program arguments, which can hold a token; only the state is read.
        proc = subprocess.run([launchctl, "print", f"{domain}/{label}"], capture_output=True, text=True)
        state = re.search(r"^\s*state = (\S+)", proc.stdout, re.MULTILINE)
        if proc.returncode == 0 and state:
            return state.group(1)
    return None


def hermes_lock_drifts(service: Service, plist: dict) -> list:
    """Reads only --root and --lock from the arguments, because ProgramArguments can hold a token."""
    args = [str(a) for a in plist.get("ProgramArguments", [])]

    def value(flag: str) -> str | None:
        for i, arg in enumerate(args):
            if arg.startswith(flag + "="):
                return arg[len(flag) + 1:]
            if arg == flag and i + 1 < len(args):
                return args[i + 1]
        return None

    lock = value("--lock")
    if lock is None:
        return []
    # watch-gateway's own default root, so a missing --root names the same directory.
    root = value("--root") or os.environ.get("HERMES_HOME") or str(Path.home() / ".hermes")
    if Path(lock).resolve() != (Path(root) / HERMES_GATEWAY_LOCK).resolve():
        return []
    return [Drift(
        "service", service.name,
        f"its --lock is Hermes' own {lock}, which the running gateway always holds; "
        f"name a factory-owned file or drop --lock (part {service.part})",
        service_fix(service),
    )]


def service_fix(service: Service) -> Manual:
    return Manual(f"print, install, and load the launchd job as part {service.part} describes", service.gates_runs)


def check_gh_login(launchd_root: Path, worker: Path, now: float) -> list:
    """The saved expiry claude-session reads. Not a run-gating line: a stale file clears when the job next runs."""
    service = next(s for s in SERVICES if s.name == "gh login refresh")
    if len(glob.glob(str(launchd_root / os.path.expanduser(service.plist).lstrip("/")))) != 1:
        return []
    config_dir = worker / "gh"
    try:
        left = gh_login.seconds_left(config_dir, now)
    except ValueError as error:
        detail = f"{error}; refresh-gh-app-login has not saved an expiry"
    else:
        if left >= gh_login.MIN_REMAINING_SECONDS:
            return []
        detail = f"expires in {max(left, 0) // 60:.0f} minutes, under the {gh_login.MIN_REMAINING_SECONDS // 60} a run needs"
    return [Drift(
        "gh login", str(config_dir), f"{detail} (part {service.part})",
        Manual("wait for the refresh-gh-app-login job, or run it once as part 10 describes"),
    )]


def check_services(launchd_root: Path, launchctl: str) -> list:
    drifts = []
    for service in SERVICES:
        fix = service_fix(service)
        pattern = str(launchd_root / os.path.expanduser(service.plist).lstrip("/"))
        plists = sorted(glob.glob(pattern))
        if len(plists) != 1:
            found = "no plist matches" if not plists else f"{len(plists)} plists match"
            drifts.append(Drift("service", service.name, f"{found} {service.plist} (part {service.part})", fix))
            continue
        try:
            with open(plists[0], "rb") as handle:
                plist = plistlib.load(handle)
        except (OSError, plistlib.InvalidFileException) as exc:
            drifts.append(Drift("service", service.name, f"cannot read {plists[0]}: {exc.__class__.__name__}", fix))
            continue
        # The plist's ProgramArguments can hold a token, so only Label, RunAtLoad, StartInterval, and the names of
        # EnvironmentVariables are read here; hermes_lock_drifts reads --root and --lock and nothing else.
        if plist.get("RunAtLoad") is not True:
            drifts.append(Drift("service", service.name, f"does not run at load (part {service.part})", fix))
        if service.interval and plist.get("StartInterval") != service.interval:
            drifts.append(Drift("service", service.name, f"does not run every {service.interval} seconds (part {service.part})", fix))
        variables = plist.get("EnvironmentVariables")
        unset = [name for name in service.env if not isinstance(variables, dict) or not variables.get(name)]
        if unset:
            drifts.append(Drift("service", service.name, f"does not set {', '.join(unset)} (part {service.part})", fix))
        drifts.extend(hermes_lock_drifts(service, plist))
        state = launchd_state(launchctl, service.domains(), plist["Label"])
        if state is None:
            drifts.append(Drift("service", service.name, f"is not loaded in launchd (part {service.part})", fix))
        elif state != "running" and not service.scheduled:
            drifts.append(Drift("service", service.name, f"is {state}, not running (part {service.part})", fix))
    return drifts


HEARTBEAT_FIX = Manual("ask the operator to store the heartbeat URL, mode 600, as part 12's checkpoint describes")


def check_gateway_watch(root: Path, now: float | None = None) -> list:
    """Read watch-gateway's state file and the heartbeat file's mode. Prints no URL and no value."""
    now = time.time() if now is None else now
    state_path, beat_path = root / WATCH_STATE, root / HEARTBEAT_FILE
    drifts = []
    try:
        state = json.loads(state_path.read_text())
        checked = float(state["checked_at"])
    except (OSError, ValueError, KeyError, TypeError):
        drifts.append(Drift(
            "gateway watch", str(state_path), "is missing or unreadable, so watch-gateway has not run (part 12)", ADVISORY
        ))
    else:
        if now - checked > 3 * WATCH_INTERVAL:
            drifts.append(Drift(
                "gateway watch", str(state_path),
                f"was last written {int((now - checked) // 60)} minutes ago, but watch-gateway runs every "
                f"{WATCH_INTERVAL // 60} (part 12)",
                ADVISORY,
            ))
        restarts = [t for t in state.get("restarts", []) if isinstance(t, (int, float)) and now - t < 3600]
        if state.get("state") == "unresolved" and len(restarts) >= RESTARTS_PER_HOUR:
            drifts.append(Drift(
                "gateway watch", str(state_path),
                f"restarted the gateway {len(restarts)} times in the last hour and its secrets stay unresolved: "
                "read the factory-secrets log (part 14)",
                ADVISORY,
            ))
    try:
        mode = beat_path.stat().st_mode & 0o777
    except OSError:
        drifts.append(Drift(
            "gateway watch", str(beat_path),
            "is missing, so nothing alerts a person when the gateway, Slack, or the machine is down (part 12)",
            HEARTBEAT_FIX,
        ))
    else:
        if mode & 0o077:
            drifts.append(Drift("gateway watch", str(beat_path), f"has mode {mode:03o}; it holds a URL, so use 600 (part 12)", HEARTBEAT_FIX))
    return drifts


AUTO_DEPLOY_STATE = "auto-deploy.json"
AUTO_DEPLOY_LOCK = "auto-deploy.lock"
FACTORY_GATEWAY_LOCK = "factory-gateway.lock"
HOLD_KEY = "kanban.dispatch_profiles"
UNDEPLOYED_SECONDS = 24 * 3600
START_DEPLOY = Manual(
    "start auto-deploy once with launchctl kickstart gui/$(id -u)/ai.patinaproject.factory.auto-deploy "
    "(user/$(id -u) over SSH), which releases what a dead run engaged, as Deploy a merged factory change describes"
)


def read_pid(path: Path) -> int | None:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def live_deploy(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    proc = subprocess.run(["/bin/ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
    return proc.returncode == 0 and "auto-deploy" in proc.stdout


def auto_deploy_state(root: Path) -> dict | None:
    try:
        state = json.loads((root / AUTO_DEPLOY_STATE).read_text())
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) else None


def hold_engaged(root: Path) -> bool:
    state = auto_deploy_state(root)
    return bool(state and state.get("hold"))


def check_auto_deploy(
    root: Path, dispatch_profiles, commit: Commit | None, committed_at: float | None, now: float,
    alive: Callable[[object], bool] = live_deploy,
) -> list:
    state_path, run_lock, gateway_lock = root / AUTO_DEPLOY_STATE, root / AUTO_DEPLOY_LOCK, root / FACTORY_GATEWAY_LOCK
    holder = read_pid(run_lock)
    if alive(holder):
        return []
    drifts = []
    if run_lock.exists():
        drifts.append(Drift(
            "auto deploy", str(run_lock), f"names pid {holder}, which is not a running auto-deploy; the next run reclaims it",
            ADVISORY,
        ))
    if not state_path.exists():
        return [*drifts, Drift("auto deploy", str(state_path), "is missing, so auto-deploy has never run (part 12)", START_DEPLOY)]
    state = auto_deploy_state(root)
    if state is None:
        return [*drifts, Drift(
            "auto deploy", str(state_path), "is unreadable, so every auto-deploy run stops before it deploys",
            Manual("move the state file aside and start auto-deploy once, as Deploy a merged factory change describes"),
        )]
    hold = state.get("hold") if isinstance(state.get("hold"), dict) else {}
    pid = hold.get("pid")
    if hold and alive(pid):
        return drifts
    if hold.get("dispatch_profiles"):
        drifts.append(Drift(
            "auto deploy", f"{HOLD_KEY} in {root}",
            f"was set by auto-deploy run {pid}, which is not running, so Hermes claims no card", START_DEPLOY,
        ))
    elif dispatch_profiles is not None:
        drifts.append(Drift(
            "auto deploy", f"{HOLD_KEY} in {root}",
            "is set, and no auto-deploy run set it, so Hermes claims no card for a profile outside it and auto-deploy "
            "deploys nothing",
            Manual(f"ask whoever set it whether the hold is still wanted, and if not run hermes config unset {HOLD_KEY} in the root home"),
        ))
    if hold.get("pause"):
        drifts.append(Drift(
            "auto deploy", str(state_path),
            f"records a hermes pause of auto-deploy run {pid}, which is not running, so no turn may run", START_DEPLOY,
        ))
    if hold.get("gateway_lock") and read_pid(gateway_lock) == pid:
        drifts.append(Drift(
            "auto deploy", str(gateway_lock),
            f"holds auto-deploy run {pid}, which is not running, so watch-gateway restarts nothing", START_DEPLOY,
        ))
    pending = state.get("restart_pending")
    if pending:
        drifts.append(Drift(
            "auto deploy", str(state_path),
            f"records a gateway restart for {str(pending)[:12]} that has not succeeded, so the gateway may still run "
            "the plugins and config from before it",
            Manual("run auto-deploy --retry, which restarts the gateway through restart-gateway, as Deploy a merged "
                   "factory change describes"),
        ))
    if commit is not None and committed_at is not None and state.get("deployed") != commit.sha and now - committed_at >= UNDEPLOYED_SECONDS:
        outcome = state.get("outcome") if state.get("attempted") == commit.sha else None
        if outcome in ("FAILED", "WAITING", "BLOCKED"):
            detail = str(state.get("detail") or "")
            if len(detail) > RUN_ERROR_LIMIT:
                detail = detail[:RUN_ERROR_LIMIT - 3] + "..."
            why = f"auto-deploy recorded {outcome}" + (f": {detail}" if detail else "")
        else:
            why = "auto-deploy recorded no outcome for it, so its push did not start a run"
        drifts.append(Drift(
            "auto deploy", f"origin/{commit.label} at {commit.short}",
            f"is not deployed {int((now - committed_at) // 3600)} hours after it was committed; {why}",
            Manual("fix what the outcome names, then run auto-deploy --retry as Deploy a merged factory change describes"),
        ))
    return drifts


BROKER_CONFIG = "Library/Application Support/factory-broker/broker.json"
BROKER_FILES = {
    "factory_uploads/__init__.py": "plugins/factory-uploads/__init__.py",
    "factory_uploads/broker.py": "plugins/factory-uploads/broker.py",
    "factory_uploads/credentials.py": "plugins/factory-uploads/credentials.py",
    "factory_uploads/github_app.py": "plugins/factory-uploads/github_app.py",
    "factory_uploads/service.py": "plugins/factory-uploads/service.py",
    "factory_uploads/upload_token.py": "plugins/factory-uploads/upload_token.py",
    "factory_uploads/secret-names.yaml": "plugins/factory-secret-names/plugin.yaml",
    "linear.py": "plugins/linear-agent-session/linear.py",
    "broker_client.py": "plugins/linear-agent-session/broker_client.py",
}
BROKER_SOCKET_LINK = "factory-uploads.sock"
BROKER_KEYS = ("user", "group", "label", "lib", "socket", "home", "allowed_uids")
NO_SHELL = "/usr/bin/false"


class Accounts(NamedTuple):
    user: Callable
    group: Callable
    me: str
    root_uid: int = 0


def live_accounts() -> Accounts:
    def lookup(table):
        def find(name):
            try:
                return table(name)
            except KeyError:
                return None
        return find

    return Accounts(lookup(pwd.getpwnam), lookup(grp.getgrnam), pwd.getpwuid(os.getuid()).pw_name)


def broker_user_config(launchd_root: Path) -> dict | None:
    path = launchd_root / BROKER_CONFIG
    if not path.exists():
        return None
    try:
        config = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise Refusal(f"cannot read {path}: {exc.__class__.__name__}") from None
    missing = [key for key in BROKER_KEYS if key not in config]
    if missing:
        raise Refusal(f"{path} lacks {', '.join(missing)}; run setup-broker-user apply")
    return config


def broker_only_names(commit: Commit) -> tuple:
    """The secrets only the broker user may hold, named once in credentials.py at the commit."""
    [blob] = commit.files("plugins/factory-uploads/credentials.py").values()
    names: dict = {}
    exec(compile(commit.blob(blob), "credentials.py", "exec"), names)
    return (names["UPLOAD_TOKEN"], *names["LINEAR_CREDENTIALS"])


BROKER_USER_FIX = Manual("ask the operator to run the step of Broker user, macOS, in part 5 that the line names, with sudo")


def check_broker_user(
    commit: Commit, launchd_root: Path, root: Path, launchctl: str, config: dict, accounts: Accounts
) -> list:
    def drift(detail: str) -> Drift:
        return Drift("broker user", config["user"], f"{detail} (part 5)", BROKER_USER_FIX)

    def local(path: str) -> Path:
        return launchd_root / path.lstrip("/")

    drifts = []
    user, group = accounts.user(config["user"]), accounts.group(config["group"])
    if user is None:
        drifts.append(drift("does not exist; run setup-broker-user apply"))
    elif user.pw_shell != NO_SHELL:
        drifts.append(drift(f"has the shell {user.pw_shell}, not {NO_SHELL}, so a person could sign in as it"))
    if group is None:
        drifts.append(drift(f"has no group {config['group']}"))
    elif accounts.me not in group.gr_mem:
        drifts.append(drift(f"group {config['group']} lacks {accounts.me}, so no factory process reaches the socket"))
    if config.get("allowed_uids") != [os.getuid()]:
        drifts.append(drift(f"allowed_uids is {config.get('allowed_uids')}, not only {accounts.me}'s uid"))

    lib = local(config["lib"])
    plist_path = launchd_root / "Library/LaunchDaemons" / f"{config['label']}.plist"
    root_owned = [
        lib.parent, launchd_root / BROKER_CONFIG, plist_path, lib, lib / "factory_uploads",
        *(lib / name for name in BROKER_FILES),
    ]
    for path in root_owned:
        try:
            info = path.lstat()
        except FileNotFoundError:
            drifts.append(drift(f"{path} is missing"))
            continue
        if path.is_symlink() or info.st_uid != accounts.root_uid or info.st_mode & 0o022:
            drifts.append(drift(f"{path} is not root-owned and closed to other writers, so a factory process could change the broker"))
    if user is not None and group is not None:
        for path, gid, mode in ((local(config["home"]), None, 0o700), (local(config["socket"]).parent, group.gr_gid, 0o750)):
            try:
                info = path.lstat()
            except FileNotFoundError:
                drifts.append(drift(f"{path} is missing"))
                continue
            if info.st_uid != user.pw_uid or (gid is not None and info.st_gid != gid) or info.st_mode & 0o7777 != mode:
                drifts.append(drift(f"{path} is not {config['user']}'s with mode {mode:04o}"))

    blobs = {path: blob for source in BROKER_FILES.values() for path, blob in commit.files(source).items()}
    for target, source in BROKER_FILES.items():
        installed = lib / target
        if installed.is_file() and installed.read_bytes() != commit.blob(blobs[source]):
            drifts.append(drift(f"{installed} differs from {commit.label} at {commit.short}; run setup-broker-user apply"))

    try:
        with open(plist_path, "rb") as handle:
            plist = plistlib.load(handle)
    except (OSError, plistlib.InvalidFileException):
        drifts.append(drift(f"has no readable LaunchDaemon at {plist_path}"))
    else:
        if plist.get("RunAtLoad") is not True or plist.get("UserName") != config["user"]:
            drifts.append(drift(f"{plist_path} does not run at load as {config['user']}"))
        state = launchd_state(launchctl, ("system",), config["label"])
        if state != "running":
            drifts.append(drift(f"{config['label']} is {state or 'not loaded'}, not running"))

    github = config.get("github")
    if not isinstance(github, dict) or not github.get("private_key_path"):
        drifts.append(drift(
            "broker.json names no GitHub App, so the worker's gh gets no installation token; "
            "add github to the input and run setup-broker-user apply"
        ))
    elif os.access(local(github["private_key_path"]), os.R_OK):
        drifts.append(drift(
            f"{local(github['private_key_path'])} is readable by {accounts.me}, so a factory process could read the GitHub App key"
        ))

    link = root / BROKER_SOCKET_LINK
    if not link.is_symlink() or os.readlink(link) != config["socket"]:
        drifts.append(drift(f"{link} is not a link to {config['socket']}"))
    for name in broker_only_names(commit):
        if env_has(root, name):
            drifts.append(drift(f"{root}/.env holds {name}, which only the broker user may hold"))
    return drifts


def check_owned_refs(homes: Homes) -> list:
    root, fix = homes.root, install_plan.refresh_owned_refs(homes)
    drifts = []
    for name in (OWNED_REFS, TRIAGE_REFS):
        path = root / name
        if not path.is_file():
            drifts.append(Drift(
                "owned refs", str(path), "is missing; create or run the refresh-owned-refs cron job (part 12)", fix
            ))
            continue
        age = time.time() - path.stat().st_mtime
        if age > OWNED_REFS_MAX_AGE:
            drifts.append(Drift(
                "owned refs", str(path),
                f"is {int(age // 60)} minutes old; the refresh-owned-refs cron job is not running (part 12)",
                fix,
            ))
    return drifts


def check_triage_board(homes: Homes, settings) -> list:
    root, hermes = homes.root, homes.hermes
    proc = subprocess.run(
        [hermes, "kanban", "boards", "list", "--json"], env={**os.environ, "HERMES_HOME": str(root)},
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        raise Refusal(f"hermes kanban boards list failed in {root}: {proc.stderr.strip()}")
    board = next((b for b in json.loads(proc.stdout) if b.get("slug") == TRIAGE_BOARD), None)
    repositories = settings.get("repositories") if isinstance(settings, dict) else None
    default = next((r["path"] for r in repositories or [] if r.get("routing") == "default"), None)
    if board is None:
        fix = install_plan.board_create(homes, TRIAGE_BOARD, "Triage", default)
        return [Drift("kanban board", TRIAGE_BOARD, f"is missing in {root} (part 10)", fix)]
    if default and board.get("default_workdir") != default:
        return [Drift(
            "kanban board", TRIAGE_BOARD, f"default_workdir is not {default} (part 10)",
            install_plan.board_workdir(homes, TRIAGE_BOARD, default),
        )]
    return []


CAPACITY_FIX = Manual("set kanban.max_spawn, kanban.max_in_progress, and triage.max_running as part 10 describes, then restart-gateway")


def check_triage_capacity(max_spawn, max_in_progress, max_running) -> list:
    """Hermes counts `max_spawn` per board and `max_in_progress` per host, and ticks `default` first.

    Keys that are not positive integers are the CONFIG rows' to report."""
    if not all(is_limit(value) for value in (max_spawn, max_in_progress, max_running)):
        return []
    drifts = []
    if max_spawn + max_running > max_in_progress:
        drifts.append(Drift(
            "kanban capacity", "kanban.max_spawn",
            f"{max_spawn} plus triage.max_running {max_running} is more than kanban.max_in_progress "
            f"{max_in_progress}, so the default board can take every slot triage needs (part 10)",
            CAPACITY_FIX,
        ))
    if max_running > max_spawn:
        drifts.append(Drift(
            "kanban capacity", "kanban.max_spawn",
            f"triage.max_running {max_running} is more than kanban.max_spawn {max_spawn}, so triage cannot run "
            "that many cards on its own board (part 10)",
            CAPACITY_FIX,
        ))
    return drifts


def triage_max_running(settings):
    triage = settings.get("triage") if isinstance(settings, dict) else None
    return triage.get("max_running") if isinstance(triage, dict) else None


def check_stranded_triage(root: Path, now: float) -> list:
    path = root / "kanban" / "boards" / TRIAGE_BOARD / "kanban.db"
    if not path.is_file() or hold_engaged(root):
        return []
    events = ", ".join(f"'{kind}'" for kind in WAIT_EVENTS)
    sql = (
        "SELECT t.id AS id, COALESCE((SELECT MAX(e.created_at) FROM task_events e "
        f"WHERE e.task_id = t.id AND e.kind IN ({events})), t.created_at) AS since "
        "FROM tasks t WHERE t.status = 'ready' AND COALESCE(t.claim_lock, '') = '' "
        "AND TRIM(COALESCE(t.assignee, '')) != '' ORDER BY t.id"
    )
    try:
        cards = kanban_board.read(str(path), sql)
    except sqlite3.Error as error:
        return [Drift("stranded triage card check", path, f"cannot be read: {error} (part 10)", ADVISORY)]
    return [
        Drift(
            "stranded triage card", card["id"],
            f"has waited {int((now - card['since']) // 60)} minutes in ready with an assignee and no worker, "
            "so the default board is probably holding every worker slot (part 10)",
            ADVISORY,
        )
        for card in cards
        if now - card["since"] >= STRANDED_MINUTES * 60
    ]


GUARDED_FIX = Manual(
    "rewrite the card's pull request URLs as <owner>/<name>#<number> in new comments, and lift the hold with an "
    "`assigned` handoff: `hermes kanban [--board <board>] assign <task id> none`, then the same with `claude-worker`"
)


def board_databases(root: Path) -> list:
    return sorted([root / "kanban.db", *root.glob("kanban/boards/*/kanban.db")])


def check_guarded_cards(root: Path, now: float) -> list:
    """A card that Hermes' dispatcher holds in `ready` with `active_pr`, so no worker ever starts it.

    Hermes logs `respawn_guarded` each tick while a card comment from the last day holds a pull request URL and
    no handoff event came in a later second. Nothing else reports the hold, and a person's reply does not lift it."""
    sql = (
        "SELECT e.task_id AS id, e.kind AS kind, e.payload AS payload, e.created_at AS created_at FROM task_events e "
        "JOIN tasks t ON t.id = e.task_id WHERE t.status = 'ready' ORDER BY e.task_id, e.created_at, e.id"
    )
    drifts = []
    for path in board_databases(root):
        if not path.is_file():
            continue
        try:
            events = kanban_board.read(str(path), sql)
        except sqlite3.Error as error:
            drifts.append(Drift("guarded card check", path, f"cannot be read: {error}", ADVISORY))
            continue
        for task_id, since in sorted(active_pr_holds(events).items()):
            if now - since >= GUARDED_MINUTES * 60:
                drifts.append(Drift(
                    "guarded card", task_id,
                    f"has been held in ready from its worker as active_pr for {int((now - since) // 60)} minutes, "
                    "because a card comment holds a pull request URL; an `assigned` handoff lifts the hold",
                    GUARDED_FIX,
                ))
    return drifts


def active_pr_holds(events: list) -> dict:
    """Each card whose newest event is an `active_pr` guard, mapped to the start of its unbroken run of them."""
    runs = {}
    for event in events:
        if event["kind"] == "respawn_guarded" and guard_reason(event["payload"]) == "active_pr":
            runs.setdefault(event["id"], event["created_at"])
        else:
            runs.pop(event["id"], None)
    return runs


def guard_reason(payload) -> str | None:
    try:
        data = json.loads(payload or "{}")
    except ValueError:
        return None
    return data.get("reason") if isinstance(data, dict) else None


PARK_WAITING_FIX = Manual(
    "run card_transition.py --board triage park-waiting while dispatch is paused, as the deploy step in part 15 says"
)
UNPOSTED_FIX = Manual(
    "read the card's Linear agent session, and post the questions from the card's newest park reason if they are missing"
)


def check_waiting_triage(root: Path, plugin: Path) -> list:
    """A triage card waits for a reply only in `scheduled`, and its round reached Linear.

    A card blocked or parked in Hermes' `triage` status for input waits the way that looped; a card in `triage`
    for another kind is a real loop and is not reported. A `scheduled` card whose newest park has a
    `NOT_POSTED` comment after it may wait for an answer to a question nobody saw."""
    path = root / "kanban" / "boards" / TRIAGE_BOARD / "kanban.db"
    if not path.is_file():
        return []
    try:
        blocked = kanban_board.blocked_for_input(str(path))
        waiting = kanban_board.scheduled(str(path))
    except sqlite3.Error as error:
        return [Drift("waiting triage card check", path, f"cannot be read: {error} (part 15, check 27)", ADVISORY)]
    drifts = [
        Drift(
            "waiting triage card", card["id"],
            f"is {card['status']} with block kind needs_input, but a triage round waits for a reply in scheduled "
            "(part 15, check 27)",
            PARK_WAITING_FIX,
        )
        for card in blocked
    ]
    if not plugin.is_file():
        return drifts
    try:
        not_posted = blocker_order(plugin).NOT_POSTED
    except Exception as error:
        return [*drifts, Drift(
            "waiting triage card check", plugin, f"cannot load the plugin: {type(error).__name__}: {error}", ADVISORY,
        )]
    for task_id, card in sorted(waiting.items()):
        parked_at = card["events"][-1]["created_at"] if card["events"] else None
        failures = [
            comment["body"] for comment in card["comments"]
            if parked_at is not None and comment["created_at"] >= parked_at and comment["body"].startswith(not_posted)
        ]
        if failures:
            drifts.append(Drift(
                "waiting triage card", task_id,
                f"waits in scheduled, but its round may never have reached Linear: {failures[-1]} (part 15, check 27)",
                UNPOSTED_FIX,
            ))
    return drifts


def check_kanban_boards(root: Path) -> list:
    """Probe every board database for the columns `kanban_board` reads: the blocker check's, and the comments
    and events that release a triage card waiting for a reply.

    Hermes' tables are internal. A renamed column makes the blocker check fail open, so cards start out of order,
    and stops the sweep that releases a waiting card, with nothing else to say so."""
    drifts = []
    for path in board_databases(root):
        if not path.is_file():
            continue
        try:
            missing = kanban_board.missing_columns(str(path))
        except (sqlite3.Error, AttributeError) as error:
            drifts.append(Drift("kanban board database", path, f"cannot be read for blockers: {error} (part 15, check 29)", ADVISORY))
            continue
        if missing:
            drifts.append(Drift(
                "kanban board database", path,
                f"has no {', '.join(missing)}, so a card cannot wait for its blockers or a reply (part 15, check 29)",
                Manual("change kanban_board.py to Hermes' new column names in a pull request"),
            ))
    return drifts


def check_triage_playbook(repo: Path) -> list:
    # claude-session reads the playbook from the checkout's working tree, not from the compared commit.
    if (repo / factory_source.TRIAGE_PLAYBOOK).is_file():
        return []
    return [Drift(
        "triage playbook", repo,
        f"has no {factory_source.TRIAGE_PLAYBOOK}, so triage cards cannot follow the triage playbook; "
        "update the checkout to a commit that vendors it (part 10)",
        Manual("vendor the triage playbook on the default branch with pnpm skills:install"),
    )]


def check_source_checkout(commit: Commit) -> list:
    repo = commit.repo
    head = git(repo, "rev-parse", "HEAD").strip()
    if head == commit.sha:
        return []

    def is_ancestor(older: str, newer: str) -> bool:
        return subprocess.run(["git", "merge-base", "--is-ancestor", older, newer], cwd=repo).returncode == 0

    branch = subprocess.run(
        ["git", "symbolic-ref", "--short", "--quiet", "HEAD"], cwd=repo, capture_output=True, text=True
    ).stdout.strip()
    blockers = []
    if branch != commit.label:
        blockers.append(f"is on {branch or 'a detached HEAD'}, not {commit.label}")
    if git(repo, "status", "--porcelain").strip():
        blockers.append("has uncommitted changes")
    if not is_ancestor(head, commit.sha):
        ahead = is_ancestor(commit.sha, head)
        blockers.append(f"is ahead of {commit.label}" if ahead else f"has diverged from {commit.label}")
    fix = install_plan.source_reset(repo, commit.label, commit.sha)
    if blockers:
        return [Drift(
            "source checkout", str(repo),
            f"is not at {commit.label} {commit.short} and {' and '.join(blockers)}. "
            "Do not fast-forward it. Fix it by hand. Leave the worker-owned checkouts to refresh-checkouts.",
            fix,
        )]
    return [Drift(
        "source checkout", str(repo),
        f"is behind {commit.label} at {commit.short}. Fast-forward only this checkout "
        f"with git -C {repo} merge --ff-only {commit.sha}. "
        "Leave the worker-owned checkouts to refresh-checkouts.",
        fix,
    )]


def check_checkouts(settings) -> list:
    # Missing or malformed settings are check_config's to report.
    if not isinstance(settings, dict):
        return []
    drifts = []
    for repository in settings.get("repositories") or []:
        path = repository["path"]
        if not Path(path).is_dir():
            drifts.append(Drift("checkout", path, "does not exist (part 10)", Manual("clone the repository as part 10 describes")))
            continue
        head = subprocess.run(
            ["git", "-C", path, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"], capture_output=True
        )
        if head.returncode != 0:
            drifts.append(Drift(
                "checkout", path, f"origin/HEAD is not set; run git -C {path} remote set-head origin -a (part 10)",
                install_plan.origin_head(path),
            ))
    return drifts


# The work plugin skips any other directory name, since Hermes refuses it as a skill name.
WORK_SKILL_NAME = re.compile(r"^[a-zA-Z0-9_-]+$")


WORK_SKILLS_FIX = Manual("fix the work skills directory or the part 5 setting")


def check_work_skills(skills_dir, allow) -> list:
    # An unset directory is check_config's to report.
    if not skills_dir:
        return []
    root = Path(skills_dir)
    if not root.is_dir():
        return [Drift("work skills", str(root), "does not exist (part 5)", WORK_SKILLS_FIX)]
    if allow is not None and not isinstance(allow, list):
        return [Drift("work skills", "plugins.entries.work.settings.allow", "is not a list of skill names (part 5)", WORK_SKILLS_FIX)]
    names = {
        child.name for child in root.iterdir()
        if WORK_SKILL_NAME.match(child.name) and (child / "SKILL.md").is_file()
    }
    if not names:
        return [Drift("work skills", str(root), "holds no <name>/SKILL.md (part 5)", WORK_SKILLS_FIX)]
    return [
        Drift("work skills", str(root), f"lacks the allowed skill {name} (part 5)", WORK_SKILLS_FIX)
        for name in sorted(set(allow or []) - names)
    ]


SETTINGS_FIX = Manual("change the factory settings and set them in both homes as part 10 describes")


def check_model_tiers(settings, worker: Path) -> list:
    # Missing or malformed settings are check_config's to report.
    session = settings.get("claude_session") if isinstance(settings, dict) else None
    if not isinstance(session, dict) or not session.get("model"):
        return []
    tiers = session.get("tier_models")
    if isinstance(tiers, dict) and tiers.get("sonnet"):
        return []
    return [Drift(
        "model tier", f"claude_session in {worker}",
        "has a model but no tier_models.sonnet, so every subagent runs on that model (part 3)",
        SETTINGS_FIX,
    )]


def check_app_events(settings, fetch: Callable[[str], dict] = app_events.fetch_app) -> list:
    """Only the event lines; check-github-access stays the access check. auto-deploy runs this on every tick, so a
    failed lookup adds no line, which would churn report-deploy's text-keyed de-duplication."""
    login = ((settings.get("github") if isinstance(settings, dict) else None) or {}).get("login")
    if not isinstance(login, str) or not login.endswith("[bot]"):
        return []
    slug = login[: -len("[bot]")]
    try:
        app = fetch(slug)
    except app_events.AppLookupError as error:
        print(f"check-install: cannot read the event subscriptions of App {slug}: {error}", file=sys.stderr)
        return []
    return [
        Drift(
            "github app", slug, f'does not subscribe to the "{label}" event, so no merge starts auto-deploy until its next interval run',
            Manual(f'in the App\'s GitHub settings, under Permissions & events, subscribe to "{label}"'),
        )
        for label in app_events.missing_events(app)
    ]


def check_settings(settings, worker: Path) -> list:
    """Report each settings value that makes claude-session refuse a run, with the text of its refusal."""
    if not isinstance(settings, dict):
        return []
    problems = factory_settings.validate(settings)
    return [
        *(Drift("config", f"claude_session in {worker}", error, SETTINGS_FIX) for error in problems.global_errors),
        *(
            Drift("config", f"{full_name} in {worker}", error, SETTINGS_FIX)
            for full_name, found in sorted(problems.repository_errors.items()) for error in found
        ),
    ]


MCP_STATUS_SECONDS = 120


def mcp_probe(worker: Path, full_name: str) -> dict | str:
    try:
        proc = subprocess.run(
            [sys.executable, str(worker / "scripts" / "claude-session"), "--mcp-status", "--repo", full_name],
            env={**os.environ, "HERMES_HOME": str(worker)}, capture_output=True, text=True, timeout=MCP_STATUS_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return f"printed nothing within {MCP_STATUS_SECONDS} s"
    try:
        report = json.loads(proc.stdout)
    except ValueError:
        return f"exited {proc.returncode} without a report"
    if not isinstance(report, dict):
        return f"exited {proc.returncode} without a report"
    return report if proc.returncode == 0 else str(report.get("error"))


def check_mcp_servers(settings, worker: Path) -> list:
    if not isinstance(settings, dict) or not (worker / "scripts" / "claude-session").is_file():
        return []
    if factory_settings.validate(settings).global_errors:
        return []
    drifts = []
    repositories = [r for r in settings.get("repositories") or [] if Path(r["path"]).is_dir()]
    # One at a time: each probe rewrites Claude Code's global config to trust its checkout.
    reports = [mcp_probe(worker, r["full_name"]) for r in repositories]
    for repository, report in zip(repositories, reports):
        full_name = repository["full_name"]
        if isinstance(report, str):
            drifts.append(Drift("mcp", full_name, f"cannot read the MCP server status: {report} (part 10)", ADVISORY))
            continue
        drifts.extend(
            Drift("mcp", f"{server['name']} in {full_name}", f"is {server['status']}, not connected or disabled (part 10)", ADVISORY)
            for server in report["servers"]
            if server["status"] != "connected" and server["name"] not in report["disabled"]
        )
    return drifts


ROOT_MCP_SECONDS = 120
HEADER_REFERENCE = re.compile(r"(?:[A-Za-z][A-Za-z0-9-]* )?\$\{[A-Za-z_][A-Za-z0-9_]*\}")


def root_mcp_connects(root: Path, hermes: str, server: str) -> bool:
    try:
        proc = subprocess.run(
            [hermes, "mcp", "test", server], env={**os.environ, "HERMES_HOME": str(root)},
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=ROOT_MCP_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return False
    return proc.returncode == 0


READ_MCP_SERVERS = (
    "import json, sys\n"
    "sys.path.insert(0, sys.argv[1])\n"
    "try:\n"
    "    from ruamel.yaml import YAML\n"
    "    cfg = YAML(typ='safe', pure=True).load(open(sys.argv[2])) or {}\n"
    "except Exception as error:\n"
    "    sys.exit(type(error).__name__)\n"
    "if not isinstance(cfg, dict):\n"
    "    sys.exit('config.yaml is not a mapping')\n"
    "print(json.dumps(cfg.get('mcp_servers')))\n"
)


def root_mcp_servers(root: Path):
    """The root home's mcp_servers as config.yaml writes it, with no ${VAR} expansion.

    `hermes config get` expands every ${VAR} to its value, so it cannot show whether a header holds a
    reference or a literal. Parses the file with the Hermes environment's ruamel.yaml, which has no PyYAML.
    A parse error names only its class, because ruamel quotes the offending line, which can hold a token.
    A missing file is check_config's to report. Raises Refusal on a failure.
    """
    config = root / "config.yaml"
    if not config.is_file():
        return None
    python, site = hermes_python(root)
    try:
        proc = subprocess.run(
            [str(python), "-I", "-B", "-c", READ_MCP_SERVERS, str(site), str(config)],
            env={"PATH": os.environ.get("PATH", "")}, capture_output=True, text=True, timeout=HERMES_TOOLS_SECONDS,
        )
    except subprocess.TimeoutExpired:
        raise Refusal("cannot read config.yaml: timed out") from None
    if proc.returncode != 0:
        lines = [line.strip() for line in proc.stderr.splitlines() if line.strip()]
        raise Refusal(f"cannot read config.yaml: {lines[-1] if lines else proc.returncode}")
    return json.loads(proc.stdout)


def check_root_mcp_servers(root: Path, hermes: str) -> list:
    """Report each enabled root-home MCP server that does not connect, samples, or holds a literal header.

    Reads mcp_servers from the root home's config.yaml without env expansion, so a ${VAR} reference stays
    a reference and no secret enters this process. Prints a server and header name, never a header value.
    A config it cannot read or a shape Hermes would not load is one drift, so the other checks still report.
    """
    try:
        return root_mcp_drifts(root, hermes)
    except Refusal as error:
        return [Drift("root mcp", str(root), f"cannot check: {error} (part 10)", ADVISORY)]


ROOT_MCP_FIX = Manual("change the server in the root home's mcp_servers as references/mcp-identities.md describes")


def root_mcp_drifts(root: Path, hermes: str) -> list:
    servers = root_mcp_servers(root)
    if servers is None:
        return []
    if not isinstance(servers, dict):
        raise Refusal("mcp_servers is not a mapping")
    drifts = []
    for name, server in servers.items():
        where = f"{name} in {root}"
        if not isinstance(server, dict):
            raise Refusal(f"mcp_servers.{name} is not a mapping")
        if server.get("enabled") is False:
            continue
        sampling = server.get("sampling")
        if sampling is not None and not isinstance(sampling, dict):
            raise Refusal(f"mcp_servers.{name}.sampling is not a mapping")
        headers = server.get("headers") or {}
        if not isinstance(headers, dict):
            raise Refusal(f"mcp_servers.{name}.headers is not a mapping")
        for header, value in headers.items():
            if not isinstance(value, str):
                raise Refusal(f"mcp_servers.{name}.headers.{header} is not a string")
            if not HEADER_REFERENCE.fullmatch(value):
                drifts.append(Drift(
                    "root mcp", where, f"header {header} holds a literal value, not a ${{VAR}} reference (part 10)", ROOT_MCP_FIX
                ))
        if (sampling or {}).get("enabled") is not False:
            drifts.append(Drift("root mcp", where, "does not set sampling.enabled to false (part 10)", ROOT_MCP_FIX))
        if not root_mcp_connects(root, hermes, name):
            drifts.append(Drift("root mcp", where, f"does not connect: run hermes mcp test {name} (part 10)", ADVISORY))
    return drifts


HERMES_TOOLS_SECONDS = 60
HERMES_TOOL_NAMES = Path(__file__).resolve().parent / "hermes-tool-names"
IMPORT_PLUGINS = Path(__file__).resolve().parent / "import-plugins"
BLOCKER_ORDER = "plugins/blocker-order/__init__.py"


def hermes_python(root: Path) -> tuple:
    """The store Python and the selected environment's site-packages directory. Raises Refusal when absent."""
    python_facts = root / "tools" / "facts.json"
    if not python_facts.is_file():
        raise Refusal(f"no Hermes Python in {python_facts}")
    entry = (json_file(python_facts).get("packages", {}).get("python") or {}).get("entry")
    python = root / "tools" / str(entry) / "bin" / "python3"
    if not entry or not python.is_file():
        raise Refusal(f"no Hermes Python in {python_facts}")
    environments = [
        (json_file(facts).get("packages", {}).get("venv") or {}).get("environment")
        for facts in sorted((root / "installs").glob("*/facts.json"))
    ]
    site = [path for env in environments if env for path in sorted(Path(env).glob("lib/python*/site-packages"))]
    if len(site) != 1:
        raise Refusal(f"no Hermes environment: {len(site)} selected under {root / 'installs'}")
    return python, site[0]


def run_in_hermes(root: Path, script: Path, *args: str):
    """The JSON that `script` prints when run with the installed Hermes importable, read without writing to Hermes.

    Runs the store Python on the checkout and the selected environment's site-packages directly, never
    through the `hermes` launcher, which leases and can rebuild environments. HERMES_HOME is a scratch
    directory and bytecode is off. Raises Refusal with the reason when it cannot answer.
    """
    python, site = hermes_python(root)
    checkout = Path(os.environ.get("HERMES_AGENT_DIR") or root / "hermes-agent")
    if not (checkout / "tools" / "registry.py").is_file():
        raise Refusal(f"no Hermes checkout at {checkout}")
    with tempfile.TemporaryDirectory() as scratch:
        try:
            proc = subprocess.run(
                [str(python), "-I", "-B", str(script), str(checkout), str(site), *args],
                env={"PATH": os.environ.get("PATH", ""), "HERMES_HOME": os.path.join(scratch, "home"), "PYTHONDONTWRITEBYTECODE": "1"},
                cwd=scratch, capture_output=True, text=True, timeout=HERMES_TOOLS_SECONDS,
            )
        except subprocess.TimeoutExpired:
            raise Refusal(f"printed nothing within {HERMES_TOOLS_SECONDS} s") from None
    if proc.returncode != 0:
        lines = [line.strip() for line in proc.stderr.splitlines() if line.strip()]
        raise Refusal(lines[-1] if lines else f"exited {proc.returncode}")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise Refusal(f"exited {proc.returncode} without JSON") from None


def hermes_tool_names(root: Path) -> list:
    names = run_in_hermes(root, HERMES_TOOL_NAMES)
    if not isinstance(names, list):
        raise Refusal("exited 0 without a list of names")
    return names


def json_file(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None
    return data if isinstance(data, dict) else {}


def blocker_order(plugin: Path):
    spec = importlib.util.spec_from_file_location(
        "blocker_order_installed", plugin, submodule_search_locations=[str(plugin.parent)]
    )
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    sys.dont_write_bytecode = True
    spec.loader.exec_module(module)
    return module


def watched_tools(plugin: Path) -> tuple:
    module = blocker_order(plugin)
    return module.PROCESS_TOOLS, module.REQUIRED_TOOLS


HERMES_TOOL_FIX = Manual("change the blocker-order plugin to Hermes' new tool names in a pull request")


def check_hermes_tools(root: Path, plugin: Path) -> list:
    """Alert when Hermes no longer registers a tool the installed blocker-order plugin watches or calls."""
    if not plugin.is_file():
        return []
    try:
        process_tools, required = watched_tools(plugin)
        registered = hermes_tool_names(root)
    except Refusal as error:
        return [Drift("hermes tool", "blocker-order", f"cannot read Hermes' tool names: {error}", ADVISORY)]
    except Exception as error:
        return [Drift("hermes tool", "blocker-order", f"cannot read Hermes' tool names: {type(error).__name__}: {error}", ADVISORY)]
    have = f"its terminal and kanban toolsets register {', '.join(registered) or 'nothing'}"
    drifts = []
    if not set(process_tools) & set(registered):
        drifts.append(Drift(
            "hermes tool", "blocker-order",
            f"Hermes registers none of {', '.join(process_tools)}, which the plugin watches; {have} (PROCESS_TOOLS in {BLOCKER_ORDER})",
            HERMES_TOOL_FIX,
        ))
    for name in required:
        if name not in registered:
            drifts.append(Drift(
                "hermes tool", "blocker-order",
                f"Hermes registers no {name}, which the plugin needs; {have} (REQUIRED_TOOLS in {BLOCKER_ORDER})",
                HERMES_TOOL_FIX,
            ))
    return drifts


def installed_plugins(commit: Commit, homes: list) -> list:
    """The (home, name) pairs of repository plugins installed where check_plugins wants them."""
    names = sorted({path.split("/")[1] for path in commit.files("plugins")})
    return [
        (home, name) for name in names for home in (homes[:1] if name in ROOT_ONLY_PLUGINS else homes)
        if (home / "plugins" / name).is_dir()
    ]


def plugin_statuses(home: Path, hermes: str) -> dict:
    """Plugin name to Hermes' status ("enabled", "disabled", "not enabled") in `home`. Imports no plugin."""
    proc = subprocess.run(
        [hermes, "plugins", "list", "--user", "--json"], env={**os.environ, "HERMES_HOME": str(home)},
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        raise Refusal(proc.stderr.strip() or f"exited {proc.returncode}")
    try:
        return {entry["name"]: entry["status"] for entry in json.loads(proc.stdout)}
    except (ValueError, TypeError, KeyError):
        raise Refusal("did not print a JSON list of plugins with a name and status") from None


def check_plugin_status(commit: Commit, homes: Homes) -> list:
    """Alert when a repository plugin is installed in a home but Hermes does not enable it there."""
    drifts, hermes = [], homes.hermes
    pairs = installed_plugins(commit, [homes.root, homes.worker])
    for home in sorted({home for home, _ in pairs}):
        try:
            statuses = plugin_statuses(home, hermes)
        except Refusal as error:
            drifts.append(Drift("plugin status", str(home), f"cannot run hermes plugins list: {error}", ADVISORY))
            continue
        for name in (name for h, name in pairs if h == home):
            status = statuses.get(name)
            if status != "enabled":
                shown = f"is {status}" if status else "is not in the list"
                drifts.append(Drift(
                    "plugin status", f"{name} in {home}", f"{shown} in hermes plugins list, so its hooks do not run",
                    install_plan.plugin_enable(homes, home, name) if status else install_plan.plugin_install(homes, home, name, reinstall=True),
                ))
    return drifts


def check_plugin_imports(commit: Commit, homes: list, root: Path) -> list:
    """Alert when an installed repository plugin fails to import, which Hermes only logs."""
    drifts = []
    pairs = installed_plugins(commit, homes)
    for home in sorted({home for home, _ in pairs}):
        names = [name for h, name in pairs if h == home and (home / "plugins" / name / "__init__.py").is_file()]
        try:
            errors = run_in_hermes(root, IMPORT_PLUGINS, *(str(home / "plugins" / name) for name in names))
            if not isinstance(errors, dict):
                raise Refusal("exited 0 without a JSON object")
        except Refusal as error:
            drifts.append(Drift("plugin import", str(home), f"cannot import the plugins: {error}", ADVISORY))
            continue
        drifts.extend(
            Drift("plugin import", f"{name} in {home}", f"fails to import: {error}", Manual("fix the plugin's import error in a pull request"))
            for name, error in sorted(errors.items()) if error
        )
    return drifts


def homes() -> tuple:
    if not os.environ.get("HERMES_HOME"):
        raise Refusal("HERMES_HOME is not set; point it at the claude-worker profile home")
    worker = Path(os.environ["HERMES_HOME"]).resolve()
    if worker.parent.name != "profiles":
        raise Refusal(f"HERMES_HOME {worker} is not a profile home under <root>/profiles/")
    return worker.parent.parent, worker


def default_repo(worker: Path) -> Path:
    try:
        return factory_source.checkout(worker)
    except factory_source.SourceError as error:
        raise Refusal(f"{error}; pass --repo") from None


def resolve_commit(repo: Path, ref: str | None) -> Commit:
    if ref is None:
        label = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").strip().split("/", 1)[1]
        ref = "origin/HEAD"
    else:
        label = ref
    sha = git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}").strip()
    return Commit(repo, sha, label)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo", type=Path, help="factory checkout; defaults to the worker's distribution source")
    parser.add_argument("--ref", help="commit to compare against; defaults to origin/HEAD")
    parser.add_argument("--print-source", action="store_true", help="print the source checkout path and exit")
    parser.add_argument("--no-fetch", action="store_true", help="compare without running git fetch origin first")
    parser.add_argument("--json", action="store_true", help="print the drift records, each with its remedy, as one JSON list")
    args = parser.parse_args()
    try:
        root, worker = homes()
        repo = args.repo or default_repo(worker)
        if args.print_source:
            print(repo)
            return 0
        if not args.no_fetch:
            git(repo, "fetch", "--quiet", "origin")
        commit = resolve_commit(repo, args.ref)
        hermes = find_hermes()
        hermes = os.path.abspath(hermes)
        homes_ = Homes(hermes, sys.executable, root, worker, repo)
        settings = config_value(worker, hermes, SETTINGS_KEY)
        launchd_root = Path(os.environ.get("LAUNCHD_ROOT", "/"))
        launchctl = os.environ.get("LAUNCHCTL_BIN", "launchctl")
        broker = broker_user_config(launchd_root) if sys.platform == "darwin" else None
        drifts = [
            *check_profile(commit, homes_),
            *check_plugins(commit, homes_),
            *check_config(homes_, CONFIG if broker is None else BROKER_USER_CONFIG),
            *check_slack_overrides(root, hermes),
            *check_worker_secrets(commit, worker, hermes, settings),
            *check_upload_broker(root, *factory_settings.token_variables(settings)),
            *check_cron(commit, homes_),
            *check_routes(commit, homes_),
            *check_dashboard(root, hermes),
            *check_rejected_deliveries(root),
            *check_gateway_watch(root),
            *check_owned_refs(homes_),
            *check_triage_board(homes_, settings),
            *check_kanban_boards(root),
            *check_triage_capacity(
                config_value(root, hermes, "kanban.max_spawn"),
                config_value(root, hermes, "kanban.max_in_progress"),
                triage_max_running(settings),
            ),
            *check_stranded_triage(root, time.time()),
            *check_guarded_cards(root, time.time()),
            *check_waiting_triage(root, worker / "plugins" / "blocker-order" / "__init__.py"),
            *check_triage_playbook(repo),
            *check_checkouts(settings),
            *check_work_skills(
                config_value(root, hermes, "plugins.entries.work.settings.skills_dir"),
                config_value(root, hermes, "plugins.entries.work.settings.allow"),
            ),
            *check_settings(settings, worker),
            *check_app_events(settings),
            *check_model_tiers(settings, worker),
            *check_mcp_servers(settings, worker),
            *check_root_mcp_servers(root, hermes),
            *check_hermes_tools(root, worker / "plugins" / "blocker-order" / "__init__.py"),
            *check_plugin_status(commit, homes_),
            *check_plugin_imports(commit, [root, worker], root),
        ]
        if sys.platform == "darwin":
            drifts.extend(check_services(launchd_root, launchctl))
            drifts.extend(check_gh_login(launchd_root, worker, time.time()))
            drifts.extend(check_auto_deploy(
                root, config_value(root, hermes, HOLD_KEY), None if args.ref else commit,
                float(git(repo, "show", "-s", "--format=%ct", commit.sha)), time.time(),
            ))
        if broker is not None:
            drifts.extend(check_broker_user(commit, launchd_root, root, launchctl, broker, live_accounts()))
        if drifts and args.ref is None:
            drifts.extend(check_source_checkout(commit))
    except (Refusal, GitError, factory_settings.SettingsError) as exc:
        print(f"check-install: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps([drift.to_json() for drift in drifts], indent=2))
    else:
        for drift in drifts:
            print(drift)
    return 1 if drifts else 0


if __name__ == "__main__":
    sys.exit(main())
