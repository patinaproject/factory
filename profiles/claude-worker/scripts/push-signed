#!/usr/bin/env python3
"""Publish the current branch's local commits to GitHub as signed commits.

Replays each commit oldest first through GitHub's Git Data API (blobs, a
tree, a commit, then a fast-forward of the branch ref). A commit has one
parent, or two when it merges the current head of the default branch into the
branch, in that parent order. GitHub signs a commit
created this way when the caller authenticates as a GitHub App installation
and sets no author or committer. All GitHub calls go through the gh CLI with
the caller's auth. After publishing, the local branch moves to the signed
remote commits, and uncommitted changes stay in place. Prints exactly one JSON
line on stdout.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field

GITHUB_URL = re.compile(
    r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+)/([^/]+?)(?:\.git)?/?$"
)
EXECUTABLE_FILE = "100755"
SUBMODULE = "160000"


class Refusal(Exception):
    pass


class Failure(Exception):
    pass


@dataclass
class Commit:
    sha: str
    message: str
    changes: list = field(default_factory=list)
    second_parent: str | None = None


def git(*args: str) -> str:
    proc = subprocess.run(["git", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        raise Failure(f"git {' '.join(args)} failed: {proc.stderr.strip()}")
    return proc.stdout.strip()


def gh_call(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([os.environ.get("GH_BIN", "gh"), *args], capture_output=True, text=True)


def gh(*args: str) -> dict:
    proc = gh_call(*args)
    if proc.returncode != 0:
        raise Failure(f"gh {' '.join(args)} failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout) if proc.stdout.strip() else {}


def repository_name() -> str:
    url = git("config", "--get", "remote.origin.url")
    match = GITHUB_URL.match(url)
    if not match:
        raise Refusal(f"origin {url} is not a GitHub repository URL")
    return f"{match.group(1)}/{match.group(2)}"


def gh_send(path: str, body: dict, method: str = "POST") -> dict:
    with tempfile.NamedTemporaryFile("w", suffix=".json") as handle:
        json.dump(body, handle)
        handle.flush()
        return gh("api", "--method", method, path, "--input", handle.name)


def remote_head(repository: str, branch: str) -> str | None:
    proc = gh_call("api", f"repos/{repository}/git/ref/heads/{branch}")
    if proc.returncode != 0:
        if "HTTP 404" in proc.stderr:
            return None
        raise Failure(f"reading {branch} on {repository} failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout)["object"]["sha"]


def remote_tree(repository: str, oid: str) -> str:
    return gh("api", f"repos/{repository}/git/commits/{oid}")["tree"]["sha"]


def raw_diff(old: str, new: str) -> list:
    # Read raw so stripping cannot eat whitespace at the end of the last path.
    raw = subprocess.run(
        ["git", "diff-tree", "-r", "--no-renames", "-z", "--raw", old, new], capture_output=True, text=True
    )
    if raw.returncode != 0:
        raise Failure(f"git diff-tree {new} failed: {raw.stderr.strip()}")
    fields = raw.stdout.rstrip("\0").split("\0")
    return [(header.lstrip(":").split(), path) for header, path in zip(fields[0::2], fields[1::2])]


def check_merge(sha: str, parents: list, first: bool, default: str, base_head: str | None) -> None:
    if len(parents) > 2:
        why = "an octopus merge"
    elif first:
        why = f"its first parent is on {default}"
    elif parents[1] != base_head:
        why = f"its second parent is not the current head of {default}"
    else:
        return
    raise Refusal(
        f"commit {sha} has {len(parents)} parents ({why}); push-signed replays single-parent commits "
        f"and merges whose parents are the branch head and the current head of {default}, in that order. "
        f"Merge origin/{default} into the branch again, or use gh pr update-branch"
    )


def read_commit(sha: str, parents: list) -> Commit:
    commit = Commit(sha, git("log", "-1", "--format=%B", sha), second_parent=parents[1] if len(parents) > 1 else None)
    # A merge's own work is what differs from its base side too. Every other
    # path came from the base head, whose blobs the remote already holds.
    own = {path for _, path in raw_diff(parents[1], sha)} if commit.second_parent else None
    for (old_mode, new_mode, _, blob, status), path in raw_diff(parents[0], sha):
        if SUBMODULE in (old_mode, new_mode):
            raise Refusal(f"commit {sha} changes submodule {path}; the API cannot write submodules")
        if status == "D":
            commit.changes.append({"path": path, "mode": old_mode, "type": "blob", "sha": None})
            continue
        if own is not None and path not in own:
            commit.changes.append({"path": path, "mode": new_mode, "type": "blob", "sha": blob})
            continue
        if status == "A" and new_mode == EXECUTABLE_FILE:
            raise Refusal(
                f"commit {sha} adds executable {path}; push-signed publishes no executable bits. "
                "Commit the script without it and run it with its interpreter"
            )
        if status != "A" and old_mode != new_mode and EXECUTABLE_FILE in (old_mode, new_mode):
            raise Refusal(f"commit {sha} changes the mode of {path}; push-signed publishes no mode changes")
        blob_read = subprocess.run(["git", "cat-file", "blob", blob], capture_output=True)
        if blob_read.returncode != 0:
            raise Failure(f"git cat-file blob {blob} failed: {blob_read.stderr.decode().strip()}")
        contents = base64.b64encode(blob_read.stdout).decode()
        commit.changes.append({"path": path, "mode": new_mode, "type": "blob", "contents": contents})
    return commit


def branch_chain(head: str, default: str) -> tuple:
    """The branch's own commits, oldest first, as rows of [sha, *parents].

    Only the first-parent chain counts, so a merge's second-parent history is
    never replayed. Also returns the fork point, the first parent of the oldest row.
    """
    listing = git("rev-list", "--reverse", "--first-parent", "--parents", head, "--not", f"origin/{default}")
    rows = [line.split() for line in listing.splitlines()]
    if rows and len(rows[0]) < 2:
        raise Refusal(f"commit {rows[0][0]} has no parent; push-signed publishes branches that fork from {default}")
    return (rows[0][1] if rows else head), rows


def signed_prefix(fork: str, remote: str, rows: list, default: str) -> int | None:
    """Count the leading local commits that the remote chain already carries.

    A publish that failed partway leaves signed copies on the remote. They are
    not ancestors of the local branch, but each one has the first parent, the
    other parents, and the tree of the local commit at the same position.
    Returns None when the remote holds anything else.
    """
    listing = subprocess.run(
        ["git", "rev-list", "--reverse", "--first-parent", "--parents", remote, "--not", f"origin/{default}"],
        capture_output=True, text=True,
    )
    remote_rows = [line.split() for line in listing.stdout.splitlines()]
    if listing.returncode != 0 or not remote_rows or len(remote_rows) > len(rows):
        return None
    previous = fork
    for (sha, *parents), (mine, *mine_parents) in zip(remote_rows, rows):
        if (
            parents[:1] != [previous]
            or parents[1:] != mine_parents[1:]
            or git("rev-parse", f"{sha}^{{tree}}") != git("rev-parse", f"{mine}^{{tree}}")
        ):
            return None
        previous = sha
    return len(remote_rows)


def publish(repository: str, branch: str, parent: str, commit: Commit) -> str:
    git_data = f"repos/{repository}/git"
    entries = []
    for change in commit.changes:
        entry = dict(change)
        contents = entry.pop("contents", None)
        if contents is not None:
            blob = {"content": contents, "encoding": "base64"}
            entry["sha"] = gh_send(f"{git_data}/blobs", blob)["sha"]
        entries.append(entry)
    # The tree request cannot hold a path as both a file and a directory, so a directory replaced by a file needs its deletions first.
    entries.sort(key=lambda entry: entry["sha"] is not None)
    tree = gh_send(f"{git_data}/trees", {"base_tree": remote_tree(repository, parent), "tree": entries})
    parents = [parent, commit.second_parent] if commit.second_parent else [parent]
    created = gh_send(f"{git_data}/commits", {"message": commit.message, "tree": tree["sha"], "parents": parents})
    gh_send(f"{git_data}/refs/heads/{branch}", {"sha": created["sha"], "force": False}, method="PATCH")
    return created["sha"]


def run() -> dict:
    inside = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True)
    if inside.stdout.strip() != "true":
        raise Refusal("push-signed runs only inside a git worktree")
    symbolic = subprocess.run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], capture_output=True, text=True)
    branch = symbolic.stdout.strip()
    if not branch:
        raise Refusal("HEAD is detached; check out the branch to publish")
    repository = repository_name()
    git("fetch", "--quiet", "origin")
    default = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD").split("/", 1)[1]
    if branch == default:
        raise Refusal(f"{branch} is the default branch; push-signed publishes only feature branches")

    head = git("rev-parse", "HEAD")
    head_tree = git("rev-parse", "HEAD^{tree}")
    base, rows = branch_chain(head, default)
    remote = remote_head(repository, branch)
    created = remote is None
    start = remote
    if created:
        start = base
    elif subprocess.run(["git", "merge-base", "--is-ancestor", remote, head]).returncode == 0:
        pass
    elif git("rev-parse", f"{remote}^{{tree}}") == head_tree:
        start = head
    else:
        done = signed_prefix(base, remote, rows, default)
        if done is None:
            raise Refusal(
                f"{branch} on {repository} has commits this branch lacks; "
                "update from the remote (for example git pull --ff-only)"
            )
        start = rows[done - 1][0]
    positions = [base, *(row[0] for row in rows)]
    if start not in positions:
        raise Refusal(f"{branch} on {repository} is at {start}, which is not on this branch's own commits; update from the remote")
    pending = rows[positions.index(start):]
    base_head = remote_head(repository, default) if any(len(row) > 2 for row in pending) else None
    commits = []
    for sha, *parents in pending:
        if len(parents) > 1:
            check_merge(sha, parents, sha == rows[0][0], default, base_head)
        commits.append(read_commit(sha, parents))

    if created:
        create_ref(repository, branch, base)
        remote = base
    published = []
    for commit in commits:
        remote = publish(repository, branch, remote, commit)
        published.append({"local": commit.sha, "remote": remote})
    if remote_tree(repository, remote) != head_tree:
        raise Refusal(f"remote commit {remote} does not match the tree of {head}; the local branch was left unchanged")
    git("fetch", "--quiet", "origin", branch)
    git("update-ref", "-m", "push-signed", f"refs/heads/{branch}", remote, head)
    git("branch", "--quiet", f"--set-upstream-to=origin/{branch}", branch)
    return {
        "repository": repository,
        "branch": branch,
        "created_branch": created,
        "published": published,
        "head": remote,
    }


def create_ref(repository: str, branch: str, oid: str) -> None:
    gh("api", "--method", "POST", f"repos/{repository}/git/refs", "-f", f"ref=refs/heads/{branch}", "-f", f"sha={oid}")


def main() -> int:
    argparse.ArgumentParser(description=__doc__).parse_args()
    try:
        status, report = 0, run()
    except Refusal as refusal:
        status, report = 2, {"error": str(refusal)}
    except Failure as failure:
        status, report = 1, {"error": str(failure)}
    except Exception as error:
        status, report = 1, {"error": f"{type(error).__name__}: {error}"}
    print(json.dumps(report))
    return status


if __name__ == "__main__":
    sys.exit(main())
