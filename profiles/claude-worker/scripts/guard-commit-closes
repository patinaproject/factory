#!/usr/bin/env python3
"""Claude Code PreToolUse hook for a worker's Bash calls: never publish a commit that closes an issue the pull request body does not.

Claude Code feeds the pending tool call as JSON on stdin. `push-signed` only moves a branch forward, so
a published commit message cannot be reworded, and the `Validate pull request` check then fails the pull
request for good. Before `push-signed` publishes, its commits are still local. This hook reads each
commit that is not yet on the remote branch and, when the branch has an open pull request, refuses a
commit that closes an issue (`fix: #N` does, as does `Closes #N`) which the body does not close, naming
the local rewrite that fixes it. With no open pull request there is no body to compare, and the check
in the pull request workflow decides.

Exit 0 allows the call. Exit 2 refuses it and Claude Code shows stderr to the model.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys

import card_branch
import check_title_closes

PUBLISH = re.compile(r"(?:^|[\s/;&|])push-signed\b")
RECORD_END = "\x1e"
FIELD = "\x1f"
REFUSAL = (
    "Refused: commit {sha} closes {ref} when it merges, but the pull request body has no `Closes {ref}` line. "
    "push-signed cannot reword a commit once it publishes it, so fix the commit now, while it is local. "
    "Run `git reset --soft {base}`, then commit again with a type that does not close {ref}, such as "
    "`feat: {ref} ...` or `refactor: {ref} ...`, and run push-signed again. When this pull request "
    "completes {ref}, add `Closes {ref}` to its body instead."
)


class Unreadable(Exception):
    pass


def run(args: list[str], cwd: str) -> str:
    try:
        proc = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    except OSError as failure:
        raise Unreadable(f"{args[0]} could not run: {failure.strerror or failure}") from failure
    if proc.returncode != 0:
        raise Unreadable(f"{' '.join(args[:3])} failed: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout


def unpublished(cwd: str) -> tuple[str, str, list[tuple[str, str]]]:
    """The branch, the ref its unpublished commits follow (the remote branch, else the default branch), and those commits as (sha, message) pairs."""
    branch = run(["git", "symbolic-ref", "--short", "HEAD"], cwd).strip()
    default = run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd).strip()
    remote = f"origin/{branch}"
    exists = subprocess.run(["git", "rev-parse", "--verify", "--quiet", remote], cwd=cwd, capture_output=True)
    base = remote if exists.returncode == 0 else default
    log = run(["git", "log", "--reverse", f"--format=%h{FIELD}%B{RECORD_END}", f"{base}..HEAD"], cwd)
    commits = [tuple(record.strip("\n").split(FIELD, 1)) for record in log.split(RECORD_END) if record.strip()]
    return branch, base, commits


def pull_request_body(branch: str, cwd: str) -> tuple[str, str] | None:
    gh = os.environ.get("GH_BIN", "gh")
    repo = json.loads(run([gh, "repo", "view", "--json", "nameWithOwner"], cwd))["nameWithOwner"]
    pulls = json.loads(run([gh, "pr", "list", "--head", branch, "--state", "open", "--json", "body", "--limit", "1"], cwd))
    return (repo, pulls[0]["body"] or "") if pulls else None


def refusals(cwd: str) -> list[str]:
    branch, base, commits = unpublished(cwd)
    if not commits:
        return []
    found = pull_request_body(branch, cwd)
    if found is None:
        return []
    repo, body = found
    in_body = card_branch.closes(body, repo)
    return [
        REFUSAL.format(sha=sha, ref=ref, base=base)
        for sha, message in commits
        for ref in sorted(check_title_closes.title_closes(message, repo) - in_body, key=lambda ref: int(ref[1:]))
    ]


def decide(event: dict) -> tuple[int, str]:
    if event.get("tool_name") != "Bash":
        return 0, ""
    if not PUBLISH.search((event.get("tool_input") or {}).get("command") or ""):
        return 0, ""
    try:
        problems = refusals(event.get("cwd") or os.getcwd())
    except (Unreadable, json.JSONDecodeError, KeyError) as failure:
        return 2, f"Refused: the commit closing check could not read the branch or its pull request ({failure}). Run push-signed again."
    return (2, "\n".join(problems)) if problems else (0, "")


def main() -> int:
    code, text = decide(json.load(sys.stdin))
    if text:
        print(text, file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
