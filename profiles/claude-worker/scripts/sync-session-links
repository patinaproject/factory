#!/usr/bin/env python3
"""Link every pull request on a card's branch to the card's Linear agent session.

With `--check` it changes nothing and prints `<task id> <session id> lacks <url> ...` for each session that
lacks a pull request on its branch. Without it, it prints `<task id> <session id> <action> <url> ...` for each
session that gained one. A failure for one card goes to stderr and the others still run. Exits 1 when any card
failed, or in `--check` when any session lacks a link, or 2 when HERMES_HOME is not set or Hermes cannot be found.
"""
from __future__ import annotations

import argparse
import importlib
import os
import re
import sqlite3
import sys
from pathlib import Path

import card_branch
import card_transition
import completion_contract
import factory_settings
import kanban_board
import reply_inbox
import session_links
from archive_card import Failed

REPO_LINE = re.compile(r"^repo:[ \t]*(\S+)[ \t]*$", re.MULTILINE)


def card_repository(card: dict) -> str | None:
    contract = card.get("completion_contract") or ""
    if completion_contract.REPOSITORY.fullmatch(contract):
        return contract
    key = completion_contract.pull_key(contract)
    if key:
        return key[0]
    line = REPO_LINE.search(card.get("body") or "")
    return line.group(1) if line else None


def linear_module():
    plugin = Path(os.environ["HERMES_HOME"]) / "plugins" / "linear-agent-session"
    sys.path.insert(0, str(plugin))
    return importlib.import_module("linear")


def sync_card(linear, client, card: dict, check: bool) -> str | None:
    session_id = reply_inbox.session_id_of(card.get("body"))
    repo = card_repository(card)
    branch = card.get("branch_name")
    if not (session_id and repo and branch):
        return None
    if check:
        held = {linear.review_links(url) for url in client.external_urls(session_id)}
        wanted = (linear.review_links(link["url"]) for link in session_links.branch_pull_links(repo, branch))
        lacking = [url for url in wanted if url not in held]
        return f"{card['id']} {session_id} lacks {' '.join(lacking)}" if lacking else None
    report = session_links.sync_session_pull_requests(linear, client, session_id, repo, branch)
    if report["action"] == "failed":
        raise Failed(report["error"])
    return f"{card['id']} {session_id} {report['action']} {' '.join(report['added'])}" if report["added"] else None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="report the sessions that lack a pull request; change nothing")
    args = parser.parse_args()
    if not os.environ.get("HERMES_HOME"):
        print("sync-session-links: HERMES_HOME is not set; point it at the claude-worker profile home", file=sys.stderr)
        return 2
    try:
        os.environ["HERMES_BIN"] = factory_settings.find_hermes()
    except factory_settings.SettingsError as exc:
        print(f"sync-session-links: {exc}", file=sys.stderr)
        return 2
    try:
        boards = card_transition.boards()
    except (Failed, ValueError) as failure:
        print(f"sync-session-links: listing boards failed: {failure}", file=sys.stderr)
        return 1
    linear = linear_module()
    client = linear.client_from_env()
    unclean = False
    for each in boards:
        if not os.path.exists(each["db_path"]):
            continue
        try:
            cards = kanban_board.cards(each["db_path"])
        except sqlite3.Error as failure:
            print(f"sync-session-links: {each['slug']}: cannot read the board: {failure}", file=sys.stderr)
            unclean = True
            continue
        for card in cards:
            try:
                line = sync_card(linear, client, card, args.check)
            except (Failed, card_branch.GhFailed, *linear.CLIENT_ERRORS, OSError, KeyError, ValueError, TypeError) as failure:
                print(f"sync-session-links: {card['id']}: {failure}", file=sys.stderr)
                unclean = True
                continue
            if line:
                print(line)
                unclean = unclean or args.check
    return 1 if unclean else 0


if __name__ == "__main__":
    sys.exit(main())
