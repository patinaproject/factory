#!/usr/bin/env python3
"""Send a factory pull request that cannot merge back to its worker.

GitHub sends no webhook when a pull request starts to conflict because its base
branch moved, or when a required check fails after the worker handed the card
off, so a card in `review` or `blocked` waits forever. A Hermes cron job runs
this script every few minutes. It lists the App's open pull requests that belong
to a `review` or `blocked` card and, for each one with a reason below, comments
on the card and hands it back to its worker. A conflict wins over a failed check.

- GitHub reports the pull request as `CONFLICTING`. `UNKNOWN` mergeability
  changes nothing, because GitHub resolves it on a later run.
- The card is in `review`, GitHub reports the pull request as `MERGEABLE`, and
  the newest run of a check that a rule of the base branch requires finished
  without passing on the current head. A `blocked` card is left alone, because
  a worker that cannot fix a failing check blocks for a person with no marker
  on the card yet. The script reads each pull request's
  checks on its own, because listing them for every open pull request times
  out on a large repository, and reads the rules only when some check failed, and does nothing while another required check is pending
  or has no run, because that head is still running.

A card is sent back once per pull request head: the comment ends with the line
`conflict_head: <sha>` or `failed_check_head: <sha>`, and a `blocked` card whose
comments already hold that line for the current head is skipped. A worker that
blocks on the same head is not unblocked in a loop, and a worker that pushes a
new head that still fails is told again. A `review` card that holds the line is
a handback that failed partway, because the ready gate refuses a conflicting
head and a failing required check, so the review reopen runs again. A card
comment names a pull request as `<owner>/<name>#<number>`, never by URL,
because Hermes holds a `ready` card from its worker while a card comment from
the last day holds a pull request URL and no handoff event came in a later
second, and the reopen lands in the same second as the comment. Prints one
line per card sent back, `<task id> <pull request url>`. A failure for one
repository or card goes to stderr and the others still run.

A mergeable pull request whose review decision is `CHANGES_REQUESTED`, and that
was not sent back for a failed check, gets the review sweep, which
`stale_reviews.decide` judges. A changes request on the current head, or an
unresolved review thread from a reviewer who is not requested now, sends the
card back once per head with the line `review_head: <sha>`. Otherwise, once
every required check passed, each reviewer whose changes request is on an older
head and who is not requested now is requested again, and the card's Linear
agent session gets an activity that names them. That line is `<task id> <pull
request url> re-requested <login>,<login>`. A review is never dismissed.

A `triage` card is one Hermes parked after its block-loop breaker tripped, and
this script never moves it. When the App's pull request for the card is
`CONFLICTING`, the card's Linear agent session gets one activity that names the
pull request, says the card stays parked, and lists the files both the branch
and its base changed since they split, read from GitHub's compare API without a
checkout. Then the card gets a comment that ends with the line
`conflict_head: <sha>`, and a card that holds that line for the current head is
skipped. Any other mergeability, check, or review state changes nothing. A card
with no session line gets the comment and then fails. That line is `<task id>
<pull request url> notified`. Exits 1 when any failed, or 2 when HERMES_HOME is
not a profile home or the factory settings cannot be read.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple
from urllib.parse import quote

import card_branch
import factory_settings
import merged_checks
import stale_reviews
from card_transition import pull_ref

REPO_LINE = re.compile(r"^repo:\s*(\S+)\s*$", re.MULTILINE)
SESSION_LINE = re.compile(r"^linear_agent_session_id:[ \t]*(\S+)[ \t]*$", re.MULTILINE)
CONFLICT_MARKER = "conflict_head: "
FAILED_CHECK_MARKER = "failed_check_head: "
REVIEW_MARKER = "review_head: "
CONFLICT_REASON = "merge conflict with the base branch; see the card comments"
FAILED_CHECK_REASON = "a required check failed; see the card comments"
REVIEW_REASON = "changes-requested review still needs work; see the card comments"
COMPARE_LIMIT = 300
PR_FIELDS = "number,url,headRefName,headRefOid,baseRefName,author,mergeable,reviewDecision"


class Refusal(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


class Failed(Exception):
    pass


class Handback(NamedTuple):
    marker: str
    text: str
    reason: str


def check_profile_home() -> None:
    if not os.environ.get("HERMES_HOME"):
        raise Refusal("HERMES_HOME is not set; point it at the claude-worker profile home")
    worker = Path(os.environ["HERMES_HOME"]).resolve()
    if worker.parent.name != "profiles":
        raise Refusal(f"HERMES_HOME {worker} is not a profile home under <root>/profiles/")


def run(*command: str) -> str:
    try:
        proc = subprocess.run(command, capture_output=True, text=True)
    except OSError as failure:
        raise Failed(f"{command[0]} could not run: {failure.strerror or failure}") from failure
    if proc.returncode != 0:
        detail = proc.stderr.strip().splitlines()[0] if proc.stderr.strip() else "no error output"
        raise Failed(f"{Path(command[0]).name} {' '.join(command[1:3])} failed: {detail}")
    return proc.stdout


def app_login() -> str:
    try:
        login = factory_settings.read(raw=True)["github"]["login"]
    except (ValueError, KeyError, TypeError):
        login = None
    if not isinstance(login, str) or not login:
        raise Refusal("github.login is not set in the factory settings")
    return login


def candidates(tasks: list) -> dict:
    """Cards that may hold a pull request to send back, grouped by repository."""
    by_repo: dict = {}
    for task in tasks:
        repo = REPO_LINE.search(task.get("body") or "")
        if task.get("status") in ("review", "blocked", "triage") and task.get("branch_name") and repo:
            by_repo.setdefault(repo.group(1), []).append(task)
    return by_repo


def open_pulls(repo: str) -> list:
    out = run(os.environ.get("GH_BIN", "gh"), "pr", "list", "-R", repo, "--state", "open", "--limit", "200", "--json", PR_FIELDS)
    return json.loads(out)


def required_contexts(repo: str, base: str, cache: dict) -> set:
    if (repo, base) not in cache:
        out = run(os.environ.get("GH_BIN", "gh"), "api", f"repos/{repo}/rules/branches/{quote(base, safe='')}?per_page=100")
        cache[(repo, base)] = {
            required["context"]
            for rule in json.loads(out)
            if rule.get("type") == "required_status_checks"
            for required in (rule.get("parameters") or {}).get("required_status_checks") or []
        }
    return cache[(repo, base)]


def newest_checks(pull: dict) -> dict:
    view = run(os.environ.get("GH_BIN", "gh"), "pr", "view", pull["url"], "--json", "statusCheckRollup")
    return merged_checks.newest_runs(json.loads(view).get("statusCheckRollup") or [])


def failed_required_checks(pull: dict, newest: dict, repo: str, cache: dict) -> dict:
    """Maps each required check whose newest run failed to its details URL; empty while any required check is unsettled."""
    if not any(merged_checks.failed(check) for runs in newest.values() for check in runs):
        return {}
    failures = {}
    for context in required_contexts(repo, pull["baseRefName"], cache):
        runs = newest.get(context)
        if not runs or any(not merged_checks.passed(r) and not merged_checks.failed(r) for r in runs):
            return {}
        bad = [r for r in runs if merged_checks.failed(r)]
        if bad:
            failures[context] = bad[0].get("detailsUrl") or bad[0].get("targetUrl")
    return failures


def already_sent(hermes: str, task_id: str, marker: str) -> bool:
    shown = json.loads(run(hermes, "kanban", "show", task_id, "--json"))
    return any(
        line.strip() == marker for comment in shown.get("comments") or [] for line in (comment.get("body") or "").splitlines()
    )


def conflict_handback(pull: dict) -> Handback:
    base = pull["baseRefName"]
    marker = f"{CONFLICT_MARKER}{pull['headRefOid']}"
    text = (
        f"Pull request {pull['url']} conflicts with {base}. Merge origin/{base} into the branch, resolve the "
        "conflicts, and publish the merge with push-signed. When you cannot resolve a conflict with confidence, "
        "stop and make the first line of your final message `Needs input:` followed by a reason naming each "
        "conflicting file.\n\n"
        f"{marker}"
    )
    return Handback(marker, text, CONFLICT_REASON)


def failed_check_handback(pull: dict, failures: dict) -> Handback:
    marker = f"{FAILED_CHECK_MARKER}{pull['headRefOid']}"
    listed = "\n".join(f"- `{name}`" + (f": {url}" if url else "") for name, url in sorted(failures.items()))
    text = (
        f"Pull request {pull['url']} at head {pull['headRefOid']} fails a required check:\n{listed}\n\n"
        "Read the failing job, fix the cause, and publish the fix with push-signed. When the failure lies in a "
        "step the pull request does not change, re-run it once with `gh run rerun <run-id> --failed`. When the "
        "pull request body fails the repository's body check, rewrite the body. When you cannot fix it with "
        "confidence, stop and make the first line of your final message `Needs input:` followed by the reason.\n\n"
        f"{marker}"
    )
    return Handback(marker, text, FAILED_CHECK_REASON)


def review_handback(pull: dict, reason: str) -> Handback:
    marker = f"{REVIEW_MARKER}{pull['headRefOid']}"
    text = (
        f"Pull request {pull['url']} has a changes-requested review and is not ready for another look: {reason}. "
        "Fix it and publish the fix with push-signed. When you cannot, stop and make the first line of your final "
        "message `Needs input:` followed by the reason.\n\n"
        f"{marker}"
    )
    return Handback(marker, text, REVIEW_REASON)


def re_request(repo: str, task: dict, pull: dict, logins: tuple[str, ...]) -> None:
    reviewers = [arg for login in logins for arg in ("-f", f"reviewers[]={login}")]
    run(os.environ.get("GH_BIN", "gh"), "api", "-X", "POST", f"repos/{repo}/pulls/{pull['number']}/requested_reviewers", *reviewers)
    print(f"{task['id']} {pull['url']} re-requested {','.join(logins)}")
    session = SESSION_LINE.search(task.get("body") or "")
    if session is None:
        raise Failed("the card has no linear_agent_session_id line")
    cli = Path(os.environ["HERMES_HOME"]) / "plugins" / "linear-agent-session" / "cli.py"
    at_logins = ", ".join("@" + login for login in logins)
    run(
        sys.executable, str(cli), "activity", "--agent-session-id", session.group(1), "--type", "elicitation",
        "--body", (
            f"Changes are in, re-requested review from {at_logins}: their changes-requested review is on an older head than the "
            f"current head {pull['headRefOid']}. Review the pull request on GitHub, then merge it or request changes."
        ),
        "--external-url", f"Pull request={pull['url']}",
    )


def handback_for(pull: dict, task: dict, repo: str, cache: dict) -> Handback | None:
    """Re-requests stale reviewers as a side effect when the review sweep decides so."""
    if pull["mergeable"] == "CONFLICTING":
        return conflict_handback(pull)
    review = pull.get("reviewDecision") == "CHANGES_REQUESTED"
    if pull["mergeable"] != "MERGEABLE" or (task["status"] != "review" and not review):
        return None
    newest = newest_checks(pull)
    if task["status"] == "review":
        failures = failed_required_checks(pull, newest, repo, cache)
        if failures:
            return failed_check_handback(pull, failures)
    if not review:
        return None
    reviews, requested, authors = stale_reviews.read_reviews(run, os.environ.get("GH_BIN", "gh"), repo, pull["number"])
    outcome = stale_reviews.decide(pull, reviews, requested, authors, newest, required_contexts(repo, pull["baseRefName"], cache))
    if isinstance(outcome, stale_reviews.Request):
        re_request(repo, task, pull, outcome.logins)
    return review_handback(pull, outcome.reason) if isinstance(outcome, stale_reviews.Handback) else None


def send_back(hermes: str, task: dict, handback: Handback, sent: bool) -> None:
    """Every step either moves the card or leaves it where the next run repeats the step."""
    task_id = task["id"]
    if task["status"] == "blocked":
        run(hermes, "kanban", "unblock", task_id)
        run(hermes, "kanban", "request-review", task_id)
    if not sent:
        run(hermes, "kanban", "comment", task_id, pull_ref(handback.text))
    run(hermes, "kanban", "reopen-review", task_id, "--reason", handback.reason)


def compare(repo: str, spec: str) -> dict:
    return json.loads(run(os.environ.get("GH_BIN", "gh"), "api", f"repos/{repo}/compare/{spec}?per_page=1"))


def conflicting_files(repo: str, pull: dict) -> tuple[list, bool]:
    """Files both the branch and its base changed since they split, and whether GitHub's 300 file cap may hide more."""
    base = quote(pull["baseRefName"])
    head_side = compare(repo, f"{base}...{pull['headRefOid']}")
    base_side = compare(repo, f"{head_side['merge_base_commit']['sha']}...{base}")
    names = [{file["filename"] for file in side["files"]} for side in (head_side, base_side)]
    truncated = any(len(side["files"]) >= COMPARE_LIMIT for side in (head_side, base_side))
    return sorted(names[0] & names[1]), truncated


def notify_triage(hermes: str, repo: str, task: dict, pull: dict) -> bool:
    """Tells a parked card's session about a conflict once per head; never changes the card's state."""
    if pull["mergeable"] != "CONFLICTING":
        return False
    base = pull["baseRefName"]
    marker = f"{CONFLICT_MARKER}{pull['headRefOid']}"
    if already_sent(hermes, task["id"], marker):
        return False
    files, truncated = conflicting_files(repo, pull)
    listed = "\n".join(f"- `{name}`" for name in files) if files else "The list of conflicting files is unavailable."
    note = f"\nGitHub listed only the first {COMPARE_LIMIT} changed files, so more files may conflict." if truncated else ""
    reference = pull_ref(pull["url"])
    body = (
        f"Pull request {reference} conflicts with its base {base}. This card stays parked, and the worker merges "
        f"{base} into the branch first once someone replies. Conflicting files:\n{listed}{note}"
    )
    session = SESSION_LINE.search(task.get("body") or "")
    if session is not None:
        cli = Path(os.environ["HERMES_HOME"]) / "plugins" / "linear-agent-session" / "cli.py"
        run(
            sys.executable, str(cli), "activity", "--agent-session-id", session.group(1), "--type", "elicitation",
            "--body", body, "--external-url", f"Pull request={pull['url']}",
        )
    comment = (
        f"Pull request {reference} conflicts with {base}. The card stays parked. When a person replies and the card "
        f"resumes, the worker merges origin/{base} first.\n\n{marker}"
    )
    run(hermes, "kanban", "comment", task["id"], pull_ref(comment))
    if session is None:
        raise Failed("the card has no linear_agent_session_id line")
    return True


def main() -> int:
    argparse.ArgumentParser(description=__doc__.splitlines()[0]).parse_args()
    failed = False
    try:
        check_profile_home()
        hermes = factory_settings.find_hermes()
        login = app_login()
        try:
            by_repo = candidates(json.loads(run(hermes, "kanban", "list", "--json")))
        except (Failed, ValueError) as failure:
            raise Refusal(f"listing cards failed: {failure}", 1)
    except Refusal as exc:
        print(f"reopen-conflicts: {exc}", file=sys.stderr)
        return exc.code
    except factory_settings.SettingsError as exc:
        print(f"reopen-conflicts: {exc}", file=sys.stderr)
        return 2
    rules: dict = {}
    for repo, tasks in sorted(by_repo.items()):
        try:
            pulls = open_pulls(repo)
        except (Failed, ValueError) as failure:
            print(f"reopen-conflicts: {repo}: {failure}", file=sys.stderr)
            failed = True
            continue
        for task in tasks:
            pull = next(
                (p for p in pulls if p["headRefName"] == task["branch_name"] and card_branch.is_app((p.get("author") or {}).get("login", ""), login)),
                None,
            )
            if pull is None:
                continue
            try:
                if task["status"] == "triage":
                    if notify_triage(hermes, repo, task, pull):
                        print(f"{task['id']} {pull['url']} notified")
                    continue
                handback = handback_for(pull, task, repo, rules)
                if handback is None:
                    continue
                sent = already_sent(hermes, task["id"], handback.marker)
                if sent and task["status"] == "blocked":
                    continue
                send_back(hermes, task, handback, sent)
            except (Failed, ValueError) as failure:
                print(f"reopen-conflicts: {task['id']}: {failure}", file=sys.stderr)
                failed = True
                continue
            print(f"{task['id']} {pull['url']}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
