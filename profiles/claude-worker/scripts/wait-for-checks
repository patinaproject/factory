#!/usr/bin/env python3
"""Wait for a pull request's checks for less than the prompt cache lifetime, then return.

A foreground wait that outlasts the 5-minute prompt cache makes the next model call rewrite the whole
context. This helper returns after BUDGET_SECONDS at most, so the worker wakes on a warm cache and runs
it again. `guard-ci-wait` refuses the longer waits and gives this command the tool timeout it needs.

Run it with python3: wait-for-checks <number> --repo <owner/repo>

Exit codes: 0 every check passed or was skipped, 1 a check failed or was cancelled, 2 gh failed or
the arguments were wrong, 3 checks are still running (run it again).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# The prompt cache lives 300 seconds. The guard's tool timeout is 270, and gh needs a few seconds per poll.
BUDGET_SECONDS = 240
POLL_SECONDS = 15
GH_SECONDS = 30
PASSED = frozenset({"pass", "skipping"})
FAILED = frozenset({"fail", "cancel"})


class GhFailed(Exception):
    pass


def find_gh() -> str:
    found = os.environ.get("GH_BIN") or shutil.which("gh") or str(Path.home() / ".local/bin/gh")
    if not Path(found).exists():
        raise GhFailed("gh is not on PATH or in ~/.local/bin; set GH_BIN")
    return found


def fetch_checks(gh: str, number: str, repo: str) -> list[dict]:
    result = subprocess.run(
        [gh, "pr", "checks", number, "--repo", repo, "--json", "name,bucket,link"],
        capture_output=True, text=True, timeout=GH_SECONDS, stdin=subprocess.DEVNULL,
    )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        # gh exits non-zero with no JSON while the head has no checks yet.
        if "no checks reported" in result.stderr:
            return []
        raise GhFailed(f"gh pr checks exited {result.returncode}: {result.stderr.strip() or result.stdout.strip()}") from None


def verdict(checks: list[dict]) -> str:
    """'fail' when any check failed, 'pass' when there are checks and all passed, else 'pending'."""
    buckets = {check["bucket"] for check in checks}
    if buckets & FAILED:
        return "fail"
    if checks and buckets <= PASSED:
        return "pass"
    return "pending"


def wait(fetch, budget=BUDGET_SECONDS, poll=POLL_SECONDS, clock=time.monotonic, sleep=time.sleep) -> tuple[str, list[dict]]:
    deadline = clock() + budget
    while True:
        checks = fetch()
        state = verdict(checks)
        if state != "pending" or clock() + poll >= deadline:
            return state, checks
        sleep(poll)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("number")
    parser.add_argument("--repo", required=True)
    args = parser.parse_args()
    try:
        gh = find_gh()
        state, checks = wait(lambda: fetch_checks(gh, args.number, args.repo))
    except (GhFailed, subprocess.TimeoutExpired) as error:
        print(f"wait-for-checks: {error}", file=sys.stderr)
        return 2
    counts: dict[str, int] = {}
    for check in checks:
        counts[check["bucket"]] = counts.get(check["bucket"], 0) + 1
    print(", ".join(f"{count} {bucket}" for bucket, count in sorted(counts.items())) or "no checks reported yet")
    for check in checks:
        if check["bucket"] in FAILED:
            print(f"{check['bucket']}\t{check['name']}\t{check.get('link', '')}")
    if state == "pending":
        print(f"Checks are still running after {BUDGET_SECONDS}s. Run this command again.")
    return {"pass": 0, "fail": 1, "pending": 3}[state]


if __name__ == "__main__":
    sys.exit(main())
