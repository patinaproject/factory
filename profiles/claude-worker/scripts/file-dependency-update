#!/usr/bin/env python3
"""File the weekly issue that asks the agent to update npm dependencies within their declared ranges.

A Hermes cron job runs this script once a week. It reads `dependency_updates` from the factory settings
(`repository`, `team_key`, `theme_label`, `type_label`), then asks Linear for the team's open issues that
the agent app created and whose title starts with `dependency_update.TITLE_PREFIX`. When one is open it
files nothing and prints `open <identifier> <url>`. Otherwise it files one issue in the team's triage
state with the theme label only, delegated to the agent app, with no assignee and no priority, and prints
`filed <identifier> <url>`. A failed Linear read ends the run before any write.
Exits 1 when Linear or the broker fails, or 2 when the settings or HERMES_HOME are wrong.
"""
from __future__ import annotations

import os
import sys
from datetime import datetime, timezone

import card_transition
import dependency_update
import factory_settings


def main() -> int:
    if not os.environ.get("HERMES_HOME"):
        print("file-dependency-update: HERMES_HOME is not set; point it at the claude-worker profile home", file=sys.stderr)
        return 2
    try:
        settings = dependency_update.parse_settings(factory_settings.read(raw=False))
    except (factory_settings.SettingsError, dependency_update.SettingsError, ValueError) as exc:
        print(f"file-dependency-update: {exc}", file=sys.stderr)
        return 2
    linear = card_transition.plugin_module("linear-agent-session", "linear")
    try:
        client = linear.client_from_env()
        open_issues = client.open_issues_titled(settings.team_key, dependency_update.TITLE_PREFIX)
        if open_issues:
            print(f"open {open_issues[0]['identifier']} {open_issues[0]['url']}")
            return 0
        issue = client.create_issue(
            settings.team_key,
            dependency_update.title(datetime.now(timezone.utc).date()),
            dependency_update.description(settings),
            [settings.theme_label],
            state_type="triage",
            delegate_self=True,
        )
    except (*linear.CLIENT_ERRORS, OSError) as exc:
        print(f"file-dependency-update: Linear failed: {exc}", file=sys.stderr)
        return 1
    print(f"filed {issue['identifier']} {issue['url']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
