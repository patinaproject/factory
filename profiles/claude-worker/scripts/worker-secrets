#!/usr/bin/env python3
"""Print the worker's one secret, the proxy token, for the worker home's secrets.command.

The worker home holds no factory secret of its own: no Infisical identity, no
Linear app credentials. Hermes runs this when a worker process starts. It asks
the gateway's broker for the proxy token that claude_session.auth_token_env
names in the worker's config.yaml, which the worker's own agent loop sends to
the model proxy, and prints it as <name>=<token>. The factory-secret-names
plugin keeps that variable out of every process the worker starts. Prints
nothing when the settings name no token variable. Prints nothing and exits 1
when the broker refuses or does not answer.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

HOME = Path(__file__).resolve().parents[1]
AUTH_TOKEN_ENV = re.compile(r"^\s*auth_token_env:\s*(.*)$", re.MULTILINE)


def token_variable() -> str:
    config = HOME / "config.yaml"
    match = AUTH_TOKEN_ENV.search(config.read_text()) if config.is_file() else None
    return match.group(1).strip().strip("\"'") if match else ""


def main() -> int:
    if len(sys.argv) > 1:
        print("worker-secrets: takes no arguments; it prints the worker's secrets", file=sys.stderr)
        return 2
    if sys.stdout.isatty():
        print("worker-secrets: refusing to print secrets to a terminal; Hermes reads them through a pipe", file=sys.stderr)
        return 2
    name = token_variable()
    if not name:
        return 0
    sys.path.insert(0, str(HOME / "plugins" / "linear-agent-session"))
    import linear

    try:
        reply = linear.broker_request(linear.broker_socket_path({"HERMES_HOME": str(HOME)}), "proxy_token")
    except linear.LinearError as error:
        print(f"worker-secrets: {error}", file=sys.stderr)
        return 1
    print(f"{name}={reply['token']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
