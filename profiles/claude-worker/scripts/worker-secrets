#!/usr/bin/env python3
"""Print the worker's share of the factory secrets for the worker home's secrets.command.

Runs the root home's bin/factory-secrets and keeps only the Linear app
credentials, the proxy token that claude_session.auth_token_env names, and the
Sentry token that claude_session.sentry_token_env names in the worker's
config.yaml. Every other secret stays out of the worker process
and the Claude sessions it starts. Prints nothing and exits 1 when the root
helper fails.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

HOME = Path(__file__).resolve().parents[1]
ROOT_HELPER = HOME.parents[1] / "bin" / "factory-secrets"
LINEAR_KEYS = ("LINEAR_CLIENT_ID", "LINEAR_CLIENT_SECRET")
KEY = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=")
TOKEN_ENV = re.compile(r"^\s*(?:auth|sentry)_token_env:\s*(.*)$", re.MULTILINE)


def allowed_keys() -> set:
    keys = set(LINEAR_KEYS)
    config = HOME / "config.yaml"
    text = config.read_text() if config.is_file() else ""
    for match in TOKEN_ENV.finditer(text):
        name = match.group(1).strip().strip("\"'")
        if name:
            keys.add(name)
    return keys


def main() -> int:
    if len(sys.argv) > 1:
        print("worker-secrets: takes no arguments; it prints the worker's secrets", file=sys.stderr)
        return 2
    if sys.stdout.isatty():
        print("worker-secrets: refusing to print secrets to a terminal; Hermes reads them through a pipe", file=sys.stderr)
        return 2
    proc = subprocess.run([str(ROOT_HELPER)], stdout=subprocess.PIPE, text=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        print(f"worker-secrets: {ROOT_HELPER} printed no secrets", file=sys.stderr)
        return 1
    keys = allowed_keys()
    for line in proc.stdout.splitlines():
        match = KEY.match(line)
        if match and match.group(1) in keys:
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
