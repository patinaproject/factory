#!/usr/bin/env python3
"""Start waiting triage cards while fewer than the factory's cap run on the Triage board.

Hermes caps workers per host (`kanban.max_in_progress`) and per board
(`kanban.max_spawn`), and this script adds the triage cap below `max_spawn`, so
the default board cannot take triage's slots. Triage creates
each triage card without an assignee, and the dispatcher skips it. Every minute
a Hermes cron job runs this script. First it releases each `scheduled` card that
`card_transition.py`'s release rule says has a reply its last round did not see,
reading the board through `kanban_board` in one snapshot, and prints one
`released <task id>` line per card. A released card is `ready` and unassigned.
It then releases, on every board, each card parked for the worker's gh login once
`$HERMES_HOME/gh/token-expiry.json` has the 15 minutes a run needs (see
`card_transition.sweep_login`), with the same line. On `triage` that card is unassigned
and the next step assigns it; on any other board it lands `ready` and assigned.
It releases each card parked for a factory deploy the same way once the install
matches the commit auto-deploy recorded as deployed (`card_transition.sweep_deploy`).
For each card parked for its issue's Agent brief it applies `card_transition.sweep_brief`:
it releases the card with the same line, or queues the issue's triage card and prints
`queued <triage task id> for <task id>`, so the next step can assign that triage card.
Then it counts the board's cards that are `running`, or `ready` with an
assignee, and assigns `claude-worker` to waiting `ready` cards, highest priority
and then oldest first, until that count reaches `triage.max_running` in the
factory settings. A `scheduled` card uses no slot. It prints one
`assigned <task id>` line per card. Exits 1 when a `hermes` call or a release
fails, or 2 when the settings or HERMES_HOME are wrong.
"""
from __future__ import annotations

import json
import os
import sqlite3
import subprocess
import sys

import card_transition
import factory_settings

TRIAGE_BOARD = "triage"
WORKER = "claude-worker"


class Refusal(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


def hermes(binary: str, *args: str) -> str:
    proc = subprocess.run([binary, *args], capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"hermes {' '.join(args[:4])} failed: {proc.stderr.strip()}", 1)
    return proc.stdout


def max_running(settings) -> int:
    value = (settings.get("triage") or {}).get("max_running") if isinstance(settings, dict) else None
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise Refusal(f"triage.max_running {value!r} in {factory_settings.SETTINGS_KEY} must be a positive integer")
    return value


def to_assign(tasks: list, cap: int) -> list[str]:
    busy = sum(1 for t in tasks if t["status"] == "running" or (t["status"] == "ready" and t["assignee"]))
    waiting = sorted(
        (t for t in tasks if t["status"] == "ready" and not t["assignee"]),
        key=lambda t: (-(t["priority"] or 0), t["created_at"]),
    )
    return [t["id"] for t in waiting[: max(cap - busy, 0)]]


def release_waiting() -> bool:
    """Release the waiting cards a reply answered; False when the board or a release failed."""
    try:
        swept = card_transition.sweep(TRIAGE_BOARD)
    except (card_transition.Failed, sqlite3.Error) as exc:
        print(f"dispatch-triage: cannot read the waiting cards: {exc}", file=sys.stderr)
        return False
    for task_id in swept["released"]:
        print(f"released {task_id}")
    for task_id, error in swept["failed"].items():
        print(f"dispatch-triage: releasing {task_id} failed: {error}", file=sys.stderr)
    return not swept["failed"]


def release_parked(sweep, waits_for: str) -> bool:
    """Release the cards a machine condition parked once it holds; False when a board or a release failed."""
    try:
        swept = sweep()
    except (card_transition.Failed, sqlite3.Error, ValueError) as exc:
        print(f"dispatch-triage: cannot read the cards waiting for {waits_for}: {exc}", file=sys.stderr)
        return False
    for task_id in swept["released"]:
        print(f"released {task_id}")
    for task_id, triage_id in swept.get("queued", {}).items():
        print(f"queued {triage_id} for {task_id}")
    for task_id, error in swept["failed"].items():
        print(f"dispatch-triage: releasing {task_id} for {waits_for} failed: {error}", file=sys.stderr)
    return not swept["failed"]


def main() -> int:
    if not os.environ.get("HERMES_HOME"):
        print("dispatch-triage: HERMES_HOME is not set; point it at the claude-worker profile home", file=sys.stderr)
        return 2
    try:
        binary = factory_settings.find_hermes()
        cap = max_running(factory_settings.read(raw=False))
        os.environ["HERMES_BIN"] = binary
        released = release_waiting()
        released = release_parked(card_transition.sweep_login, "the gh login") and released
        released = release_parked(card_transition.sweep_deploy, "a factory deploy") and released
        released = release_parked(card_transition.sweep_brief, "an Agent brief") and released
        tasks = json.loads(hermes(binary, "kanban", "--board", TRIAGE_BOARD, "list", "--json"))
        for task_id in to_assign(tasks, cap):
            hermes(binary, "kanban", "--board", TRIAGE_BOARD, "assign", task_id, WORKER)
            print(f"assigned {task_id}")
        if not released:
            return 1
    except Refusal as exc:
        print(f"dispatch-triage: {exc}", file=sys.stderr)
        return exc.code
    except factory_settings.SettingsError as exc:
        print(f"dispatch-triage: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
