#!/usr/bin/env python3
"""Print the run's sentry MCP server headers for Claude Code's headersHelper.

claude-session points the sentry server's headersHelper here, so Claude Code
keeps the Sentry token in memory and sends it as a Sentry-Bearer
Authorization header, and no process Claude Code starts inherits it. Each run
asks the gateway's broker through the linear-agent-session plugin in
$HERMES_HOME, which the helper command sets, so the worker never stores the
token. Run it with python3. Exits 1 when the broker refuses or does not
answer, and 2 on an argument or a terminal stdout.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) > 1:
        print("sentry-headers: takes no arguments; it prints the sentry server's headers", file=sys.stderr)
        return 2
    if sys.stdout.isatty():
        print("sentry-headers: refusing to print a secret to a terminal; Claude Code reads it through a pipe", file=sys.stderr)
        return 2
    home = os.environ.get("HERMES_HOME")
    if not home:
        print("sentry-headers: HERMES_HOME is not set; claude-session sets it to the worker home", file=sys.stderr)
        return 1
    sys.path.insert(0, str(Path(home) / "plugins" / "linear-agent-session"))
    import linear

    try:
        reply = linear.broker_request(linear.broker_socket_path({"HERMES_HOME": home}), "sentry_token")
    except linear.LinearError as error:
        print(f"sentry-headers: {error}", file=sys.stderr)
        return 1
    print(json.dumps({"Authorization": f"Sentry-Bearer {reply['token']}"}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
