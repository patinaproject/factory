PULL_URL = re.compile(r"^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)$")
ISSUE_URL = re.compile(r"^https://github\.com/([^/]+/[^/]+)/issues/([0-9]+)$")
GITHUB_ISSUE_LINE = re.compile(r"^github_issue_url:\s*(\S+)\s*$", re.MULTILINE)
CLOSING_KEYWORD = r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?):?\s+(?:\[[^\]]*\]\()?"
HTML_COMMENT = re.compile(r"<!--.*?-->", re.S)


class Refusal(Exception):
    def __init__(self, message: str, *, transient: bool = False) -> None:
        super().__init__(message)
        self.transient = transient


class Adoption(NamedTuple):
    source: str
    ref: str
    head: str


class SessionPlan(NamedTuple):
    session_id: str
    resumed: bool
    reason: str
    previous_id: str | None
    previous: Path | None
    last_result: str | None


class Stopped(BaseException):
    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def git(cwd: Path, *args: str) -> str:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"git {' '.join(args)} failed in {cwd}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def takeover_pull_ref(takeover_pr: str, repo: str) -> str:
    match = PULL_URL.match(takeover_pr)
    if not match or match.group(1).lower() != repo.lower():
        raise Refusal(f"--takeover-pr {takeover_pr} is not a pull request URL in {repo}")
    return f"refs/pull/{match.group(2)}/head"


def origin_default(worktree: Path) -> str:
    proc = subprocess.run(
        ["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd=worktree, capture_output=True, text=True
    )
    if proc.returncode != 0:
        raise Refusal(f"origin/HEAD is not set in {worktree}; run git remote set-head origin -a in the checkout")
    return proc.stdout.strip()


def adopt_existing_work(
    worktree: Path, branch: str, repo: str, takeover_pr: str | None, login: str | None
) -> Adoption | None:
    pull_ref = takeover_pull_ref(takeover_pr, repo) if takeover_pr else None
    default = origin_default(worktree)
    if git(worktree, "rev-list", f"{default}..HEAD") or git(worktree, "status", "--porcelain"):
        return None
    if not login:
        raise Refusal(
            "github.login is not set in the settings, so claude-session cannot tell the factory's branches from a person's"
        )
    try:
        branch_owner = card_branch.owner(card_branch.run_gh, repo, branch, login)
    except card_branch.GhFailed as failure:
        raise Refusal(str(failure), transient=isinstance(failure, card_branch.GhServerError)) from failure
    source = card_branch.adoption(pull_ref is not None, branch_owner)
    if source is card_branch.Source.FRESH:
        return None
    if source is card_branch.Source.REFUSE:
        raise Refusal(card_branch.refusal(branch, login))
    if source is card_branch.Source.REMOTE_BRANCH:
        git(worktree, "fetch", "--quiet", "origin", f"refs/heads/{branch}")
        adoption = Adoption(source.value, branch, git(worktree, "rev-parse", "FETCH_HEAD"))
    else:
        git(worktree, "fetch", "--quiet", "origin", pull_ref)
        adoption = Adoption(source.value, takeover_pr, git(worktree, "rev-parse", "FETCH_HEAD"))
    git(worktree, "reset", "--quiet", "--hard", adoption.head)
    return adoption


def kanban_cards() -> list[dict]:
    """The cards on this card's board, read from its database without writing.

    `hermes kanban list` first recomputes which cards are ready, a write that Hermes refuses from this fenced
    process, so the board database is read directly, through `kanban_board`, which reads one consistent
    snapshot or raises, and never writes."""
    path = os.environ.get("HERMES_KANBAN_DB")
    if not path:
        raise Refusal("HERMES_KANBAN_DB is not set, so the board cannot be read")
    return kanban_board.cards(path)


def blocker_wait(client, issue_id: str, ignored: list[str]) -> tuple[list[str], str | None]:
    """The live blocker cards this card waits for, and the error that ended the check early.

    A failed check never stops the card: it runs as it did before blockers were read."""
    try:
        return blockers.waiting_on(lambda: client.blockers(issue_id), kanban_cards, ignored), None
    except Exception as error:
        message = f"{type(error).__name__}: {error}"
        print(f"claude-session: the blocker check failed, so the card runs: {message}", file=sys.stderr)
        return [], message


def person_pushed_after(gh, repo: str, person: dict, factory: dict) -> bool:
    """True unless the factory's pull request carries all of the person's work.

    The work is carried when the person's head is an ancestor of the factory's head. When the factory squashed
    and the ancestry is gone, it is carried when the person's branch, in this repository, saw no activity after
    the factory's pull request opened. Commit dates play no part, because a commit can be pushed long after it
    was made. A branch in a fork has no activity here, so it is never carried.
    """
    compare = gh(f"repos/{repo}/compare/{factory['head']['sha']}...{person['head']['sha']}?per_page=1")
    if compare["status"] in ("behind", "identical"):
        return False
    if compare["status"] != "diverged":
        return True
    if ((person["head"].get("repo") or {}).get("full_name") or "").lower() != repo.lower():
        return True
    ref = quote(person["head"]["ref"], safe="/")
    records = gh(f"repos/{repo}/activity?ref=refs/heads/{ref}&per_page=1")
    return not records or records[0]["timestamp"] > factory["created_at"]


def supersede_takeover(repo: str, branch: str, takeover_pr: str | None, login: str | None, gh=card_branch.run_gh) -> dict | None:
    """Close the person's takeover pull request once the factory's own pull request for the branch is open.

    Runs after each Claude turn, so a pull request opened later in the card is still caught. The result goes
    in the run's report and never changes its status, because a person closes a pull request by hand when
    this fails.
    """
    if not takeover_pr:
        return None
    result = {"pr": takeover_pr}
    try:
        if not login:
            raise card_branch.GhFailed("github.login is not set in the settings")
        match = PULL_URL.match(takeover_pr)
        if not match or match.group(1).lower() != repo.lower():
            return {**result, "action": "left", "reason": f"it is not a pull request in {repo}"}
        number = match.group(2)
        owner_name = repo.split("/")[0]
        open_pulls = gh(f"repos/{repo}/pulls?state=open&head={owner_name}:{branch}&per_page=100")
        factory = next((pull for pull in open_pulls if card_branch.is_app(pull["user"]["login"], login)), None)
        if factory is None:
            return {**result, "action": "waiting", "reason": f"no open pull request by {login} on {branch}"}
        person = gh(f"repos/{repo}/pulls/{number}")
        if person["state"] != "open":
            return {**result, "action": "left", "reason": f"it is already {person['state']}"}
        if card_branch.is_app(person["user"]["login"], login):
            return {**result, "action": "left", "reason": "the App authored it"}
        if person_pushed_after(gh, repo, person, factory):
            return {**result, "action": "left", "reason": "person pushed after takeover"}
        line = f"Supersedes #{number}"
        body = factory.get("body") or ""
        if not re.search(rf"Supersedes\s+(#{number}\b|{re.escape(takeover_pr)})", body):
            try:
                gh(f"repos/{repo}/pulls/{factory['number']}", "-X", "PATCH", "-f", f"body={body}\n\n{line}.".strip())
            except card_branch.GhFailed as failure:
                result["body_error"] = str(failure)
        gh(f"repos/{repo}/pulls/{number}", "-X", "PATCH", "-f", "state=closed")
        result.update(action="closed", replacement=factory["html_url"])
        try:
            gh(f"repos/{repo}/issues/{number}/comments", "-X", "POST", "-f",
               f"body=The factory opened #{factory['number']} from this pull request's work, so this one is closed "
               f"and review continues there: {factory['html_url']}")
        except card_branch.GhFailed as failure:
            result["comment_error"] = str(failure)
        return result
    except (card_branch.GhFailed, json.JSONDecodeError, KeyError, TypeError) as failure:
        return {**result, "action": "failed", "error": str(failure)}


def link_issues(
    repo: str, branch: str, login: str | None, identifier: str, linear_url: str, github_issue: str | None,
    gh=card_branch.run_gh,
) -> dict:
    """Give the factory's open pull request for the branch a closing reference to each of the card's issues.

    Runs after each Claude turn, like supersede_takeover. A bare Linear identifier after a closing keyword
    becomes the issue's URL, and one closing line names whatever is still missing, so no issue gets a second
    closing reference. The result goes in the run's report and never changes its status.
    """
    try:
        if not login:
            raise card_branch.GhFailed("github.login is not set in the settings")
        open_pulls = gh(f"repos/{repo}/pulls?state=open&head={repo.split('/')[0]}:{branch}&per_page=100")
        pull = next((pull for pull in open_pulls if card_branch.is_app(pull["user"]["login"], login)), None)
        if pull is None:
            return {"action": "waiting", "reason": f"no open pull request by {login} on {branch}"}
        result = {"pr": pull["html_url"]}
        body = pull.get("body") or ""
        key = re.escape(identifier) + r"(?![0-9])"
        linear = rf"https://linear\.app/[^/\s]+/issue/{key}"
        edited = re.sub(rf"({CLOSING_KEYWORD}){key}", lambda m: m.group(1) + linear_url, body, flags=re.I)
        # A reference left inside the template's HTML comment does not render, so it does not count.
        visible = HTML_COMMENT.sub("", edited)
        missing = []
        issue = ISSUE_URL.match(github_issue or "")
        if issue:
            issue_repo, number = issue.groups()
            refs = [re.escape(f"{issue_repo}#{number}"), re.escape(f"https://github.com/{issue_repo}/issues/{number}")]
            if issue_repo.lower() == repo.lower():
                refs.append(f"#{number}")
            if not re.search(rf"{CLOSING_KEYWORD}(?:{'|'.join(refs)})(?![0-9])", visible, re.I):
                missing.append(f"#{number}" if issue_repo.lower() == repo.lower() else f"{issue_repo}#{number}")
        if not re.search(CLOSING_KEYWORD + linear, visible, re.I):
            missing.append(linear_url)
        if missing:
            edited = f"{edited.rstrip()}\n\nCloses {', closes '.join(missing)}".strip()
        if edited == body:
            return {**result, "action": "unchanged"}
        gh(f"repos/{repo}/pulls/{pull['number']}", "-X", "PATCH", "-f", f"body={edited}")
        return {**result, "action": "linked"}
    except (card_branch.GhFailed, json.JSONDecodeError, KeyError, TypeError) as failure:
        return {"action": "failed", "error": str(failure)}


def load_settings(settings_file: str | None) -> dict:
    if settings_file:
        return json.loads(Path(settings_file).read_text())
    proc = subprocess.run(
        ["hermes", "config", "get", SETTINGS_KEY, "--json", "--raw"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Refusal(f"hermes config get {SETTINGS_KEY} failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def find_repository(settings: dict, full_name: str) -> dict:
    for repo in settings.get("repositories") or []:
        if repo.get("full_name") == full_name:
            return repo
    raise Refusal(f"repository {full_name} is not configured")


def resolve_worktree(workspace: str, repo_path: str) -> Path:
    worktree = Path(workspace).resolve()
    if not worktree.is_dir():
        raise Refusal(f"workspace {worktree} does not exist")
    if Path(git(worktree, "rev-parse", "--show-toplevel")).resolve() != worktree:
        raise Refusal(f"workspace {worktree} is not the root of a git worktree")
    main = Path(repo_path).resolve()
    common = Path(git(worktree, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    repo_common = Path(git(main, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    if common != repo_common:
        raise Refusal(f"workspace {worktree} does not belong to the repository at {main}")
    if worktree == main:
        raise Refusal(f"workspace {worktree} is the main checkout, not a Kanban worktree")
    return worktree


def claude_config_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(configured) if configured else Path.home() / ".claude"


def trust_checkout(main: Path) -> None:
    """Persist Claude Code's workspace trust for the main checkout, which keys trust for its worktrees.

    Without it, Claude Code skips the repository's MCP headersHelper commands. Nobody accepts a trust dialog
    on a factory machine, so the run records it. The file is rewritten only when the flag is missing."""
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    path = Path(configured) / ".claude.json" if configured else Path.home() / ".claude.json"
    config = json.loads(path.read_text()) if path.exists() else {}
    project = config.setdefault("projects", {}).setdefault(str(main), {})
    if project.get("hasTrustDialogAccepted") is True:
        return
    project["hasTrustDialogAccepted"] = True
    path.parent.mkdir(parents=True, exist_ok=True)
    staged = path.with_name(f"{path.name}.claude-session-{os.getpid()}")
    write_private(staged, config)
    os.replace(staged, path)


def transcript_cwd(transcript: Path) -> str | None:
    with open(transcript, encoding="utf-8") as lines:
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if isinstance(entry, dict) and entry.get("cwd"):
                return entry["cwd"]
    return None


def find_transcript(session_id: str, worktree: Path) -> Path | None:
    # Claude Code resumes only a session started in the same working directory, so a new card's
    # worktree starts a fresh session even though the issue's session ID is the same.
    transcripts = (claude_config_dir() / "projects").glob(f"*/{session_id}.jsonl")
    return next((t for t in transcripts if transcript_cwd(t) == str(worktree)), None)


def session_key(issue_id: str, triage: bool) -> str:
    return f"linear-triage:{issue_id}" if triage else f"linear-issue:{issue_id}"


def session_id_for(key: str, generation: int) -> str:
    # A fresh start takes the next generation, because `--session-id` refuses an ID whose transcript exists.
    return str(uuid.uuid5(uuid.NAMESPACE_URL, key if generation == 0 else f"{key}:{generation}"))


def main_messages(transcript: Path, offset: int = 0) -> Iterator[dict]:
    with open(transcript, "rb") as lines:
        lines.seek(offset)
        for line in lines:
            try:
                entry = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            message = entry.get("message") if isinstance(entry, dict) and entry.get("type") == "assistant" else None
            if isinstance(message, dict) and not entry.get("isSidechain") and message.get("model") != "<synthetic>":
                yield message


def context_tokens(message: dict) -> int | None:
    usage = message.get("usage")
    parts = [usage.get(key) for key in USAGE_KEYS] if isinstance(usage, dict) else []
    ok = len(parts) == len(USAGE_KEYS) and all(isinstance(part, int) and not isinstance(part, bool) for part in parts)
    return sum(parts) if ok else None


def last_assistant(transcript: Path) -> tuple[int | None, str | None]:
    tokens = text = None
    for message in main_messages(transcript):
        tokens = context_tokens(message)
        content = message.get("content")
        blocks = content if isinstance(content, list) else []
        said = "\n".join(b["text"] for b in blocks if isinstance(b, dict) and isinstance(b.get("text"), str)).strip()
        text = said or None
    return tokens, text


def first_context(transcript: Path | None, offset: int) -> int | None:
    if transcript is None:
        return None
    return next((context_tokens(message) for message in main_messages(transcript, offset)), None)


def model_usage(output: dict) -> dict | None:
    """Copy only the token counts from claude's per-model usage, which includes every subagent's calls."""
    models = output.get("modelUsage")
    if not isinstance(models, dict):
        return None
    return {
        model: {key: counts.get(name) for key, name in MODEL_USAGE_KEYS}
        for model, counts in models.items() if isinstance(counts, dict)
    }


def fresh_after_tokens(transport: dict) -> int:
    value = transport.get("fresh_after_tokens", DEFAULT_FRESH_AFTER_TOKENS)
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise Refusal(f"claude_session.fresh_after_tokens {value!r} must be a positive integer")
    return value


def plan_session(key: str, worktree: Path, threshold: int, now: float) -> SessionPlan:
    generation, latest = 0, None
    while found := find_transcript(session_id_for(key, generation), worktree):
        latest, generation = found, generation + 1
    if latest is None:
        return SessionPlan(session_id_for(key, 0), False, "new", None, None, None)
    previous_id = session_id_for(key, generation - 1)
    if now - latest.stat().st_mtime <= CACHE_TTL_SECONDS:
        return SessionPlan(previous_id, True, "warm", previous_id, latest, None)
    tokens, text = last_assistant(latest)
    if tokens is not None and tokens < threshold:
        return SessionPlan(previous_id, True, "small", previous_id, latest, None)
    reason = "fresh-unreadable" if tokens is None else "fresh-large-idle"
    return SessionPlan(session_id_for(key, generation), False, reason, previous_id, latest, text)


def session_process_running(session_id: str) -> bool:
    listing = subprocess.run(["ps", "-Ao", "pid=,command="], capture_output=True, text=True, check=True)
    for line in listing.stdout.splitlines():
        pid, _, command = line.strip().partition(" ")
        if pid != str(os.getpid()) and session_id in command:
            return True
    return False


def version_key(name: str) -> tuple:
    return tuple(int(part) for part in name.lstrip("v").split("."))


def node_bin_for(worktree: Path) -> Path | None:
    nvmrc = worktree / ".nvmrc"
    if not nvmrc.is_file():
        return None
    spec = nvmrc.read_text().strip().lstrip("v")
    if not spec.replace(".", "").isdigit():
        raise Refusal(f".nvmrc version {spec!r} is not a numeric version prefix")
    nvm_dir = Path(os.environ.get("NVM_DIR") or Path.home() / ".nvm")
    matches = [
        d for d in (nvm_dir / "versions" / "node").glob("v*")
        if d.name[1:] == spec or d.name[1:].startswith(spec + ".")
    ]
    if not matches:
        raise Refusal(f"Node {spec} from .nvmrc is not installed under {nvm_dir}; run nvm install {spec}")
    return max(matches, key=lambda d: version_key(d.name)) / "bin"


MODEL_TIERS = ("sonnet", "haiku", "fable")


# What Claude Code and the tools it runs need: a shell, locale, temp dir, the worker's gh login, its
# own config dir, and where the Java, Android, and Xcode toolchains live. Nothing else from the worker's
# environment crosses, so no secret can.
CHILD_ENV_NAMES = frozenset({
    "PATH", "HOME", "USER", "LOGNAME", "SHELL", "TERM", "LANG", "TMPDIR", "TZ", "NVM_DIR",
    "GH_CONFIG_DIR", "CLAUDE_CONFIG_DIR", "CLAUDE_CODE_DISABLE_TERMINAL_TITLE",
    "JAVA_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT", "DEVELOPER_DIR",
})
CHILD_ENV_PREFIXES = ("LC_",)


def child_env(worktree: Path) -> dict:
    env = {
        name: value for name, value in os.environ.items()
        if name in CHILD_ENV_NAMES or name.startswith(CHILD_ENV_PREFIXES)
    }
    node_bin = node_bin_for(worktree)
    if node_bin:
        env["PATH"] = f"{node_bin}{os.pathsep}{env.get('PATH', '')}"
    return env


def check_toolchain(repo: dict, worktree: Path) -> None:
    """Run the repository's toolchain checks in the environment Claude Code gets, and refuse on a failure."""
    checks = repo.get("toolchain_checks") or []
    if not isinstance(checks, list) or not all(isinstance(check, str) for check in checks):
        raise Refusal(f"toolchain_checks {checks!r} must be a list of shell commands")
    env = child_env(worktree)
    for check in checks:
        try:
            result = subprocess.run(
                ["/bin/sh", "-c", check], cwd=worktree, env=env, stdin=subprocess.DEVNULL,
                capture_output=True, text=True, timeout=TOOLCHAIN_CHECK_SECONDS,
            )
        except subprocess.TimeoutExpired:
            raise Refusal(f"toolchain check {check!r} did not finish in {TOOLCHAIN_CHECK_SECONDS}s") from None
        if result.returncode != 0:
            output = (result.stderr or result.stdout).strip()[-500:] or "no output"
            raise Refusal(
                f"toolchain check {check!r} failed with exit {result.returncode} "
                f"in the environment Claude Code gets: {output}"
            )


def import_plugin(name: str, module: str) -> None:
    """Put the worker home's copy of plugin `name` on the import path, so its `module` imports."""
    home = os.environ.get("HERMES_HOME")
    if not home:
        raise Refusal(f"HERMES_HOME is not set; claude-session imports {module} from the worker home's {name} plugin")
    plugin = Path(home) / "plugins" / name
    if not (plugin / f"{module}.py").is_file():
        raise Refusal(f"the {name} plugin is not installed in {home}")
    sys.path.insert(0, str(plugin))


def linear_access() -> tuple:
    """A client and a token from the worker home's linear-agent-session plugin, which gets tokens from the gateway's broker."""
    import_plugin("linear-agent-session", "linear")
    import linear

    try:
        client = linear.client_from_env()
        return client, client.access_token()
    except linear.LinearError as error:
        raise Refusal(f"Linear token: {error}", transient=isinstance(error, linear.BrokerUnavailable)) from None


def triage_playbook() -> Path:
    """The playbook that the worker home's factory checkout vendors, whatever the triaged repository vendors."""
    try:
        playbook = factory_source.checkout(Path(os.environ["HERMES_HOME"])) / factory_source.TRIAGE_PLAYBOOK
    except factory_source.SourceError as error:
        raise Refusal(f"the factory checkout: {error}") from None
    if not playbook.is_file():
        raise Refusal(f"{playbook} does not exist, so a triage card cannot follow the triage playbook")
    return playbook


def title_triage_documents(client, issue_id: str) -> dict:
    """Rename only the run's own prefixed Documents, and only when no Document has the exact title.

    The result goes in the run's report and never changes its status: a failure here must not lose the
    triage outcome that the worker relays.
    """
    import linear

    try:
        issue = client.issue_documents(issue_id)
        titles = {document["title"] for document in issue["documents"]}
        renamed, missing = [], []
        for title in TRIAGE_DOCUMENTS:
            prefixed = f"{issue['identifier']} {title}"
            own = [d for d in issue["documents"] if d["own"] and d["title"] == prefixed]
            if title not in titles and own:
                client.rename_document(own[0]["id"], title)
                renamed.append(prefixed)
            elif title not in titles and prefixed not in titles:
                missing.append(title)
    except (linear.LinearError, OSError) as error:
        return {"error": f"checking the triage Documents failed: {error}"}
    return {"renamed": renamed, "missing": missing}


def triage_mentions(client, issue_id: str, identifier: str) -> str:
    """Resolved here, not by the model, because a team can list several triage people and the model picked one."""
    import linear

    try:
        people = client.triage_people(issue_id)
    except (linear.LinearError, OSError) as error:
        raise Refusal(f"reading who answers Linear issue {identifier}'s triage questions failed: {error}") from None
    owner = people["assignee"] or people["triage"]
    reporter = people["creator"] or owner
    if owner is None and reporter is None:
        return ("Linear names no assignee, person creator, or current triage person for this issue, so mention "
                "no one: the questions still reach the issue's agent session.")
    if owner is None:
        return (f"Ask {reporter} each question only the reporter can answer, such as steps to reproduce "
                "or their environment. Linear names no assignee and no current triage person, so mention no one "
                "for the other questions.")
    return (f"Ask {owner} each scope, design, or decision question. Ask {reporter} each question "
            "only the reporter can answer, such as steps to reproduce or their environment.")


def require_ready(client, issue_id: str, identifier: str) -> None:
    import linear

    try:
        labels = client.issue_labels(issue_id)
    except linear.LinearError as error:
        raise Refusal(f"reading the labels of Linear issue {identifier} failed: {error}") from None
    if linear.role_key(READY_LABEL) in map(linear.role_key, labels):
        return
    try:
        live = client.role_labels(issue_id).get(READY_LABEL)
    except linear.LinearError as error:
        raise Refusal(f"reading the labels of Linear issue {identifier} failed: {error}") from None
    wanted = f"`{live}`" if live else f"a label for the `{READY_LABEL}` role (Linear has none)"
    raise Refusal(
        f"Linear issue {identifier} does not carry {wanted}, so its implementation card does not start; "
        "it starts once the issue passes the readiness check"
    )


def triage_activity(client, issue_id: str, result: str | None) -> str | None:
    """The Linear activity that reports a triage outcome. Only a delegated issue that passes keeps its
    session open, because its implementation card continues on it; every other outcome ends the session."""
    first = (result or "").partition("\n")[0]
    if not first.startswith(TRIAGE_OUTCOME):
        return None
    import linear

    role = linear.role_key(first.removeprefix(TRIAGE_OUTCOME))
    if role not in map(linear.role_key, TRIAGE_ROLES):
        return None
    if role != linear.role_key(READY_LABEL):
        return "response"

    try:
        return "thought" if client.delegated_to_self(issue_id) else "response"
    except (linear.LinearError, OSError):
        # Ending a delegated issue's session under its implementation card is worse than leaving one open.
        return "thought"


def tier_models(transport: dict) -> dict:
    value = transport.get("tier_models")
    if value is None:
        return {}
    ok = isinstance(value, dict) and set(value) <= set(MODEL_TIERS) and all(
        isinstance(model, str) and model for model in value.values()
    )
    if not ok:
        raise Refusal(
            f"claude_session.tier_models {value!r} must map {', '.join(MODEL_TIERS)} to non-empty model ids"
        )
    return value


def model_environment(transport: dict, tiers: dict) -> dict:
    # The main loop and every tier without its own model stay on the transport model, because a proxy
    # answers `unknown provider for model ...` for an id it does not serve.
    model = transport["model"]
    env = {"ANTHROPIC_MODEL": model, "ANTHROPIC_DEFAULT_OPUS_MODEL": model}
    env.update({f"ANTHROPIC_DEFAULT_{tier.upper()}_MODEL": tiers.get(tier, model) for tier in MODEL_TIERS})
    # A subagent that names no model takes this alias. CLAUDE_CODE_SUBAGENT_MODEL_FORCE stays unset so
    # an explicit model on the Agent call still wins.
    env["CLAUDE_CODE_SUBAGENT_MODEL"] = "sonnet" if "sonnet" in tiers else model
    return env


def factory_mcp_servers(transport: dict) -> dict:
    if "sentry_token_env" in transport:
        raise Refusal("claude_session.sentry_token_env is replaced by claude_session.mcp_servers.sentry")
    servers = transport.get("mcp_servers") or {}
    if not isinstance(servers, dict):
        raise Refusal(f"claude_session.mcp_servers {servers!r} must map server names to servers")
    for name, server in servers.items():
        where = f"claude_session.mcp_servers.{name}"
        if name == "linear":
            raise Refusal(f"{where}: the factory owns the linear server")
        if not isinstance(server, dict) or not set(server) <= MCP_SERVER_KEYS:
            raise Refusal(f"{where} must be an object with only {', '.join(sorted(MCP_SERVER_KEYS))}")
        if not (isinstance(server.get("url"), str) and server["url"].startswith("https://")):
            raise Refusal(f"{where}.url must be an https URL")
        if not (isinstance(server.get("token_env"), str) and server["token_env"]):
            raise Refusal(f"{where}.token_env must name the gateway's variable that holds the token")
        scheme = server.get("scheme", "Bearer")
        if not (isinstance(scheme, str) and re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*", scheme)):
            raise Refusal(f"{where}.scheme must be one Authorization scheme word, such as Bearer")
        headers = server.get("headers", {})
        if not (isinstance(headers, dict) and all(isinstance(v, str) for v in headers.values())):
            raise Refusal(f"{where}.headers must map header names to fixed strings")
        if any(CREDENTIAL_NAME.search(header) for header in headers):
            raise Refusal(f"{where}.headers must hold no credential; mcp-headers sends the token as Authorization")
        url = urlsplit(server["url"])
        if "@" in url.netloc:
            raise Refusal(f"{where}.url must hold no userinfo; mcp-headers sends the token as Authorization")
        query = parse_qsl(url.query, keep_blank_values=True)
        if any(CREDENTIAL_NAME.search(key) for key, _ in query):
            raise Refusal(f"{where}.url must hold no credential in its query string; mcp-headers sends the token as Authorization")
        values = (*headers.values(), *(value for _, value in query))
        if any(AUTHORIZATION_VALUE.match(value) for value in values):
            raise Refusal(f"{where} must hold no Authorization scheme in a header value or URL query value; mcp-headers sends the token")
        if any(TOKEN_SHAPE.match(value) for value in values):
            raise Refusal(f"{where} must hold no known token prefix in a header value or URL query value; mcp-headers sends the token")
    return servers


def require_mcp_tokens(servers: dict) -> None:
    if not servers:
        return
    import linear

    try:
        status = linear.broker_request(linear.broker_socket_path(os.environ), "status")
    except linear.LinearError as error:
        raise Refusal(f"MCP tokens: {error}", transient=isinstance(error, linear.BrokerUnavailable)) from None
    present = status.get("mcp_tokens_present") or {}
    missing = sorted(name for name in servers if present.get(name) is not True)
    if missing:
        raise Refusal(f"MCP tokens: the gateway's broker holds no token for {', '.join(missing)}")


def helper_command(helper: Path) -> str:
    """HERMES_HOME is not in Claude Code's allowlisted environment, so the command sets it for the helper."""
    home = shlex.quote(os.environ["HERMES_HOME"])
    return f"HERMES_HOME={home} {shlex.quote(sys.executable)} {shlex.quote(str(helper))}"


def mcp_config(servers: dict) -> str:
    config = {"linear": LINEAR_MCP_SERVER}
    for name, server in servers.items():
        helper = f"{helper_command(MCP_HEADERS_HELPER)} {shlex.quote(name)} {shlex.quote(server.get('scheme', 'Bearer'))}"
        config[name] = {"type": "http", "url": server["url"], "headersHelper": helper}
        if server.get("headers"):
            config[name]["headers"] = server["headers"]
    return json.dumps({"mcpServers": config})


def disabled_mcp_servers(transport: dict) -> list[str]:
    value = transport.get("disabled_mcp_servers") or []
    if not isinstance(value, list) or not all(isinstance(name, str) and name for name in value):
        raise Refusal(f"claude_session.disabled_mcp_servers {value!r} must be a list of MCP server names")
    return value


def publish_denials() -> list[str]:
    push_signed = Path(__file__).resolve().with_name("push-signed")
    return [
        "Bash(git push:*)",
        f"Bash(python3 {push_signed}:*)",
        f"Bash({push_signed}:*)",
        "Bash(gh pr create:*)",
    ]


def claude_settings(transport: dict, api_key: str, path: Path, triage: bool = False) -> dict:
    # Passed with --settings because Claude Code lets a user-level
    # ~/.claude/settings.json env block override the process environment.
    # Claude Code sends every MCP schema inline when ANTHROPIC_BASE_URL is not Anthropic's,
    # unless tool search is forced on; deferred schemas keep the worker's fixed prefix small.
    env = {"LINEAR_API_KEY": api_key, "ENABLE_TOOL_SEARCH": "true"}
    if transport.get("base_url"):
        env["ANTHROPIC_BASE_URL"] = transport["base_url"]
    tiers = tier_models(transport)
    if transport.get("model"):
        env.update(model_environment(transport, tiers))
    # Claude Code applies the env block once at startup, so the file can go as soon as the session starts.
    remove = {"type": "command", "command": f"rm -f -- {shlex.quote(str(path))}"}
    # A refused CI wait keeps the worker inside the prompt cache; see guard-ci-wait.
    # A refused commit or publish keeps a commit from closing an issue the pull request body does not; see guard-commit-closes.
    guards = [
        {"type": "command", "command": f"{shlex.quote(sys.executable)} {shlex.quote(str(script))}"}
        for script in (CI_WAIT_GUARD, COMMIT_CLOSES_GUARD)
    ]
    settings = {"env": env, "hooks": {
        "SessionStart": [{"hooks": [remove]}],
        "PreToolUse": [{"matcher": "Bash", "hooks": guards}],
    }}
    if transport.get("auth_token_env"):
        settings["apiKeyHelper"] = helper_command(PROXY_TOKEN_HELPER)
    disabled = disabled_mcp_servers(transport)
    if disabled:
        settings["disabledMcpjsonServers"] = disabled
    if triage:
        # Deny rules hold under --permission-mode bypassPermissions.
        settings["permissions"] = {"deny": publish_denials()}
    return settings


def remove_on_stop(path: Path) -> None:
    """Remove the settings file on SIGTERM, SIGINT, or SIGHUP, then unwind so claude is ended too."""
    def stop(signum: int, _frame) -> None:
        for each in STOP_SIGNALS:
            signal.signal(each, signal.SIG_IGN)
        path.unlink(missing_ok=True)
        raise Stopped(signum)

    for signum in STOP_SIGNALS:
        signal.signal(signum, stop)


def write_private(path: Path, settings: dict) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(settings, handle)


def max_turns_args(transport: dict) -> list[str]:
    value = transport.get("max_turns")
    if value is None or value == 0:
        return []
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise Refusal(f"claude_session.max_turns {value!r} must be a positive integer, or 0 for no limit")
    return ["--max-turns", str(value)]


def worker_entry_prefix(repo: dict) -> str:
    prefix = repo.get("worker_entry") or ""
    if "{" in prefix:
        raise Refusal(
            f"worker_entry {prefix!r} must be a plain prefix such as /patina-mode; "
            "claude-session adds the issue, URL, repository, and branch itself"
        )
    return prefix


def handoff_text(plan: SessionPlan, branch: str, head: str, triage: bool = False) -> str | None:
    if plan.previous is None or plan.resumed:
        return None
    last = plan.last_result
    result = (
        f"The previous session ended with this message:\n\n{last[-HANDOFF_RESULT_CHARS:]}"
        if last else "The previous session left no final message."
    )
    if triage:
        return TRIAGE_HANDOFF.format(transcript=plan.previous, result=result)
    return HANDOFF.format(branch=branch, head=head, transcript=plan.previous, result=result)


def read_card(card_json: str | None, task_id: str) -> dict:
    if card_json:
        return json.loads(Path(card_json).read_text())
    proc = subprocess.run(["hermes", "kanban", "show", task_id, "--json"], capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"hermes kanban show {task_id} failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def github_issue_url(card: dict) -> str | None:
    """The `github_issue_url:` line that triage writes into the card body when the issue has one."""
    match = GITHUB_ISSUE_LINE.search(card["task"]["body"] or "")
    return match.group(1) if match else None


def comment_key(comment: dict) -> list:
    return [comment["created_at"], comment["author"], comment["body"]]


def unseen_comments(comments: list[dict], seen: list[list], own: str) -> str:
    """The card comments Claude has not been shown, as one message, or "" when there are none.

    A run gets every comment not yet in `seen`, whenever it was written: before the first run,
    while the card waited in ready, blocked, or triage, or during an earlier run. A time boundary
    such as "since the last run started" loses the comments on one side of it.
    """
    fresh = [
        c for c in comments
        if comment_key(c) not in seen and c["author"] != own and (c["body"] or "").strip()
    ]
    if not fresh:
        return ""
    bodies = [c["body"].strip() for c in fresh]
    capped = [b[:COMMENT_LIMIT] for b in bodies]
    kept = len(capped)
    while kept > 1 and sum(map(len, capped[-kept:])) > COMMENTS_LIMIT:
        kept -= 1
    dropped = len(capped) - kept
    shortened = sum(len(b) > COMMENT_LIMIT for b in bodies[-kept:])
    notice = (
        [COMMENTS_CUT.format(shortened=shortened, each=COMMENT_LIMIT, dropped=dropped)] if shortened or dropped else []
    )
    quoted = ("\n".join(f"> {line}" for line in b.splitlines()) for b in capped[-kept:])
    return "\n\n".join([COMMENTS_INTRO, *notice, *(f"{c['author']} wrote:\n{q}" for c, q in zip(fresh[-kept:], quoted))])


def build_prompt(
    args: argparse.Namespace, prefix: str, branch: str, resumed: bool, adopted: Adoption | None, handoff: str | None,
    comments: str, triage: bool = False,
) -> str:
    message = "\n\n".join(filter(None, [Path(args.message_file).read_text() if args.message_file else "", comments]))
    if resumed:
        return message or RESUME_PROMPT
    if triage:
        entry = TRIAGE_ENTRY.format(issue_identifier=args.issue_identifier, issue_url=args.issue_url, repo=args.repo)
        if prefix:
            entry = f"{prefix} {entry}"
        return "\n\n".join(filter(None, [entry, handoff, message]))
    entry = DEFAULT_WORKER_ENTRY.format(
        issue_id=args.issue_id,
        issue_identifier=args.issue_identifier,
        issue_url=args.issue_url,
        branch=branch,
        repo=args.repo,
    )
    if prefix:
        entry = f"{prefix} {entry}"
    if args.takeover_pr:
        start = TAKEOVER_START.get(adopted.source) if adopted else None
        takeover = " ".join(filter(None, [TAKEOVER_INTRO, start, TAKEOVER_RULES]))
        entry = f"{entry}\n\n{takeover.format(url=args.takeover_pr)}"
    return "\n\n".join(filter(None, [entry, handoff, message]))


def run_claude(command: list[str], worktree: Path) -> tuple[dict | None, int, str]:
    """Run claude in its own process group, stop reading at its result, and end every process it leaves.

    Returns the parsed result, claude's exit code, and the tail of its output for an error report.
    """
    with tempfile.TemporaryFile() as stderr:
        proc = subprocess.Popen(
            command,
            cwd=worktree,
            env=child_env(worktree),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=stderr,
            start_new_session=True,
        )
        with proc:
            try:
                output, stdout = read_result(proc)
            finally:
                leftovers = end_run(proc)
        if leftovers:
            print(f"claude-session: ended {len(leftovers)} process(es) left by claude: {sorted(leftovers)}", file=sys.stderr)
        stderr.seek(0)
        detail = (stderr.read() or stdout).decode(errors="replace").strip()[-2000:]
    return output, proc.returncode, detail


def read_result(proc: subprocess.Popen) -> tuple[dict | None, bytes]:
    # Stop at the first complete JSON document instead of waiting for EOF: claude may keep running
    # after it prints its result, and a child that inherited the pipe keeps it open after claude exits.
    fd = proc.stdout.fileno()
    buffer = b""
    while True:
        readable, _, _ = select.select([fd], [], [], QUIET_SECONDS)
        if not readable:
            if proc.poll() is not None:
                return None, buffer
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            return None, buffer
        buffer += chunk
        try:
            output = json.loads(buffer)
        except ValueError:
            continue
        if isinstance(output, dict):
            return output, buffer


def run_processes(root: int) -> set[int]:
    """Every process in claude's process group, plus its descendants that moved to their own group."""
    listing = subprocess.run(["ps", "-Ao", "pid=,ppid=,pgid="], capture_output=True, text=True, check=True)
    rows = [tuple(int(field) for field in line.split()) for line in listing.stdout.splitlines() if line.strip()]
    pids = {pid for pid, _, pgid in rows if pgid == root}
    pending = [root]
    while pending:
        parent = pending.pop()
        for pid, ppid, _ in rows:
            if ppid == parent and pid not in pids:
                pids.add(pid)
                pending.append(pid)
    return pids


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def all_gone(proc: subprocess.Popen, pids: set[int]) -> bool:
    deadline = time.monotonic() + GRACE_SECONDS
    while time.monotonic() < deadline:
        if proc.poll() is not None and not any(process_exists(pid) for pid in pids):
            return True
        time.sleep(0.1)
    return False


def end_run(proc: subprocess.Popen) -> set[int]:
    """Terminate claude and everything it started, with SIGKILL after a grace period. Returns the leftovers."""
    leftovers: set[int] = set()
    for signum in (signal.SIGTERM, signal.SIGKILL):
        leftovers |= run_processes(proc.pid) - {proc.pid}
        for pid in leftovers | {proc.pid}:
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass
        if all_gone(proc, leftovers):
            break
    proc.wait()
    return leftovers


def run(args: argparse.Namespace) -> tuple[int, result_line.Report]:
    import result_line

    workspace = os.environ.get("HERMES_KANBAN_WORKSPACE")
    if not workspace:
        raise Refusal("HERMES_KANBAN_WORKSPACE is not set; claude-session runs only inside a Kanban worker")
    triage = os.environ.get("HERMES_KANBAN_BOARD") == TRIAGE_BOARD
    settings = load_settings(args.settings_json)
    repo = find_repository(settings, args.repo)
    transport = settings.get("claude_session") or {}
    turn_limit = max_turns_args(transport)
    servers = factory_mcp_servers(transport)
    threshold = fresh_after_tokens(transport)
    prefix = worker_entry_prefix(repo)
    worktree = resolve_worktree(workspace, repo["path"])
    check_toolchain(repo, worktree)
    lock_path = Path(git(worktree, "rev-parse", "--absolute-git-dir")) / LOCK_NAME
    with open(lock_path, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refusal(f"another claude-session holds {worktree}") from None
        settings_path = lock_path.with_name(SETTINGS_FILE_NAME)
        # A killed run leaves its file behind; os.open would also keep that file's mode.
        settings_path.unlink(missing_ok=True)
        remove_on_stop(settings_path)
        client, api_key = linear_access()
        require_mcp_tokens(servers)
        mcp = mcp_config(servers)
        if triage:
            system_prompt = TRIAGE_SYSTEM_PROMPT.format(
                triage_playbook=triage_playbook(),
                mentions=triage_mentions(client, args.issue_id, args.issue_identifier),
            )
        else:
            require_ready(client, args.issue_id, args.issue_identifier)
            system_prompt = SYSTEM_PROMPT.format(
                push_signed=Path(__file__).resolve().with_name("push-signed"),
                upload_image=Path(__file__).resolve().with_name("github-upload-image"),
                wait_for_checks=Path(__file__).resolve().with_name("wait-for-checks"),
            )
        plan = plan_session(session_key(args.issue_id, triage), worktree, threshold, time.time())
        session_id = plan.session_id
        for running_id in filter(None, [plan.previous_id, session_id]):
            if session_process_running(running_id):
                raise Refusal(f"a process for Claude session {running_id} is already running")

        blocker_error = None
        if not triage and plan.reason == "new":
            waiting, blocker_error = blocker_wait(client, args.issue_id, args.ignore_blockers)
            if waiting:
                return 0, result_line.Waiting(tuple(waiting))

        branch = git(worktree, "rev-parse", "--abbrev-ref", "HEAD")
        login = (settings.get("github") or {}).get("login")
        adopted = None if triage else adopt_existing_work(worktree, branch, args.repo, args.takeover_pr, login)
        handoff = handoff_text(plan, branch, git(worktree, "rev-parse", "HEAD"), triage)
        # A successful run marks this snapshot as seen, so a comment that lands mid-run goes to the next run.
        card = read_card(args.card_json, args.task_id)
        comments = card["comments"]
        seen_path = lock_path.with_name(COMMENTS_SEEN_NAME)
        seen = json.loads(seen_path.read_text()) if seen_path.exists() else []
        own = os.environ.get("HERMES_PROFILE") or Path(os.environ.get("HERMES_HOME", "")).name
        command = [
            os.environ.get("CLAUDE_BIN", "claude"),
            "-p", build_prompt(
                args, prefix, branch, plan.resumed, adopted, handoff, unseen_comments(comments, seen, own), triage
            ),
            "--output-format", "json",
            *turn_limit,
            "--permission-mode", "bypassPermissions",
            "--resume" if plan.resumed else "--session-id", session_id,
            "--append-system-prompt", system_prompt,
            "--mcp-config", mcp,
        ]
        if transport.get("model"):
            command += ["--model", transport["model"]]
        command += ["--settings", str(settings_path)]
        trust_checkout(Path(repo["path"]).resolve())
        offset = plan.previous.stat().st_size if plan.resumed else 0
        try:
            write_private(settings_path, claude_settings(transport, api_key, settings_path, triage))
            output, exit_code, detail = run_claude(command, worktree)
        finally:
            settings_path.unlink(missing_ok=True)
        if output is not None:
            seen_path.write_text(json.dumps([*seen, *map(comment_key, comments)]))
        superseded = links = None
        if output is not None and not triage:
            superseded = supersede_takeover(args.repo, branch, args.takeover_pr, login)
            links = link_issues(
                args.repo, branch, login, args.issue_identifier, args.issue_url, github_issue_url(card)
            )
        documents = title_triage_documents(client, args.issue_id) if output is not None and triage else None
        first = first_context(find_transcript(session_id, worktree), offset) if output is not None else None

    session = result_line.Session(
        session_id=session_id, resumed=plan.resumed, reason=plan.reason, worktree=str(worktree), branch=branch,
        adopted=adopted._asdict() if adopted else None, superseded=superseded, issue_links=links,
        triage_documents=documents,
    )
    if output is None:
        error = f"claude exited {exit_code} without JSON output: {detail}"
        return 1, result_line.Failed(error, session, blocker_error=blocker_error)
    outcome = result_line.Outcome(
        subtype=output.get("subtype"), num_turns=output.get("num_turns"), result=output.get("result"),
        usage=model_usage(output), first_context_tokens=first,
    )
    if outcome.subtype not in COMPLETED_SUBTYPES:
        error = f"claude run ended with {outcome.subtype} (exit {exit_code})"
        return 1, result_line.Failed(error, session, outcome, blocker_error)
    if not triage:
        return 0, result_line.Done(session, outcome, blocker_error)
    return 0, result_line.Done(session, outcome, blocker_error, triage_activity(client, args.issue_id, outcome.result))


def read_init(proc: subprocess.Popen, timeout: float) -> dict | None:
    """The first system init event claude prints, or None when its output ends without one."""
    fd = proc.stdout.fileno()
    deadline = time.monotonic() + timeout
    buffer = b""
    while True:
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict) and event.get("type") == "system" and event.get("subtype") == "init":
                return event
        left = deadline - time.monotonic()
        if left <= 0:
            raise Refusal(f"claude printed no init event within {timeout:g} s")
        if not select.select([fd], [], [], min(left, QUIET_SECONDS))[0]:
            if proc.poll() is not None:
                return None
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            return None
        buffer += chunk


def mcp_status(args: argparse.Namespace) -> tuple[int, dict]:
    settings = load_settings(args.settings_json)
    repo = find_repository(settings, args.repo)
    transport = settings.get("claude_session") or {}
    servers = factory_mcp_servers(transport)
    main = Path(repo["path"]).resolve()
    _, api_key = linear_access()
    require_mcp_tokens(servers)
    trust_checkout(main)
    with tempfile.TemporaryDirectory() as directory:
        path = Path(directory) / SETTINGS_FILE_NAME
        remove_on_stop(path)
        content = claude_settings({"disabled_mcp_servers": transport.get("disabled_mcp_servers")}, api_key, path)
        content["env"].update(ANTHROPIC_BASE_URL=UNREACHABLE_MODEL_URL, ANTHROPIC_AUTH_TOKEN="mcp-status-probe")
        content["disableAllHooks"] = True
        write_private(path, content)
        command = [
            os.environ.get("CLAUDE_BIN", "claude"), "-p", "Report MCP server status.",
            "--output-format", "stream-json", "--verbose", "--permission-mode", "bypassPermissions",
            "--no-session-persistence", "--mcp-config", mcp_config(servers), "--settings", str(path),
        ]
        with tempfile.TemporaryFile() as stderr:
            proc = subprocess.Popen(
                command, cwd=main, env=child_env(main), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=stderr, start_new_session=True,
            )
            with proc:
                try:
                    init = read_init(proc, args.timeout)
                finally:
                    end_run(proc)
            stderr.seek(0)
            detail = stderr.read().decode(errors="replace").replace(api_key, "[redacted]").strip()[-2000:]
    if init is None:
        return 1, {"error": f"claude exited {proc.returncode} without an init event: {detail}"}
    statuses = [{"name": each.get("name"), "status": each.get("status")} for each in init.get("mcp_servers") or []]
    return 0, {"repo": args.repo, "servers": statuses, "disabled": transport.get("disabled_mcp_servers") or []}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task-id", help="the Kanban card id; Hermes does not pass it in the environment")
    parser.add_argument("--issue-id")
    parser.add_argument("--issue-identifier")
    parser.add_argument("--issue-url")
    parser.add_argument("--mcp-status", action="store_true", help="print each MCP server's status and exit")
    parser.add_argument("--timeout", type=float, default=MCP_STATUS_SECONDS, help="--mcp-status deadline in seconds")
    parser.add_argument("--repo", required=True)
    parser.add_argument("--message-file")
    parser.add_argument("--takeover-pr")
    parser.add_argument(
        "--ignore-blockers", type=lambda ids: [i for i in ids.split(",") if i], default=[],
        help="comma-separated blocker card ids not to wait for, because linking them would close a cycle",
    )
    parser.add_argument("--settings-json")
    parser.add_argument("--card-json", help="a `hermes kanban show --json` file to read comments from, for tests")
    args = parser.parse_args()
    if not args.mcp_status:
        missing = [flag for flag in ("task_id", "issue_id", "issue_identifier", "issue_url") if not getattr(args, flag)]
        if missing:
            parser.error("the following arguments are required: " + ", ".join(f"--{f.replace('_', '-')}" for f in missing))
    try:
        import_plugin("blocker-order", "result_line")
    except Refusal as refusal:
        # Without the plugin no hook reads the line, so this error reaches only the worker.
        print(json.dumps({"error": str(refusal)}))
        return 2
    import result_line

    try:
        status, report = mcp_status(args) if args.mcp_status else run(args)
    except Stopped as stopped:
        signal.signal(stopped.signum, signal.SIG_DFL)
        os.kill(os.getpid(), stopped.signum)
        raise
    except Refusal as refusal:
        status, report = 2, result_line.Refused(str(refusal), refusal.transient)
    except Exception as error:
        status, report = 1, result_line.Refused(f"{type(error).__name__}: {error}")
    print(json.dumps(report) if isinstance(report, dict) else result_line.line(report))
    return status


if __name__ == "__main__":
    sys.exit(main())
