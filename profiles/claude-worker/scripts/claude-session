#!/usr/bin/env python3
"""Run one Claude Code turn for a Kanban card in its Hermes-owned worktree.

Prints exactly one JSON line on stdout. The Hermes worker that calls this
script relays the line to the board; this process is fenced from board
mutations, so it never touches Kanban itself.

Claude Code starts with the allowlisted environment in CHILD_ENV_NAMES and
CHILD_ENV_PREFIXES. Every credential it needs, the Linear token and the proxy
token, reaches it only through the per-run settings file, mode 0600. Claude Code
removes that file through a SessionStart hook as soon as it has read it.
claude-session also removes it before each run and when it ends, whether it
returns or stops on SIGTERM, SIGINT, or SIGHUP.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import select
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path
from typing import NamedTuple

SETTINGS_KEY = "plugins.entries.linear-agent-session.settings"
DEFAULT_WORKER_ENTRY = (
    "Work Linear issue {issue_identifier} ({issue_url}) in {repo} on branch {branch}. "
    "First start the issue through this repository's own issue-start workflow, which moves it to In Progress. "
    "Open a ready (non-draft) pull request and drive it until it is ready to merge."
)
TAKEOVER_INTRO = "The issue already has an open pull request, {url}, opened by someone else."
TAKEOVER_START = {
    "takeover_pr": "This branch starts from its head.",
    "remote_branch": "This branch holds the factory's own earlier commits, not that pull request's.",
}
TAKEOVER_RULES = (
    "Open your own ready pull request, and in its body credit the original author and link {url}. "
    "Do not close {url}. The worker closes it after a human approves. If push-signed refuses one of its "
    "commits, such as a merge commit, squash the pull request onto the default branch before you publish: "
    "check out the default branch under this branch's name, run `git merge --squash` with the pull "
    "request's head (fetch it again with `git fetch origin refs/pull/<number>/head` and use FETCH_HEAD), "
    "resolve conflicts once, and commit. Credit the original author with a "
    "Co-authored-by trailer on the commits you publish."
)
RESUME_PROMPT = "Continue."
HANDOFF = (
    "This card continues earlier work. Its previous Claude session sat idle past the prompt cache and had "
    "grown large, so this session starts fresh. The branch is {branch}, at commit {head}. Read the pull "
    "request's live state, review threads, and checks on that branch with `gh pr view` and `gh pr checks` "
    "before you act. The previous session's transcript is {transcript}; read it only for a decision you "
    "cannot find on GitHub or in the code. {result}"
)
PUBLISH_RULE = (
    "Publish commits only by running {push_signed} from the worktree, never `git push`. It creates "
    "commits that the GitHub App signs, which repositories requiring verified signatures need. To bring "
    "in the base branch, run `gh pr update-branch`, never a local merge."
)
LINEAR_RULE = (
    "Reach Linear only with the token in LINEAR_API_KEY, which the factory's Linear agent app issued for this "
    "run. Never mint a Linear token yourself and never run a secrets helper: a token request with another scope "
    "set revokes the factory's tokens."
)
CHECKS_RULE = (
    "A finished check never runs again by itself, and the GitHub App cannot re-request a check. When a "
    "check failed on a head that is behind the base branch, or a person says the cause of a failure is "
    "fixed, run `gh pr update-branch <number>` so every check runs again on a new head, then wait for "
    "that run before you judge the ready gate."
)
FINISH_RULE = (
    "Stop every background command, monitor, and watcher you started before you write your final result. "
    "The run ends when you finish, and anything still running is killed. To wait for CI, run a foreground "
    "command that ends on its own, such as `gh pr checks <number> --watch --fail-fast` with the tool's "
    "timeout set, and run it again when it times out."
)
SYSTEM_PROMPT = f"{PUBLISH_RULE}\n\n{LINEAR_RULE}\n\n{CHECKS_RULE}\n\n{FINISH_RULE}"
# Replaces a repository's own `linear` server, which has no credential in a headless run. Claude Code
# expands ${LINEAR_API_KEY} from the settings file's env, so the token never appears in argv.
LINEAR_MCP_CONFIG = json.dumps({"mcpServers": {"linear": {
    "type": "http",
    "url": "https://mcp.linear.app/mcp",
    "headers": {"Authorization": "Bearer ${LINEAR_API_KEY}"},
}}})
COMPLETED_SUBTYPES = frozenset({"success", "error_max_turns"})
CACHE_TTL_SECONDS = 300
DEFAULT_FRESH_AFTER_TOKENS = 100_000
HANDOFF_RESULT_CHARS = 2000
USAGE_KEYS = ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
QUIET_SECONDS = 1.0
GRACE_SECONDS = 10.0
TOOLCHAIN_CHECK_SECONDS = 120
LOCK_NAME = "claude-session.lock"
SETTINGS_FILE_NAME = "claude-session.settings.json"
STOP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
PULL_URL = re.compile(r"^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)$")


FACTORY, OTHER = "factory", "other"
REFUSE = "refuse"
# Keyed on (takeover pull request given, owner of origin/<branch> or None when it is missing).
ADOPTION = {
    (False, None): None,
    (False, FACTORY): "remote_branch",
    (False, OTHER): REFUSE,
    (True, None): "takeover_pr",
    (True, FACTORY): "remote_branch",
    (True, OTHER): REFUSE,
}


class Refusal(Exception):
    pass


class RemoteBranch(NamedTuple):
    head: str
    owner: str


class Adoption(NamedTuple):
    source: str
    ref: str
    head: str


class SessionPlan(NamedTuple):
    session_id: str
    resumed: bool
    reason: str
    previous_id: str | None
    previous: Path | None
    last_result: str | None


class Stopped(BaseException):
    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def git(cwd: Path, *args: str) -> str:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise Refusal(f"git {' '.join(args)} failed in {cwd}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def remote_branch_exists(worktree: Path, branch: str) -> bool:
    ref = f"refs/heads/{branch}"
    proc = subprocess.run(["git", "ls-remote", "--exit-code", "origin", ref], cwd=worktree, capture_output=True, text=True)
    if proc.returncode == 2:
        return False
    if proc.returncode != 0:
        raise Refusal(f"git ls-remote origin {ref} failed in {worktree}: {proc.stderr.strip()}")
    return any(line.split("\t")[1] == ref for line in proc.stdout.splitlines())


def takeover_pull_ref(takeover_pr: str, repo: str) -> str:
    match = PULL_URL.match(takeover_pr)
    if not match or match.group(1).lower() != repo.lower():
        raise Refusal(f"--takeover-pr {takeover_pr} is not a pull request URL in {repo}")
    return f"refs/pull/{match.group(2)}/head"


def origin_default(worktree: Path) -> str:
    proc = subprocess.run(
        ["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd=worktree, capture_output=True, text=True
    )
    if proc.returncode != 0:
        raise Refusal(f"origin/HEAD is not set in {worktree}; run git remote set-head origin -a in the checkout")
    return proc.stdout.strip()


def branch_owner(worktree: Path, default: str, head: str, pull_head: str | None, login: str) -> str:
    """Who started a card branch, from the inputs of the rule: the branch head, the default branch, the takeover
    pull request's head when the card has one, and the App's login.

    The branch is the factory's own when it holds no commits beyond the default branch, or when the first of
    its commits, counted from the takeover point, is the App's. A takeover branch starts from the pull request's
    head, so its first commit is the person's and the count starts after that head."""
    if not git(worktree, "rev-list", "-1", f"{default}..{head}"):
        return FACTORY
    after = [f"^{pull_head}"] if pull_head else []
    commits = git(worktree, "rev-list", "--first-parent", "--reverse", f"{default}..{head}", *after).splitlines()
    owned = bool(commits) and git(worktree, "log", "-1", "--format=%an", commits[0]) == login
    return FACTORY if owned else OTHER


def remote_branch(
    worktree: Path, branch: str, default: str, pull_ref: str | None, login: str | None
) -> RemoteBranch | None:
    """origin/<branch> and who created it."""
    if not remote_branch_exists(worktree, branch):
        return None
    if not login:
        raise Refusal(
            "github.login is not set in the settings, so claude-session cannot tell the factory's branches from a person's"
        )
    # Refresh the default branch first, or merges from `gh pr update-branch` look like the branch's own commits.
    git(worktree, "fetch", "--quiet", "origin")
    pull_head = None
    if pull_ref:
        git(worktree, "fetch", "--quiet", "origin", pull_ref)
        pull_head = git(worktree, "rev-parse", "FETCH_HEAD")
    git(worktree, "fetch", "--quiet", "origin", f"refs/heads/{branch}")
    head = git(worktree, "rev-parse", "FETCH_HEAD")
    return RemoteBranch(head, branch_owner(worktree, default, head, pull_head, login))


def refusal_text(branch: str, login: str | None, takeover_pr: str | None) -> str:
    if branch.endswith("-takeover"):
        return (
            f"origin/{branch} has no commit by {login} after the takeover point, so the factory cannot publish to "
            f"it; have a person delete or rename origin/{branch}, or set takeover_pr to the person's pull request "
            f"whose head {branch} was started from"
            + ("" if takeover_pr is None else f" (this card has {takeover_pr})")
        )
    return (
        f"origin/{branch} was not created by {login}, so the factory cannot publish to it; start the card on "
        f"{branch}-takeover with takeover_pr set to the person's pull request that is on {branch}, or have a "
        f"person delete or rename origin/{branch}"
    )


def adopt_existing_work(
    worktree: Path, branch: str, repo: str, takeover_pr: str | None, login: str | None
) -> Adoption | None:
    pull_ref = takeover_pull_ref(takeover_pr, repo) if takeover_pr else None
    default = origin_default(worktree)
    if git(worktree, "rev-list", f"{default}..HEAD") or git(worktree, "status", "--porcelain"):
        return None
    remote = remote_branch(worktree, branch, default, pull_ref, login)
    source = ADOPTION[(pull_ref is not None, remote.owner if remote else None)]
    if source is None:
        return None
    if source == REFUSE:
        raise Refusal(refusal_text(branch, login, takeover_pr))
    if source == "remote_branch":
        adoption = Adoption(source, branch, remote.head)
    else:
        git(worktree, "fetch", "--quiet", "origin", pull_ref)
        adoption = Adoption(source, takeover_pr, git(worktree, "rev-parse", "FETCH_HEAD"))
    git(worktree, "reset", "--quiet", "--hard", adoption.head)
    return adoption


def load_settings(settings_file: str | None) -> dict:
    if settings_file:
        return json.loads(Path(settings_file).read_text())
    proc = subprocess.run(
        ["hermes", "config", "get", SETTINGS_KEY, "--json", "--raw"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Refusal(f"hermes config get {SETTINGS_KEY} failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def find_repository(settings: dict, full_name: str) -> dict:
    for repo in settings.get("repositories") or []:
        if repo.get("full_name") == full_name:
            return repo
    raise Refusal(f"repository {full_name} is not configured")


def resolve_worktree(workspace: str, repo_path: str) -> Path:
    worktree = Path(workspace).resolve()
    if not worktree.is_dir():
        raise Refusal(f"workspace {worktree} does not exist")
    if Path(git(worktree, "rev-parse", "--show-toplevel")).resolve() != worktree:
        raise Refusal(f"workspace {worktree} is not the root of a git worktree")
    main = Path(repo_path).resolve()
    common = Path(git(worktree, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    repo_common = Path(git(main, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    if common != repo_common:
        raise Refusal(f"workspace {worktree} does not belong to the repository at {main}")
    if worktree == main:
        raise Refusal(f"workspace {worktree} is the main checkout, not a Kanban worktree")
    return worktree


def claude_config_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(configured) if configured else Path.home() / ".claude"


def transcript_cwd(transcript: Path) -> str | None:
    with open(transcript, encoding="utf-8") as lines:
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if isinstance(entry, dict) and entry.get("cwd"):
                return entry["cwd"]
    return None


def find_transcript(session_id: str, worktree: Path) -> Path | None:
    # Claude Code resumes only a session started in the same working directory, so a new card's
    # worktree starts a fresh session even though the issue's session ID is the same.
    transcripts = (claude_config_dir() / "projects").glob(f"*/{session_id}.jsonl")
    return next((t for t in transcripts if transcript_cwd(t) == str(worktree)), None)


def session_id_for(issue_id: str, generation: int) -> str:
    # A fresh start takes the next generation, because `--session-id` refuses an ID whose transcript exists.
    key = f"linear-issue:{issue_id}" if generation == 0 else f"linear-issue:{issue_id}:{generation}"
    return str(uuid.uuid5(uuid.NAMESPACE_URL, key))


def last_assistant(transcript: Path) -> tuple[int | None, str | None]:
    tokens = text = None
    with open(transcript, encoding="utf-8", errors="replace") as lines:
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            message = entry.get("message") if isinstance(entry, dict) and entry.get("type") == "assistant" else None
            if not isinstance(message, dict) or entry.get("isSidechain") or message.get("model") == "<synthetic>":
                continue
            usage = message.get("usage")
            parts = [usage.get(key) for key in USAGE_KEYS] if isinstance(usage, dict) else []
            ok = len(parts) == len(USAGE_KEYS) and all(isinstance(part, int) and not isinstance(part, bool) for part in parts)
            tokens = sum(parts) if ok else None
            content = message.get("content")
            blocks = content if isinstance(content, list) else []
            said = "\n".join(b["text"] for b in blocks if isinstance(b, dict) and isinstance(b.get("text"), str)).strip()
            text = said or None
    return tokens, text


def fresh_after_tokens(transport: dict) -> int:
    value = transport.get("fresh_after_tokens", DEFAULT_FRESH_AFTER_TOKENS)
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise Refusal(f"claude_session.fresh_after_tokens {value!r} must be a positive integer")
    return value


def plan_session(issue_id: str, worktree: Path, threshold: int, now: float) -> SessionPlan:
    generation, latest = 0, None
    while found := find_transcript(session_id_for(issue_id, generation), worktree):
        latest, generation = found, generation + 1
    if latest is None:
        return SessionPlan(session_id_for(issue_id, 0), False, "new", None, None, None)
    previous_id = session_id_for(issue_id, generation - 1)
    if now - latest.stat().st_mtime <= CACHE_TTL_SECONDS:
        return SessionPlan(previous_id, True, "warm", previous_id, latest, None)
    tokens, text = last_assistant(latest)
    if tokens is not None and tokens < threshold:
        return SessionPlan(previous_id, True, "small", previous_id, latest, None)
    reason = "fresh-unreadable" if tokens is None else "fresh-large-idle"
    return SessionPlan(session_id_for(issue_id, generation), False, reason, previous_id, latest, text)


def session_process_running(session_id: str) -> bool:
    listing = subprocess.run(["ps", "-Ao", "pid=,command="], capture_output=True, text=True, check=True)
    for line in listing.stdout.splitlines():
        pid, _, command = line.strip().partition(" ")
        if pid != str(os.getpid()) and session_id in command:
            return True
    return False


def version_key(name: str) -> tuple:
    return tuple(int(part) for part in name.lstrip("v").split("."))


def node_bin_for(worktree: Path) -> Path | None:
    nvmrc = worktree / ".nvmrc"
    if not nvmrc.is_file():
        return None
    spec = nvmrc.read_text().strip().lstrip("v")
    if not spec.replace(".", "").isdigit():
        raise Refusal(f".nvmrc version {spec!r} is not a numeric version prefix")
    nvm_dir = Path(os.environ.get("NVM_DIR") or Path.home() / ".nvm")
    matches = [
        d for d in (nvm_dir / "versions" / "node").glob("v*")
        if d.name[1:] == spec or d.name[1:].startswith(spec + ".")
    ]
    if not matches:
        raise Refusal(f"Node {spec} from .nvmrc is not installed under {nvm_dir}; run nvm install {spec}")
    return max(matches, key=lambda d: version_key(d.name)) / "bin"


MODEL_TIERS = ("sonnet", "haiku", "fable")


# What Claude Code and the tools it runs need: a shell, locale, temp dir, the worker's gh login, its
# own config dir, and where the Java, Android, and Xcode toolchains live. Nothing else from the worker's
# environment crosses, so no secret can.
CHILD_ENV_NAMES = frozenset({
    "PATH", "HOME", "USER", "LOGNAME", "SHELL", "TERM", "LANG", "TMPDIR", "TZ", "NVM_DIR",
    "GH_CONFIG_DIR", "CLAUDE_CONFIG_DIR", "CLAUDE_CODE_DISABLE_TERMINAL_TITLE",
    "JAVA_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT", "DEVELOPER_DIR",
})
CHILD_ENV_PREFIXES = ("LC_",)


def child_env(worktree: Path) -> dict:
    env = {
        name: value for name, value in os.environ.items()
        if name in CHILD_ENV_NAMES or name.startswith(CHILD_ENV_PREFIXES)
    }
    node_bin = node_bin_for(worktree)
    if node_bin:
        env["PATH"] = f"{node_bin}{os.pathsep}{env.get('PATH', '')}"
    return env


def check_toolchain(repo: dict, worktree: Path) -> None:
    """Run the repository's toolchain checks in the environment Claude Code gets, and refuse on a failure."""
    checks = repo.get("toolchain_checks") or []
    if not isinstance(checks, list) or not all(isinstance(check, str) for check in checks):
        raise Refusal(f"toolchain_checks {checks!r} must be a list of shell commands")
    env = child_env(worktree)
    for check in checks:
        try:
            result = subprocess.run(
                ["/bin/sh", "-c", check], cwd=worktree, env=env, stdin=subprocess.DEVNULL,
                capture_output=True, text=True, timeout=TOOLCHAIN_CHECK_SECONDS,
            )
        except subprocess.TimeoutExpired:
            raise Refusal(f"toolchain check {check!r} did not finish in {TOOLCHAIN_CHECK_SECONDS}s") from None
        if result.returncode != 0:
            output = (result.stderr or result.stdout).strip()[-500:] or "no output"
            raise Refusal(
                f"toolchain check {check!r} failed with exit {result.returncode} "
                f"in the environment Claude Code gets: {output}"
            )


def linear_api_key() -> str:
    """A Linear token from the worker home's linear-agent-session plugin, which shares its token cache."""
    home = os.environ.get("HERMES_HOME")
    if not home:
        raise Refusal("HERMES_HOME is not set; claude-session reads the Linear token through the worker home's plugin")
    plugin = Path(home) / "plugins" / "linear-agent-session"
    if not (plugin / "linear.py").is_file():
        raise Refusal(f"the linear-agent-session plugin is not installed in {home}")
    sys.path.insert(0, str(plugin))
    import linear

    try:
        return linear.client_from_env().access_token()
    except linear.LinearError as error:
        raise Refusal(f"Linear token: {error}") from None


def tier_models(transport: dict) -> dict:
    value = transport.get("tier_models")
    if value is None:
        return {}
    ok = isinstance(value, dict) and set(value) <= set(MODEL_TIERS) and all(
        isinstance(model, str) and model for model in value.values()
    )
    if not ok:
        raise Refusal(
            f"claude_session.tier_models {value!r} must map {', '.join(MODEL_TIERS)} to non-empty model ids"
        )
    return value


def model_environment(transport: dict, tiers: dict) -> dict:
    # The main loop and every tier without its own model stay on the transport model, because a proxy
    # answers `unknown provider for model ...` for an id it does not serve.
    model = transport["model"]
    env = {"ANTHROPIC_MODEL": model, "ANTHROPIC_DEFAULT_OPUS_MODEL": model}
    env.update({f"ANTHROPIC_DEFAULT_{tier.upper()}_MODEL": tiers.get(tier, model) for tier in MODEL_TIERS})
    # A subagent that names no model takes this alias. CLAUDE_CODE_SUBAGENT_MODEL_FORCE stays unset so
    # an explicit model on the Agent call still wins.
    env["CLAUDE_CODE_SUBAGENT_MODEL"] = "sonnet" if "sonnet" in tiers else model
    return env


def claude_settings(transport: dict, api_key: str, path: Path) -> dict:
    # Passed with --settings because Claude Code lets a user-level
    # ~/.claude/settings.json env block override the process environment.
    env = {"LINEAR_API_KEY": api_key}
    if transport.get("base_url"):
        env["ANTHROPIC_BASE_URL"] = transport["base_url"]
    token_env = transport.get("auth_token_env")
    if token_env:
        if not os.environ.get(token_env):
            raise Refusal(f"auth_token_env names {token_env}, which is not set")
        env["ANTHROPIC_AUTH_TOKEN"] = os.environ[token_env]
    tiers = tier_models(transport)
    if transport.get("model"):
        env.update(model_environment(transport, tiers))
    # Claude Code applies the env block once at startup, so the file can go as soon as the session starts.
    remove = {"type": "command", "command": f"rm -f -- {shlex.quote(str(path))}"}
    return {"env": env, "hooks": {"SessionStart": [{"hooks": [remove]}]}}


def remove_on_stop(path: Path) -> None:
    """Remove the settings file on SIGTERM, SIGINT, or SIGHUP, then unwind so claude is ended too."""
    def stop(signum: int, _frame) -> None:
        for each in STOP_SIGNALS:
            signal.signal(each, signal.SIG_IGN)
        path.unlink(missing_ok=True)
        raise Stopped(signum)

    for signum in STOP_SIGNALS:
        signal.signal(signum, stop)


def write_private(path: Path, settings: dict) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(settings, handle)


def max_turns_args(transport: dict) -> list[str]:
    value = transport.get("max_turns")
    if value is None or value == 0:
        return []
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise Refusal(f"claude_session.max_turns {value!r} must be a positive integer, or 0 for no limit")
    return ["--max-turns", str(value)]


def worker_entry_prefix(repo: dict) -> str:
    prefix = repo.get("worker_entry") or ""
    if "{" in prefix:
        raise Refusal(
            f"worker_entry {prefix!r} must be a plain prefix such as /patina-mode; "
            "claude-session adds the issue, URL, repository, and branch itself"
        )
    return prefix


def handoff_text(plan: SessionPlan, branch: str, head: str) -> str | None:
    if plan.previous is None or plan.resumed:
        return None
    last = plan.last_result
    result = (
        f"The previous session ended with this message:\n\n{last[-HANDOFF_RESULT_CHARS:]}"
        if last else "The previous session left no final message."
    )
    return HANDOFF.format(branch=branch, head=head, transcript=plan.previous, result=result)


def build_prompt(
    args: argparse.Namespace, prefix: str, branch: str, resumed: bool, adopted: Adoption | None, handoff: str | None
) -> str:
    message = Path(args.message_file).read_text() if args.message_file else ""
    if resumed:
        return message or RESUME_PROMPT
    entry = DEFAULT_WORKER_ENTRY.format(
        issue_id=args.issue_id,
        issue_identifier=args.issue_identifier,
        issue_url=args.issue_url,
        branch=branch,
        repo=args.repo,
    )
    if prefix:
        entry = f"{prefix} {entry}"
    if args.takeover_pr:
        start = TAKEOVER_START.get(adopted.source) if adopted else None
        takeover = " ".join(filter(None, [TAKEOVER_INTRO, start, TAKEOVER_RULES]))
        entry = f"{entry}\n\n{takeover.format(url=args.takeover_pr)}"
    return "\n\n".join(filter(None, [entry, handoff, message]))


def run_claude(command: list[str], worktree: Path) -> tuple[dict | None, int, str]:
    """Run claude in its own process group, stop reading at its result, and end every process it leaves.

    Returns the parsed result, claude's exit code, and the tail of its output for an error report.
    """
    with tempfile.TemporaryFile() as stderr:
        proc = subprocess.Popen(
            command,
            cwd=worktree,
            env=child_env(worktree),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=stderr,
            start_new_session=True,
        )
        with proc:
            try:
                output, stdout = read_result(proc)
            finally:
                leftovers = end_run(proc)
        if leftovers:
            print(f"claude-session: ended {len(leftovers)} process(es) left by claude: {sorted(leftovers)}", file=sys.stderr)
        stderr.seek(0)
        detail = (stderr.read() or stdout).decode(errors="replace").strip()[-2000:]
    return output, proc.returncode, detail


def read_result(proc: subprocess.Popen) -> tuple[dict | None, bytes]:
    # Stop at the first complete JSON document instead of waiting for EOF: claude may keep running
    # after it prints its result, and a child that inherited the pipe keeps it open after claude exits.
    fd = proc.stdout.fileno()
    buffer = b""
    while True:
        readable, _, _ = select.select([fd], [], [], QUIET_SECONDS)
        if not readable:
            if proc.poll() is not None:
                return None, buffer
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            return None, buffer
        buffer += chunk
        try:
            output = json.loads(buffer)
        except ValueError:
            continue
        if isinstance(output, dict):
            return output, buffer


def run_processes(root: int) -> set[int]:
    """Every process in claude's process group, plus its descendants that moved to their own group."""
    listing = subprocess.run(["ps", "-Ao", "pid=,ppid=,pgid="], capture_output=True, text=True, check=True)
    rows = [tuple(int(field) for field in line.split()) for line in listing.stdout.splitlines() if line.strip()]
    pids = {pid for pid, _, pgid in rows if pgid == root}
    pending = [root]
    while pending:
        parent = pending.pop()
        for pid, ppid, _ in rows:
            if ppid == parent and pid not in pids:
                pids.add(pid)
                pending.append(pid)
    return pids


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def all_gone(proc: subprocess.Popen, pids: set[int]) -> bool:
    deadline = time.monotonic() + GRACE_SECONDS
    while time.monotonic() < deadline:
        if proc.poll() is not None and not any(process_exists(pid) for pid in pids):
            return True
        time.sleep(0.1)
    return False


def end_run(proc: subprocess.Popen) -> set[int]:
    """Terminate claude and everything it started, with SIGKILL after a grace period. Returns the leftovers."""
    leftovers: set[int] = set()
    for signum in (signal.SIGTERM, signal.SIGKILL):
        leftovers |= run_processes(proc.pid) - {proc.pid}
        for pid in leftovers | {proc.pid}:
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass
        if all_gone(proc, leftovers):
            break
    proc.wait()
    return leftovers


def run(args: argparse.Namespace) -> tuple[int, dict]:
    workspace = os.environ.get("HERMES_KANBAN_WORKSPACE")
    if not workspace:
        raise Refusal("HERMES_KANBAN_WORKSPACE is not set; claude-session runs only inside a Kanban worker")
    settings = load_settings(args.settings_json)
    repo = find_repository(settings, args.repo)
    transport = settings.get("claude_session") or {}
    turn_limit = max_turns_args(transport)
    threshold = fresh_after_tokens(transport)
    prefix = worker_entry_prefix(repo)
    worktree = resolve_worktree(workspace, repo["path"])
    check_toolchain(repo, worktree)
    lock_path = Path(git(worktree, "rev-parse", "--absolute-git-dir")) / LOCK_NAME
    with open(lock_path, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refusal(f"another claude-session holds {worktree}") from None
        settings_path = lock_path.with_name(SETTINGS_FILE_NAME)
        # A killed run leaves its file behind; os.open would also keep that file's mode.
        settings_path.unlink(missing_ok=True)
        remove_on_stop(settings_path)
        plan = plan_session(args.issue_id, worktree, threshold, time.time())
        session_id = plan.session_id
        for running_id in filter(None, [plan.previous_id, session_id]):
            if session_process_running(running_id):
                raise Refusal(f"a process for Claude session {running_id} is already running")

        branch = git(worktree, "rev-parse", "--abbrev-ref", "HEAD")
        login = (settings.get("github") or {}).get("login")
        adopted = adopt_existing_work(worktree, branch, args.repo, args.takeover_pr, login)
        handoff = handoff_text(plan, branch, git(worktree, "rev-parse", "HEAD"))
        command = [
            os.environ.get("CLAUDE_BIN", "claude"),
            "-p", build_prompt(args, prefix, branch, plan.resumed, adopted, handoff),
            "--output-format", "json",
            *turn_limit,
            "--permission-mode", "bypassPermissions",
            "--resume" if plan.resumed else "--session-id", session_id,
            "--append-system-prompt", SYSTEM_PROMPT.format(push_signed=Path(__file__).resolve().with_name("push-signed")),
            "--mcp-config", LINEAR_MCP_CONFIG,
        ]
        if transport.get("model"):
            command += ["--model", transport["model"]]
        command += ["--settings", str(settings_path)]
        try:
            write_private(settings_path, claude_settings(transport, linear_api_key(), settings_path))
            output, exit_code, detail = run_claude(command, worktree)
        finally:
            settings_path.unlink(missing_ok=True)

    report = {"session_id": session_id, "resumed": plan.resumed, "reason": plan.reason, "worktree": str(worktree), "branch": branch, "adopted": adopted._asdict() if adopted else None}
    if output is None:
        return 1, {"error": f"claude exited {exit_code} without JSON output: {detail}", **report}
    report.update(subtype=output.get("subtype"), num_turns=output.get("num_turns"), result=output.get("result"))
    if report["subtype"] not in COMPLETED_SUBTYPES:
        return 1, {"error": f"claude run ended with {report['subtype']} (exit {exit_code})", **report}
    return 0, report


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--issue-id", required=True)
    parser.add_argument("--issue-identifier", required=True)
    parser.add_argument("--issue-url", required=True)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--message-file")
    parser.add_argument("--takeover-pr")
    parser.add_argument("--settings-json")
    args = parser.parse_args()
    try:
        status, report = run(args)
    except Stopped as stopped:
        signal.signal(stopped.signum, signal.SIG_DFL)
        os.kill(os.getpid(), stopped.signum)
        raise
    except Refusal as refusal:
        status, report = 2, {"error": str(refusal)}
    except Exception as error:
        status, report = 1, {"error": f"{type(error).__name__}: {error}"}
    print(json.dumps(report))
    return status


if __name__ == "__main__":
    sys.exit(main())
